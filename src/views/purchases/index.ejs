<% const list = Array.isArray(purchases) ? purchases : []; const paymentFilter = typeof paymentStatus === 'string' ? paymentStatus : 'ALL'; const activeView = state === 'ACTIVE'; const listedTotal = list.reduce((sum, purchase) => sum + Number(purchase.totalAmount || 0), 0); const listedPaid = list.reduce((sum, purchase) => sum + Number(purchase.paid || 0), 0); const listedDue = list.reduce((sum, purchase) => sum + Math.max(0, Number(purchase.totalAmount || 0) - Number(purchase.paid || 0)), 0); %>
<header class="page-header purchase-register-header"><div><p class="eyebrow">Supplier gold & silver buying</p><h1>Purchase Register</h1><p class="muted">One clear register for every supplier lot and payment.</p></div><div class="header-actions"><a class="button ghost" href="/suppliers">Suppliers</a><button class="button ghost" type="button" data-export-modal-open="supplierPurchaseExportModal">Export Excel</button><a class="button" href="/purchases/new">+ New purchase</a></div></header>
<nav class="purchase-register-tabs" aria-label="Supplier and purchase views"><a class="<%= activeView && paymentFilter === 'ALL' ? 'is-active' : '' %>" href="/purchases">Purchase register</a><a class="<%= activeView && paymentFilter === 'PENDING' ? 'is-active' : '' %>" href="/purchases?paymentStatus=PENDING">Pending payments</a><a class="<%= !activeView ? 'is-active' : '' %>" href="/purchases?state=CANCELLED">Cancelled purchases</a><a href="/reports">Purchase reports</a></nav>
<section class="purchase-register-summary" aria-label="Purchase totals"><article><span>Listed value</span><strong><%= money(listedTotal) %></strong></article><article><span>Paid</span><strong class="paid-amount"><%= money(listedPaid) %></strong></article><article><span>Outstanding</span><strong class="<%= listedDue > 0 ? 'credit-amount' : 'paid-amount' %>"><%= money(listedDue) %></strong></article></section>
<section class="panel register-panel purchase-register-shell">
  <form class="search-bar purchase-filter-bar" method="get" action="/purchases">
    <label class="purchase-search-field">Supplier or purchase search
      <input name="q" data-supplier-autocomplete data-supplier-autocomplete-mode="search" value="<%= q || '' %>" placeholder="Type a supplier name, purchase no. or item" autocomplete="off">
      <small>Supplier names appear as you type</small>
    </label>
    <label class="purchase-filter-field">Purchase status
      <select name="state"><option value="ACTIVE" <%= activeView ? 'selected' : '' %>>Active purchases</option><option value="CANCELLED" <%= !activeView ? 'selected' : '' %>>Cancelled purchases</option></select>
    </label>
    <label class="purchase-filter-field">Payment
      <select name="paymentStatus" <%= !activeView ? 'disabled' : '' %>><option value="ALL" <%= paymentFilter === 'ALL' ? 'selected' : '' %>>All payments</option><option value="PENDING" <%= paymentFilter === 'PENDING' ? 'selected' : '' %>>Pending payments</option><option value="PAID" <%= paymentFilter === 'PAID' ? 'selected' : '' %>>Fully paid</option></select>
    </label>
    <label class="purchase-filter-field">Metal
      <select name="metal"><option value="ALL" <%= metal === 'ALL' ? 'selected' : '' %>>All metals</option><option value="GOLD" <%= metal === 'GOLD' ? 'selected' : '' %>>Gold</option><option value="SILVER" <%= metal === 'SILVER' ? 'selected' : '' %>>Silver</option></select>
    </label>
    <details class="purchase-advanced-filters" <%= from || to || minDue !== null || maxDue !== null ? 'open' : '' %>>
      <summary>More filters <span>Dates and due range</span></summary>
      <div class="purchase-advanced-grid">
        <label>From<input name="from" type="date" value="<%= from || '' %>"></label>
        <label>To<input name="to" type="date" value="<%= to || '' %>"></label>
        <label>Min due<input name="minDue" type="number" min="0" step="0.01" placeholder="₹0" value="<%= minDue === null ? '' : minDue %>"></label>
        <label>Max due<input name="maxDue" type="number" min="0" step="0.01" placeholder="₹—" value="<%= maxDue === null ? '' : maxDue %>"></label>
      </div>
    </details>
    <div class="purchase-filter-actions">
      <button class="button secondary" type="submit">Apply filters</button><% if (q || paymentFilter !== 'ALL' || !activeView || metal !== 'ALL' || from || to || minDue !== null || maxDue !== null) { %><a class="button ghost" href="/purchases">Clear</a><% } %>
    </div>
  </form>
  <% if (list.length) { %>
  <div class="table-wrap purchase-table-wrap"><table class="purchase-register-table"><thead><tr><th>Purchase</th><th>Supplier</th><th>Lot received</th><th class="right">Pieces / weight</th><th class="right">Total</th><th class="right">Paid</th><th class="right">Due</th><th>Status</th><th class="purchase-actions-heading">Actions</th></tr></thead><tbody>
    <% list.forEach((purchase) => { const due = Math.max(0, Number(purchase.totalAmount || 0) - Number(purchase.paid || 0)); const isActive = !purchase.cancelledAt; const paymentCount = purchase.cashbookEntries?.length || 0; %>
    <tr>
      <td><strong><%= purchase.purchaseNumber %></strong><small><%= formatDateDisplay(purchase.purchaseDate) %><%= purchase.reference ? ` · ${purchase.reference}` : '' %></small></td>
      <td><a class="table-link" href="/suppliers/<%= purchase.supplier.id %>"><strong><%= purchase.supplier.name %></strong></a><small><%= purchase.supplier.phone || 'No mobile saved' %></small></td>
      <td><strong><%= purchase.itemName %></strong><small><%= purchase.category %> · <%= purchase.metal %><%= purchase.purity ? ` · ${purchase.purity}` : '' %></small></td>
      <td class="right"><strong><%= Number(purchase.quantity || 1) %></strong><small><%= Number(purchase.netWeight || 0).toFixed(3) %> g net</small></td>
      <td class="right"><strong><%= money(purchase.totalAmount) %></strong></td>
      <td class="right"><strong class="paid-amount"><%= money(purchase.paid) %></strong></td>
      <td class="right"><strong class="<%= due > 0 ? 'credit-amount' : 'paid-amount' %>"><%= money(due) %></strong></td>
      <td><span class="pill <%= !isActive ? 'danger' : due > 0 ? 'warning' : 'success' %>"><%= !isActive ? 'Cancelled' : due > 0 ? 'Due' : 'Paid' %></span></td>
      <td class="purchase-row-actions"><% if (isActive) { %><a class="button ghost small" href="/purchases/<%= purchase.id %>/edit">Edit</a><button class="button secondary small" type="button" data-purchase-manage-open="purchaseManage<%= purchase.id %>"><%= due > 0 ? 'Payments' : 'History' %><%= paymentCount ? ` (${paymentCount})` : '' %></button><button class="button ghost small danger-action" type="button" data-cancel-purchase-open="purchaseCancel<%= purchase.id %>">Cancel</button><% } else { %><span class="muted">Cancelled record</span><% } %></td>
    </tr>
    <% }) %>
  </tbody></table></div>
  <%- include('../_pagination',{pagination}) %>
  <% } else { %><div class="empty-state"><span>▣</span><h3><%= q ? 'No matching purchases' : activeView ? 'No supplier purchases yet' : 'No cancelled purchases' %></h3><p><%= q ? 'Try another supplier, item, metal or purchase number.' : activeView ? 'Record a supplier lot to begin tracking stock cost and payments.' : 'Cancelled purchases will remain available here as an audit record.' %></p><% if (activeView && !q) { %><a class="button" href="/purchases/new">Record first purchase</a><% } %></div><% } %>
</section>
<% list.filter((purchase) => !purchase.cancelledAt).forEach((purchase) => { const due = Math.max(0, Number(purchase.totalAmount || 0) - Number(purchase.paid || 0)); const paymentCount = purchase.cashbookEntries?.length || 0; %>
<div class="modal-overlay" id="purchaseManage<%= purchase.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-payment-modal"><header class="modal-header"><div><p class="eyebrow">Supplier purchase</p><h2><%= purchase.purchaseNumber %></h2><p class="muted"><%= purchase.supplier.name %> · <%= purchase.itemName %></p></div><button class="modal-close-btn" type="button" data-purchase-manage-close aria-label="Close">×</button></header><div class="modal-body purchase-payment-body"><div class="purchase-payment-summary"><span>Total<strong><%= money(purchase.totalAmount) %></strong></span><span>Paid<strong><%= money(purchase.paid) %></strong></span><span class="<%= due > 0 ? 'credit-amount' : 'paid-amount' %>">Due<strong><%= money(due) %></strong></span></div><% if (paymentCount) { %><h3>Payment history</h3><div class="purchase-history-list"><% purchase.cashbookEntries.forEach((entry) => { %><div class="purchase-history-row"><div><strong><%= money(entry.amount) %></strong><small><%= formatDateDisplay(entry.entryDate) %> · <%= entry.paymentMethod.replace('_', ' ') %><%= entry.notes ? ` · ${entry.notes}` : '' %></small></div><button class="button ghost small" type="button" data-purchase-payment-edit-open="purchasePaymentEdit<%= entry.id %>">Edit</button></div><% }) %></div><% } else { %><div class="empty-state compact"><h3>No payment recorded</h3><p>Record payment when the supplier is paid.</p></div><% } %><% if (due > 0) { %><button class="button purchase-record-button" type="button" data-purchase-payment-add-open="purchasePaymentAdd<%= purchase.id %>">+ Record payment</button><% } %></div><footer class="modal-footer"><a class="button ghost" href="/purchases/<%= purchase.id %>/edit">Edit purchase</a><button class="button ghost" type="button" data-purchase-manage-close>Done</button></footer></section></div>
<% purchase.cashbookEntries.forEach((entry) => { %><div class="modal-overlay" id="purchasePaymentEdit<%= entry.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Edit supplier payment</p><h2><%= purchase.purchaseNumber %></h2></div><button class="modal-close-btn" type="button" data-purchase-payment-edit-close aria-label="Close">×</button></header><form method="post" action="/purchases/<%= purchase.id %>/payments/<%= entry.id %>"><div class="modal-body payment-editor-fields"><label>Date<input name="entryDate" type="date" value="<%= entry.entryDate %>" required></label><label>Amount<input name="amount" type="number" min="0.01" max="<%= Number(purchase.totalAmount).toFixed(2) %>" step="0.01" value="<%= Number(entry.amount).toFixed(2) %>" required></label><label>Payment method<select name="paymentMethod"><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach((method) => { %><option value="<%= method %>" <%= entry.paymentMethod === method ? 'selected' : '' %>><%= method.replace('_', ' ') %></option><% }) %></select></label><label>Reference<input name="reference" value="<%= entry.reference || '' %>" placeholder="Optional"></label><label>Note<input name="notes" value="<%= entry.notes || '' %>" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-payment-edit-close>Cancel</button><button class="button danger-action" type="submit" formaction="/purchases/<%= purchase.id %>/payments/<%= entry.id %>/delete" formmethod="post" onclick="return confirm('Cancel this supplier payment and update the purchase balance?')">Cancel payment</button><button class="button" type="submit">Save payment</button></footer></form></section></div><% }) %>
<% if (due > 0) { %><div class="modal-overlay" id="purchasePaymentAdd<%= purchase.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Supplier payment</p><h2>Record payment</h2><p class="muted">Current due: <%= money(due) %></p></div><button class="modal-close-btn" type="button" data-purchase-payment-add-close aria-label="Close">×</button></header><form method="post" action="/purchases/<%= purchase.id %>/payments"><div class="modal-body payment-editor-fields"><label>Amount<input name="amount" type="number" min="0.01" max="<%= due.toFixed(2) %>" step="0.01" value="<%= due.toFixed(2) %>" required></label><label>Payment method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Payment date<input name="entryDate" type="date" value="<%= dateInput() %>" required></label><label>Reference<input name="reference" placeholder="Optional"></label><label>Note<input name="notes" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-payment-add-close>Cancel</button><button class="button" type="submit">Record payment</button></footer></form></section></div><% } %>
<div class="modal-overlay" id="purchaseCancel<%= purchase.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-cancel-modal"><header class="modal-header"><div><p class="eyebrow">Cancel supplier purchase</p><h2><%= purchase.purchaseNumber %></h2><p class="muted"><%= purchase.supplier.name %> · <%= money(purchase.totalAmount) %></p></div><button class="modal-close-btn" type="button" data-purchase-cancel-close aria-label="Close">×</button></header><form method="post" action="/purchases/<%= purchase.id %>/delete"><div class="modal-body payment-editor-fields"><p class="purchase-cancel-warning">Linked Cashbook payouts will be reversed. Separately barcode-labelled inventory will not be restored.</p><label>Reason for cancellation<textarea name="cancelReason" rows="3" required placeholder="Enter a short reason"></textarea></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-purchase-cancel-close>Keep purchase</button><button class="button danger-action" type="submit">Cancel purchase</button></footer></form></section></div>
<% }) %>
<%- include('../_export_modal', { exportModalId: 'supplierPurchaseExportModal', exportResource: 'supplier-purchases', exportTitle: 'Supplier Purchase', exportFrom: dateInput(), exportTo: dateInput() }) %>
<style>.purchase-register-header .muted{margin-top:5px}.purchase-register-tabs{display:flex;gap:6px;overflow:auto;margin:0 0 14px;padding:4px;border-bottom:1px solid var(--border,#e6dfd3)}.purchase-register-tabs a{padding:9px 13px;border-radius:8px;color:#fff !important;text-shadow:0 1px 4px rgba(53,29,18,.48);font-size:13px;font-weight:750;white-space:nowrap;text-decoration:none}.purchase-register-tabs a:hover{background:rgba(255,255,255,.14);color:#fff !important}.purchase-register-tabs a.is-active{background:rgba(193,142,33,.26);color:#fff !important}.purchase-register-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:16px}.purchase-register-summary article{padding:14px 16px;border:1px solid var(--border,#e6dfd3);border-radius:12px;background:var(--surface,#fff)}.purchase-register-summary span{display:block;color:var(--muted,#70685e);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.purchase-register-summary strong{display:block;margin-top:5px;font-size:19px}.purchase-filter-bar{display:grid;grid-template-columns:minmax(260px,1fr) repeat(3,minmax(125px,.65fr));align-items:end;gap:10px;margin-bottom:16px}.purchase-filter-bar label{display:grid;gap:4px;min-width:0;color:var(--muted,#70685e);font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.purchase-filter-bar label input,.purchase-filter-bar label select{width:100%;min-width:0}.purchase-search-field small{margin-top:2px;color:var(--muted,#70685e);font-size:11px;font-weight:500;letter-spacing:0;text-transform:none}.purchase-advanced-filters{grid-column:1/-1;border-top:1px solid var(--border,#eee8de);padding-top:10px}.purchase-advanced-filters summary{display:flex;align-items:center;gap:8px;width:max-content;cursor:pointer;color:#85580d;font-size:12px;font-weight:800;list-style:none}.purchase-advanced-filters summary::-webkit-details-marker{display:none}.purchase-advanced-filters summary::before{content:'+';display:grid;place-items:center;width:18px;height:18px;border:1px solid rgba(193,142,33,.45);border-radius:50%;font-size:14px;line-height:1}.purchase-advanced-filters[open] summary::before{content:'−'}.purchase-advanced-filters summary span{color:var(--muted,#70685e);font-size:11px;font-weight:500}.purchase-advanced-grid{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:10px;margin-top:10px}.purchase-advanced-grid label{font-size:10px}.purchase-filter-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;grid-column:1/-1}.purchase-table-wrap{border:1px solid var(--border,#e6dfd3);border-radius:12px}.purchase-register-table{min-width:1060px}.purchase-register-table td{vertical-align:middle}.purchase-register-table td small{display:block;color:var(--muted,#70685e);margin-top:3px}.purchase-register-table .table-link{color:inherit;text-decoration:none}.purchase-register-table .table-link:hover{text-decoration:underline}.purchase-actions-heading{min-width:260px}.purchase-row-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px}.purchase-row-actions form{margin:0}.danger-action{color:#b53d36}.purchase-payment-modal{width:min(660px,94vw)}.purchase-edit-payment-modal,.purchase-cancel-modal{width:min(500px,94vw)}.purchase-payment-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px;border-radius:10px;background:rgba(193,142,33,.08)}.purchase-payment-summary span{font-size:12px;color:var(--muted,#70685e)}.purchase-payment-summary strong{display:block;color:inherit;font-size:16px;margin-top:3px}.purchase-payment-body h3{font-size:14px;margin:20px 0 8px}.purchase-history-list{display:grid;gap:7px}.purchase-history-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border:1px solid var(--border,#eee);border-radius:9px}.purchase-history-row strong,.purchase-history-row small{display:block}.purchase-history-row small{color:var(--muted,#70685e);margin-top:3px}.purchase-record-button{margin-top:18px}.purchase-cancel-warning{padding:11px 12px;border-radius:9px;background:rgba(181,61,54,.08);color:#8e302a;font-size:13px}.payment-editor-fields{display:grid;gap:14px}.payment-editor-fields label{display:grid;gap:6px;font-size:12px;font-weight:700;color:var(--muted,#70685e)}@media(max-width:900px){.purchase-filter-bar{grid-template-columns:repeat(2,minmax(0,1fr))}.purchase-search-field{grid-column:1/-1}.purchase-filter-actions{justify-content:flex-start}}@media(max-width:760px){.purchase-register-summary{grid-template-columns:1fr}.purchase-filter-bar{grid-template-columns:1fr}.purchase-search-field,.purchase-filter-actions{grid-column:auto}.purchase-filter-actions{justify-content:flex-start}.purchase-advanced-grid{grid-template-columns:1fr}.purchase-row-actions{justify-content:flex-start;flex-wrap:wrap}.purchase-payment-summary{grid-template-columns:1fr}}</style>
<script>(()=>{const bindModal=(openAttribute,closeAttribute)=>{document.querySelectorAll(`[${openAttribute}]`).forEach(button=>{const modal=document.getElementById(button.getAttribute(openAttribute));if(!modal)return;const close=()=>{modal.style.display='none';modal.setAttribute('aria-hidden','true');button.focus()};button.addEventListener('click',()=>{modal.style.display='flex';modal.setAttribute('aria-hidden','false');setTimeout(()=>modal.querySelector('input,select,textarea,button')?.focus(),0)});modal.querySelectorAll(`[${closeAttribute}]`).forEach(control=>control.addEventListener('click',close));modal.addEventListener('click',event=>{if(event.target===modal)close()});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&modal.style.display==='flex')close()})})};bindModal('data-purchase-manage-open','data-purchase-manage-close');bindModal('data-purchase-payment-edit-open','data-purchase-payment-edit-close');bindModal('data-purchase-payment-add-open','data-purchase-payment-add-close');bindModal('data-cancel-purchase-open','data-purchase-cancel-close')})();</script>
