<% const editing = Boolean(isEdit && purchase); const formPurchase = purchase || {}; const formSupplier = formPurchase.supplier || {}; const purchaseDateValue = editing ? dateInput(formPurchase.purchaseDate) : dateInput(); const linkedInventory = Boolean(formPurchase.product); %>
<header class="page-header purchase-form-header"><div><p class="eyebrow"><%= editing ? 'Edit supplier purchase' : 'Supplier stock receipt' %></p><h1><%= editing ? formPurchase.purchaseNumber : 'New Purchase Lot' %></h1><p class="muted"><%= editing ? 'Correct the purchase details. Payments are managed separately below.' : 'Record the supplier lot first, then add individual barcode pieces from Inventory.' %></p></div><a class="button ghost" href="/purchases">Cancel</a></header>
<% if(rateInfo.rate){ %><div class="rate-notice purchase-rate-notice"><strong>Reference rates</strong><span>22K <%-money(rateInfo.rate.gold22k)%>/g · 24K <%-money(rateInfo.rate.gold24k)%>/g · Silver <%-money(rateInfo.rate.silver)%>/g</span></div><% } %>
<% if (linkedInventory) { %><div class="notice purchase-linked-notice"><strong>Inventory-linked purchase</strong><span>The supplier and financial details can be corrected. Item, metal, purity, pieces and weights must stay aligned with its linked inventory record.</span></div><% } %>
<form class="panel form-panel purchase-form" method="post" action="<%= editing ? `/purchases/${formPurchase.id}/edit` : '/purchases' %>" data-supplier-purchase-form data-editing="<%= editing ? 'true' : 'false' %>">
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>Supplier</h2><p>Select the existing supplier so all purchases stay in one account.</p></div><span class="purchase-step">1</span></div>
    <div class="form-grid purchase-supplier-core"><label>Purchase date *<input name="purchaseDate" type="date" required value="<%= purchaseDateValue %>"></label><label>Mobile number<input name="supplierPhone" inputmode="numeric" autocomplete="tel" maxlength="15" placeholder="Optional mobile number" value="<%= formSupplier.phone || '' %>"></label><label class="purchase-supplier-name">Supplier name *<input name="supplierName" required autocomplete="off" data-supplier-name placeholder="Enter or search supplier name" value="<%= formSupplier.name || '' %>"></label></div>
    <div class="supplier-suggestions" data-supplier-suggestions hidden></div>
    <label class="purchase-different-supplier"><input name="confirmDifferentSupplier" type="checkbox" value="yes"> This is a different supplier</label>
    <details class="purchase-optional-details" <%= editing && (formSupplier.email || formSupplier.address || formSupplier.gstin || formSupplier.panNumber) ? 'open' : '' %>><summary>More supplier details <span>GSTIN, PAN, email and address</span></summary><div class="form-grid four purchase-extra-fields"><label>GSTIN<input name="supplierGstin" maxlength="20" placeholder="Optional" value="<%= formSupplier.gstin || '' %>"></label><label>PAN<input name="supplierPan" maxlength="20" placeholder="Optional" value="<%= formSupplier.panNumber || '' %>"></label><label>Email<input name="supplierEmail" type="email" placeholder="Optional" value="<%= formSupplier.email || '' %>"></label><label>Address<input name="supplierAddress" placeholder="Optional" value="<%= formSupplier.address || '' %>"></label></div></details>
  </section>
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>Lot received</h2><p>Enter the total pieces and total weight from the supplier bill.</p></div><span class="purchase-step">2</span></div>
    <div class="form-grid four"><label>Item name *<input name="itemName" required data-title-case data-item-autocomplete placeholder="e.g. Gold Earring" value="<%= formPurchase.itemName || '' %>"></label><label>Category *<input name="category" required data-title-case placeholder="e.g. Earring" value="<%= formPurchase.category || '' %>"></label><label>Metal *<select name="metal" data-purchase-metal><option value="GOLD" <%= formPurchase.metal === 'GOLD' || !formPurchase.metal ? 'selected' : '' %>>Gold</option><option value="SILVER" <%= formPurchase.metal === 'SILVER' ? 'selected' : '' %>>Silver</option></select></label><label>Purity<input name="purity" data-purchase-purity placeholder="e.g. 22K, 925, 99.9" value="<%= formPurchase.purity || '' %>"></label><label>Pieces received *<input name="quantity" required type="number" min="1" step="1" value="<%= formPurchase.quantity || 1 %>"></label><label>Gross weight (g)<input name="grossWeight" type="number" min="0" step="0.001" data-purchase-gross placeholder="56.600" value="<%= editing ? Number(formPurchase.grossWeight).toFixed(3) : '' %>"></label><label>Stone weight (g)<input name="stoneWeight" type="number" min="0" step="0.001" value="<%= editing ? Number(formPurchase.stoneWeight).toFixed(3) : '0' %>"></label><label>Net weight (g) *<input name="netWeight" required type="number" min="0.001" step="0.001" data-purchase-net placeholder="56.600" value="<%= editing ? Number(formPurchase.netWeight).toFixed(3) : '' %>"></label></div>
  </section>
  <section class="form-section">
    <div class="purchase-section-title"><div><h2>Amount</h2><p>Keep the balance clear. Record later payments from the purchase register.</p></div><span class="purchase-step">3</span></div>
    <div class="form-grid four"><label>Purchase rate / gram (₹) *<input name="ratePerGram" required type="number" min="0.01" step="0.01" data-purchase-rate data-rate-22="<%=rateInfo.rate?Number(rateInfo.rate.gold22k):0%>" data-rate-24="<%=rateInfo.rate?Number(rateInfo.rate.gold24k):0%>" data-rate-silver="<%=rateInfo.rate?Number(rateInfo.rate.silver):0%>" placeholder="0.00" value="<%= editing ? Number(formPurchase.ratePerGram).toFixed(2) : '' %>"></label><div class="rate-readout accent"><span>Weight × rate</span><strong data-purchase-total><%= editing ? money(Number(formPurchase.netWeight) * Number(formPurchase.ratePerGram)) : '₹0.00' %></strong><small>Suggested purchase amount</small></div><label>Purchase amount (₹) *<input name="totalAmount" required type="number" min="0.01" step="0.01" data-purchase-amount placeholder="0.00" value="<%= editing ? Number(formPurchase.totalAmount).toFixed(2) : '' %>"></label><% if (editing) { %><div class="rate-readout purchase-paid-readout"><span>Paid to date</span><strong><%- money(formPurchase.paid) %></strong><small>Edit payment details from the register</small></div><% } else { %><label>Paid now (₹)<input name="paid" type="number" min="0" step="0.01" data-purchase-paid placeholder="0.00"></label><label>Payment method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><% } %><label>Supplier bill / reference<input name="reference" placeholder="Optional" value="<%= formPurchase.reference || '' %>"></label><div class="rate-readout purchase-payment-status"><span>Payment status</span><strong data-purchase-payment-status><%= editing ? (Number(formPurchase.paid || 0) >= Number(formPurchase.totalAmount || 0) ? 'Fully paid' : Number(formPurchase.paid || 0) > 0 ? 'Partially paid' : 'Unpaid') : 'Unpaid' %></strong><small>Later payments remain editable in the register</small></div></div>
    <details class="purchase-optional-details purchase-note-details" <%= editing && formPurchase.notes ? 'open' : '' %>><summary>Add a note <span>Optional purchase remark</span></summary><label>Notes<textarea name="notes" rows="2" placeholder="Optional"><%= formPurchase.notes || '' %></textarea></label></details>
  </section>
  <footer class="form-footer"><a class="button ghost" href="/purchases">Cancel</a><% if (editing) { %><button class="button" type="submit">Save changes</button><% } else { %><button class="button ghost" type="submit" name="action" value="save-add">Save &amp; add another</button><button class="button" type="submit" name="action" value="save">Save purchase lot</button><% } %></footer>
</form>
<style>.purchase-form-header .muted{margin-top:5px}.purchase-rate-notice{margin-bottom:14px}.purchase-linked-notice{display:flex;gap:10px;align-items:flex-start;margin-bottom:14px}.purchase-linked-notice strong{white-space:nowrap}.purchase-step{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:rgba(193,142,33,.14);color:#9a6811;font-weight:800}.purchase-section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.purchase-section-title h2{margin:0;font-size:17px}.purchase-section-title p{margin:4px 0 0;color:var(--muted,#70685e);font-size:13px}.purchase-supplier-core{grid-template-columns:180px minmax(260px,1fr) 220px}.purchase-supplier-name{min-width:0}.purchase-different-supplier{display:inline-flex;align-items:center;gap:7px;margin-top:11px;color:var(--muted,#70685e);font-size:12px;cursor:pointer}.purchase-different-supplier input{width:auto;min-height:auto;margin:0}.purchase-optional-details{margin-top:14px;padding:11px 13px;border:1px solid var(--border,#e6dfd3);border-radius:10px;background:rgba(193,142,33,.035)}.purchase-optional-details summary{cursor:pointer;font-size:13px;font-weight:700}.purchase-optional-details summary span{margin-left:7px;color:var(--muted,#70685e);font-size:12px;font-weight:400}.purchase-extra-fields{margin-top:13px}.purchase-note-details>label{display:grid;gap:6px;margin-top:12px;font-size:12px;font-weight:700;color:var(--muted,#70685e)}.purchase-paid-readout{min-height:74px}.purchase-paid-readout strong{color:#2c7d54}@media(max-width:760px){.purchase-supplier-core{grid-template-columns:1fr}.purchase-section-title{align-items:flex-start}.purchase-optional-details summary span{display:block;margin:3px 0 0}.purchase-linked-notice{display:block}.purchase-linked-notice span{display:block;margin-top:4px}}</style>
<style>
  /* The supplier workflow starts with mobile, then resolves the name. Keep
     the mobile field compact while giving the resolved supplier name room. */
  .purchase-supplier-core { grid-template-columns: 180px 220px minmax(260px, 1fr); }
  @media (max-width: 760px) { .purchase-supplier-core { grid-template-columns: 1fr; } }
</style>
<script>
(() => {
  const form = document.querySelector('[data-supplier-purchase-form]');
  if (!form) return;
  const editing = form.dataset.editing === 'true';
  const q = (selector) => form.querySelector(selector);
  const n = (element) => Number(element?.value || 0);
  const metal = q('[data-purchase-metal]');
  const purity = q('[data-purchase-purity]');
  const rate = q('[data-purchase-rate]');
  const net = q('[data-purchase-net]');
  const gross = q('[data-purchase-gross]');
  const amount = q('[data-purchase-amount]');
  const paid = q('[data-purchase-paid]');
  const total = q('[data-purchase-total]');
  const status = q('[data-purchase-payment-status]');
  function calc() {
    const value = n(net) * n(rate);
    if (total) total.textContent = '₹' + value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (status && !editing) {
      const paidValue = n(paid);
      status.textContent = paidValue <= 0 ? 'Unpaid' : paidValue >= n(amount) ? 'Fully paid' : 'Partially paid';
    }
  }
  function setRate() {
    if (!editing) {
      const p = (purity?.value || '').trim().toUpperCase();
      const value = metal?.value === 'SILVER' ? rate?.dataset.rateSilver : p === '24K' ? rate?.dataset.rate24 : rate?.dataset.rate22;
      if (Number(value) > 0 && rate && !rate.value) rate.value = Number(value).toFixed(2);
    }
    calc();
  }
  gross?.addEventListener('input', () => { if (net && !net.value) net.value = gross.value; calc(); });
  [net, rate, amount, paid].filter(Boolean).forEach((element) => element.addEventListener('input', calc));
  metal?.addEventListener('change', setRate);
  purity?.addEventListener('input', setRate);
  if (!editing) setRate(); else calc();

  const name = q('[data-supplier-name]');
  const phone = q('[name=supplierPhone]');
  const box = q('[data-supplier-suggestions]');
  let loadedSupplierPhone = '';
  const clearSupplierProfileFields = () => {
    name.value = '';
    q('[name=supplierEmail]').value = '';
    q('[name=supplierAddress]').value = '';
    q('[name=supplierGstin]').value = '';
    q('[name=supplierPan]').value = '';
  };
  const fillSupplier = (supplier) => {
    name.value = supplier.name || '';
    phone.value = supplier.phone || '';
    loadedSupplierPhone = String(supplier.phone || '').replace(/\D/g, '');
    q('[name=supplierEmail]').value = supplier.email || '';
    q('[name=supplierAddress]').value = supplier.address || '';
    q('[name=supplierGstin]').value = supplier.gstin || '';
    q('[name=supplierPan]').value = supplier.panNumber || '';
    if (box) box.hidden = true;
  };
  let timer, controller, phoneTimer, phoneController;
  name?.addEventListener('input', () => {
    // Once the name is edited manually, do not treat a previous phone lookup
    // as the active supplier selection.
    loadedSupplierPhone = '';
    clearTimeout(timer);
    const term = name.value.trim();
    if (term.length < 1) { if (box) box.hidden = true; return; }
    timer = setTimeout(async () => {
      controller?.abort(); controller = new AbortController();
      try {
        const response = await fetch('/api/suppliers/search?q=' + encodeURIComponent(term), { signal: controller.signal });
        const data = await response.json();
        const rows = data.suppliers || [];
        box.replaceChildren(...rows.map((supplier) => {
          const button = document.createElement('button');
          button.type = 'button'; button.textContent = `${supplier.name}${supplier.phone ? ' · ' + supplier.phone : ''}`;
          button.addEventListener('click', () => fillSupplier(supplier));
          return button;
        }));
        box.hidden = !rows.length;
      } catch (error) { if (error.name !== 'AbortError') box.hidden = true; }
    }, 220);
  });
  async function lookupSupplierByPhone() {
    const digits = String(phone?.value || '').replace(/\D/g, '').slice(0, 15);
    if (phone) phone.value = digits;
    if (!digits || digits.length < 10) return;
    phoneController?.abort(); phoneController = new AbortController();
    try {
      const response = await fetch('/api/suppliers/phone/' + encodeURIComponent(digits), { signal: phoneController.signal });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not look up this supplier.');
      if (data.found) fillSupplier(data.supplier);
    } catch (error) { if (error.name !== 'AbortError') { /* keep manual supplier entry available */ } }
  }
  phone?.addEventListener('input', () => {
    clearTimeout(phoneTimer);
    const digits = String(phone.value || '').replace(/\D/g, '');
    // If the counter changes the mobile after selecting a supplier, discard
    // the old auto-filled profile so a purchase cannot be saved to the wrong
    // account. A new exact match will populate the name again below.
    if (loadedSupplierPhone && digits !== loadedSupplierPhone) {
      loadedSupplierPhone = '';
      clearSupplierProfileFields();
    }
    if (digits.length >= 10) phoneTimer = setTimeout(lookupSupplierByPhone, 300);
  });
  phone?.addEventListener('blur', lookupSupplierByPhone);
  phone?.addEventListener('keydown', async (event) => { if (event.key !== 'Enter' || event.isComposing) return; event.preventDefault(); clearTimeout(phoneTimer); await lookupSupplierByPhone(); name?.focus(); });
})();
</script>
