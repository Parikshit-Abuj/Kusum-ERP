<% const isWindowsPrinter = typeof printerPlatform !== 'undefined' ? printerPlatform === 'windows' : true; const nativePrinterMode = isWindowsPrinter ? 'WINDOWS' : 'CUPS'; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= repair ? 'Repair ERP Connection' : 'Shop Setup' %> · Kusum ERP</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" type="image/png" href="/kusum-app-icon.png">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body.setup-body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 44px 20px;
      background: radial-gradient(circle at top, #fffdf8 0%, #f7f1e6 55%, #ede4d6 100%);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #3b3228;
      position: relative;
    }

    .setup-container {
      width: min(100%, 720px);
      position: relative;
      z-index: 1;
    }

    .setup-card {
      background: #ffffff;
      border: 1px solid #dfd4c5;
      border-radius: 22px;
      padding: 44px 50px;
      box-shadow: 0 20px 60px rgba(65, 45, 20, 0.1), 0 2px 8px rgba(65, 45, 20, 0.04);
    }

    /* Header & Branding */
    .setup-header {
      text-align: center;
      margin-bottom: 34px;
    }

    .setup-logo {
      width: 138px;
      height: 138px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #101114;
      border: 1px solid rgba(212, 162, 60, .25);
      border-radius: 50%;
      box-shadow: 0 10px 30px rgba(212, 162, 60, .18);
      margin-bottom: 18px;
    }

    .app-logo-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 0;
    }

    .setup-eyebrow {
      color: #b08a3e;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      margin-bottom: 8px;
    }

    .setup-title {
      font-family: Georgia, serif;
      font-size: 32px;
      font-weight: 800;
      color: #1a1612;
      letter-spacing: -.02em;
      margin-bottom: 10px;
      line-height: 1.2;
    }

    .setup-subtitle {
      color: #7d7369;
      font-size: 14px;
      line-height: 1.6;
      max-width: 580px;
      margin: 0 auto;
    }

    /* Flash messages */
    .setup-card .flash.error {
      background: #fff3f3;
      border: 1px solid #f5c2c7;
      color: #842029;
      padding: 13px 16px;
      border-radius: 12px;
      margin-bottom: 24px;
      font-size: 13.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .setup-card .flash.error span {
      background: #dc3545;
      color: #fff;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: inline-grid;
      place-items: center;
      font-size: 12px;
      font-weight: bold;
    }

    /* Section group styling */
    .setup-section {
      background: #faf7f2;
      border: 1px solid #ebd9c4;
      border-radius: 15px;
      padding: 24px 26px;
      margin-bottom: 22px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .setup-section:focus-within {
      border-color: #c9a044;
      box-shadow: 0 0 0 1px rgba(201, 160, 68, 0.2);
    }

    .section-title-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }

    .section-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(212, 162, 60, 0.18);
      color: #9d6512;
      font-size: 11.5px;
      font-weight: 800;
      display: grid;
      place-items: center;
      border: 1px solid rgba(212, 162, 60, 0.35);
    }

    .section-heading {
      font-size: 14px;
      font-weight: 750;
      color: #2b241d;
      letter-spacing: .01em;
    }

    /* Segmented Controls */
    .setup-segmented-control {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      padding: 5px;
      background: #f0ebe2;
      border: 1px solid #ded4c5;
      border-radius: 12px;
      margin-bottom: 16px;
    }

    .setup-segmented-control label {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 42px;
      margin: 0;
      padding: 8px 12px;
      border-radius: 9px;
      color: #63584c;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .setup-segmented-control label:hover {
      color: #1a1612;
    }

    .setup-segmented-control label:has(input:checked) {
      background: #ffffff;
      color: #9d6512;
      box-shadow: 0 2px 8px rgba(65, 45, 20, 0.12);
    }

    .setup-segmented-control input {
      display: none;
    }

    .setup-mode-badge {
      padding: 12px 16px;
      border-radius: 10px;
      background: #fffaf0;
      border-left: 3.5px solid #d4a23c;
      border-top: 1px solid #faeed6;
      border-right: 1px solid #faeed6;
      border-bottom: 1px solid #faeed6;
      color: #685b4c;
      font-size: 12.5px;
      line-height: 1.55;
      margin-bottom: 16px;
    }

    .setup-mode-badge strong {
      color: #2d2419;
      display: block;
      margin-bottom: 3px;
      font-size: 13px;
    }

    /* Form Fields */
    .form-row {
      display: grid;
      gap: 16px;
      margin-bottom: 14px;
    }

    .form-row.two { grid-template-columns: 1fr 1fr; }
    .form-row.three { grid-template-columns: 2fr 1fr 1.5fr; }

    .setup-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .setup-field label {
      font-size: 11.5px;
      font-weight: 700;
      color: #5a4f42;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .setup-field input,
    .setup-card input,
    #setup-form input {
      padding: 12px 15px;
      border: 1.5px solid #dcd1c2;
      border-radius: 10px;
      background: #ffffff;
      font-size: 14px;
      color: #1a1612;
      transition: all 0.2s ease;
      font-family: inherit;
      font-weight: 500;
      text-transform: none !important;
    }

    .setup-field input:focus {
      outline: none;
      border-color: #c9a044;
      box-shadow: 0 0 0 3.5px rgba(201, 160, 68, 0.14);
    }

    .setup-field input::placeholder {
      color: #aaa093;
    }

    .field-helper {
      color: #7d7162;
      font-size: 12px;
      line-height: 1.55;
      margin-top: 4px;
    }

    .field-helper code {
      background: #ede4d6;
      padding: 2px 6px;
      border-radius: 4px;
      color: #946718;
      font-size: 11.5px;
      font-weight: 600;
    }

    /* Submit Button */
    .setup-submit-btn {
      width: 100%;
      margin-top: 12px;
      padding: 16px;
      border: none;
      border-radius: 13px;
      background: linear-gradient(135deg, #d4a23c, #a37518);
      color: #fff;
      font-size: 15px;
      font-weight: 750;
      letter-spacing: .02em;
      cursor: pointer;
      transition: transform .15s, box-shadow .2s, filter .2s;
      box-shadow: 0 5px 22px rgba(163, 117, 24, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .setup-submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(163, 117, 24, 0.4);
      filter: brightness(1.05);
    }

    .setup-submit-btn:active {
      transform: translateY(0);
      box-shadow: 0 2px 10px rgba(163, 117, 24, 0.2);
    }

    .setup-footer-note {
      text-align: center;
      margin-top: 24px;
      color: #9c9183;
      font-size: 12px;
      letter-spacing: .02em;
    }

    @media (max-width: 680px) {
      .setup-card { padding: 32px 20px; }
      .form-row.two, .form-row.three { grid-template-columns: 1fr; }
      .setup-title { font-size: 26px; }
    }
  </style>
</head>
<body class="setup-body">
  <div class="setup-container">
    <main class="setup-card">
      <div class="setup-header">
        <div class="setup-logo"><img src="/kusum-app-logo.png" alt="Kusum Jewelers" class="app-logo-image"></div>
        <p class="setup-eyebrow">Kusum ERP</p>
        <h1 class="setup-title"><%= repair ? 'Repair ERP Connection' : 'Set Up Shop ERP' %></h1>
        <p class="setup-subtitle">
          <% if (repair) { %>
            Safely update this computer’s database connection without touching or losing existing shop records.
          <% } else { %>
            Choose one Main Database PC to host your shop data, then easily connect all counter and office PCs over your LAN.
          <% } %>
        </p>
      </div>

      <% if (error) { %>
        <div class="flash error">
          <span>!</span>
          <div><%= error %></div>
        </div>
      <% } %>

      <form method="post" action="<%= repair ? '/connection-repair' : '/setup' %>" id="setup-form">
        <!-- 1. PC Role Selection -->
        <div class="setup-section">
          <div class="section-title-wrap">
            <span class="section-num">1</span>
            <span class="section-heading">Installation Role</span>
          </div>

          <div class="setup-segmented-control" role="radiogroup" aria-label="Installation type">
            <label>
              <input type="radio" name="setupMode" value="SERVER" <%= defaults.setupMode === 'CLIENT' ? '' : 'checked' %>>
              Main Database PC
            </label>
            <label>
              <input type="radio" name="setupMode" value="CLIENT" <%= defaults.setupMode === 'CLIENT' ? 'checked' : '' %>>
              Client Counter PC
            </label>
          </div>

          <div class="setup-mode-badge" data-server-copy>
            <strong>Main Database Server</strong>
            Use this on the shop's primary computer. It configures the shared MySQL database and manages connections for all counter PCs.
          </div>

          <div class="setup-mode-badge" data-client-copy hidden>
            <strong>Client Counter PC</strong>
            Use this on billing counter laptops and secondary PCs. It connects directly to the Main PC's database without needing root credentials.
          </div>
        </div>

        <!-- 2. MySQL Connection -->
        <div class="setup-section">
          <div class="section-title-wrap">
            <span class="section-num">2</span>
            <span class="section-heading">MySQL Server Details</span>
          </div>

          <div class="form-row three">
            <div class="setup-field">
              <label>Host / IP Address</label>
              <input name="mysqlHost" type="text" required value="<%= defaults.mysqlHost %>" autocomplete="off" data-mysql-host placeholder="localhost" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
            </div>
            <div class="setup-field">
              <label>Port</label>
              <input name="mysqlPort" type="number" min="1" max="65535" required value="<%= defaults.mysqlPort %>" autocomplete="off" class="preserve-case" data-no-uppercase>
            </div>
            <div class="setup-field">
              <label>Database Name</label>
              <input name="databaseName" type="text" required value="<%= defaults.databaseName %>" pattern="[A-Za-z0-9_]+" autocomplete="off" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
            </div>
          </div>

          <div data-server-fields>
            <div class="form-row two">
              <div class="setup-field">
                <label>MySQL Administrator User</label>
                <input name="mysqlUser" type="text" required value="root" autocomplete="username" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
              </div>
              <div class="setup-field">
                <label>MySQL Root Password</label>
                <input name="mysqlPassword" type="password" autocomplete="current-password" placeholder="Leave blank only if no password" class="preserve-case" data-no-uppercase>
              </div>
            </div>
          </div>

          <div class="field-helper" data-server-hint>
            Keep MySQL on this PC. Ensure port <code>3306</code> is allowed through the local firewall for local subnet PCs.
          </div>
          <div class="field-helper" data-client-hint hidden>
            Enter the Main PC’s LAN IP address (e.g. <code>192.168.1.15</code>). Do not enter <code>localhost</code> on client machines.
          </div>
        </div>

        <!-- 3. ERP Shared Database Credentials -->
        <div class="setup-section">
          <div class="section-title-wrap">
            <span class="section-num">3</span>
            <span class="section-heading">Shared ERP Database Credentials</span>
          </div>

          <div class="form-row two">
            <div class="setup-field">
              <label>Database Username</label>
              <input name="databaseUser" type="text" required value="<%= defaults.databaseUser %>" minlength="3" autocomplete="off" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
            </div>
            <div class="setup-field">
              <label>Database Password</label>
              <input name="databasePassword" type="password" required autocomplete="new-password" placeholder="Choose a secure password" class="preserve-case" data-no-uppercase>
            </div>
          </div>
          <div class="field-helper">
            On the Main PC, set this password. Enter the exact same password on all Client PCs to link them together.
          </div>
        </div>

        <!-- 4. Owner / Admin Login -->
        <div class="setup-section">
          <div class="section-title-wrap">
            <span class="section-num">4</span>
            <span class="section-heading">ERP Admin Login Credentials</span>
          </div>

          <div class="form-row two">
            <div class="setup-field">
              <label>ERP Login Username</label>
              <input name="appUsername" type="text" required value="<%= defaults.appUsername %>" minlength="3" autocomplete="username" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
            </div>
            <div class="setup-field">
              <label>ERP Login Password</label>
              <input name="appPassword" type="password" required autocomplete="new-password" placeholder="Set your shop login password" class="preserve-case" data-no-uppercase>
            </div>
          </div>
          <div class="field-helper">
            This password will be used by staff and shop owner to log into Kusum ERP.
          </div>
        </div>

        <!-- 5. Barcode Printer Connectivity -->
        <div class="setup-section">
          <div class="section-title-wrap">
            <span class="section-num">5</span>
            <span class="section-heading">Barcode Label Printer</span>
          </div>

          <div class="setup-segmented-control" role="radiogroup" aria-label="Barcode printer connection">
            <label>
              <input type="radio" name="printerMode" value="<%= nativePrinterMode %>" <%= defaults.printerMode === 'TCP' ? '' : 'checked' %>>
              <%= isWindowsPrinter ? 'Windows / USB Printer' : 'CUPS / USB Printer' %>
            </label>
            <label>
              <input type="radio" name="printerMode" value="TCP" <%= defaults.printerMode === 'TCP' ? 'checked' : '' %>>
              Direct Network TCP/IP
            </label>
          </div>

          <div data-windows-printer-fields>
            <div class="setup-field">
              <label><%= isWindowsPrinter ? 'Installed Windows TSC Printer Name' : 'Installed CUPS Printer Queue' %></label>
              <input name="printerName" type="text" value="<%= defaults.printerName %>" autocomplete="off" placeholder="<%= isWindowsPrinter ? 'e.g. TSC TTP-244 Pro' : 'e.g. TSC_TTP_244_Pro' %>" class="preserve-case" data-no-uppercase>
            </div>
          </div>

          <div class="form-row two" data-tcp-printer-fields hidden>
            <div class="setup-field">
              <label>Printer / Print-Server IP</label>
              <input name="printerHost" type="text" value="<%= defaults.printerHost %>" autocomplete="off" placeholder="e.g. 192.168.1.60" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false">
            </div>
            <div class="setup-field">
              <label>Direct RAW TCP Port</label>
              <input name="printerPort" type="number" min="1" max="65535" value="<%= defaults.printerPort %>" autocomplete="off" placeholder="9100" class="preserve-case" data-no-uppercase>
            </div>
          </div>

          <div class="field-helper">
            <% if (isWindowsPrinter) { %>USB printers like TSC TTP-244 Pro should use the Windows printer queue. Network print servers use RAW port 9100.<% } else { %>USB printers should be installed as a CUPS queue. Network print servers use RAW port 9100.<% } %>
          </div>
        </div>

        <button class="setup-submit-btn" type="submit" data-submit-label>
          <span data-btn-text>Create Shared Database and Start ERP</span>
        </button>

        <div class="setup-footer-note">
          Kusum ERP · Enterprise Jewellery Management System
        </div>
      </form>
    </main>
  </div>

  <script>
    (() => {
      const form = document.getElementById('setup-form');
      const host = form.querySelector('[data-mysql-host]');
      const serverFields = form.querySelector('[data-server-fields]');
      const serverCopy = form.querySelector('[data-server-copy]');
      const clientCopy = form.querySelector('[data-client-copy]');
      const serverHint = form.querySelector('[data-server-hint]');
      const clientHint = form.querySelector('[data-client-hint]');
      const btnText = form.querySelector('[data-btn-text]');
      const windowsPrinterFields = form.querySelector('[data-windows-printer-fields]');
      const tcpPrinterFields = form.querySelector('[data-tcp-printer-fields]');

      const update = () => {
        const client = form.querySelector('input[name="setupMode"]:checked').value === 'CLIENT';
        serverFields.hidden = client;
        serverCopy.hidden = client;
        clientCopy.hidden = !client;
        serverHint.hidden = client;
        clientHint.hidden = !client;
        btnText.textContent = client ? 'Connect to Main ERP Database' : 'Create Shared Database and Start ERP';
        host.placeholder = client ? 'Example: 192.168.1.20' : 'localhost';
        if (client && host.value === 'localhost') host.value = '';
        if (!client && !host.value) host.value = 'localhost';

        const directTcp = form.querySelector('input[name="printerMode"]:checked').value === 'TCP';
        windowsPrinterFields.hidden = directTcp;
        tcpPrinterFields.hidden = !directTcp;
      };

      form.querySelectorAll('input[name="setupMode"], input[name="printerMode"]').forEach((input) => {
        input.addEventListener('change', update);
      });
      update();
    })();
  </script>
  <script src="/app.js"></script>
</body>
</html>
