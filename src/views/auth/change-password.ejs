<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Change ERP password · Kusum ERP</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" type="image/png" href="/kusum-app-icon.png">
</head>
<body class="login-page">
  <main class="login-card">
    <span class="brand-mark brand-mark-image"><img src="/kusum-app-icon.png" alt="Kusum Jewelers" class="app-logo-image"></span>
    <p class="eyebrow">Secure ERP access</p>
    <h1>Choose your ERP password</h1>
    <% if (error) { %><div class="flash error"><span>!</span><%= error %></div><% } %>
    <% if (message) { %><div class="flash success"><span>✓</span><%= message %></div><% } %>
    <form method="post" action="/change-password">
      <% if (requireCurrentPassword) { %>
        <label>Current password<input name="currentPassword" type="password" required autocomplete="current-password" class="preserve-case" data-no-uppercase></label>
      <% } %>
      <label>New password<input name="newPassword" type="password" required autocomplete="new-password" class="preserve-case" data-no-uppercase autofocus></label>
      <label>Confirm new password<input name="confirmPassword" type="password" required autocomplete="new-password" class="preserve-case" data-no-uppercase></label>
      <button class="button full large" type="submit">Save password and continue</button>
    </form>
  </main>
  <script src="/i18n.js"></script>
  <script src="/app.js"></script>
</body>
</html>
