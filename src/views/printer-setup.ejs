<% const isWindowsPrinter = typeof printerPlatform !== 'undefined' ? printerPlatform === 'windows' : true; const nativePrinterMode = isWindowsPrinter ? 'WINDOWS' : 'CUPS'; %>
<header class="page-header">
  <div><p class="eyebrow">Native TSPL labels</p><h1>Barcode printer setup</h1></div>
  <a class="button ghost" href="/inventory">Back to inventory</a>
</header>

<section class="content-grid single-panel" style="max-width: 680px;">
  <article class="panel">
    <div class="panel-heading"><div><h2>Connection</h2></div></div>
    <form method="post" action="/printer-setup" id="printer-setup-form" class="stack-form">
      <div class="segmented-control" role="radiogroup" aria-label="Barcode printer transport">
        <label><input type="radio" name="printerMode" value="<%= nativePrinterMode %>" <%= printer.mode === 'TCP' ? '' : 'checked' %>> <%= isWindowsPrinter ? 'Windows printer / USB' : 'CUPS printer / USB' %></label>
        <label><input type="radio" name="printerMode" value="TCP" <%= printer.mode === 'TCP' ? 'checked' : '' %>> Direct TCP / Ethernet</label>
      </div>
      <div data-windows-printer-fields>
        <label><%= isWindowsPrinter ? 'Installed Windows printer name' : 'Installed CUPS printer queue' %><input name="printerName" type="text" value="<%= printer.name %>" autocomplete="off" placeholder="<%= isWindowsPrinter ? 'Example: TSC TTP-244 Pro' : 'Example: TSC_TTP_244_Pro' %>" class="preserve-case" data-no-uppercase></label>
      </div>
      <div class="form-grid two compact-fields" data-tcp-printer-fields hidden>
        <label>Printer / print-server IP<input name="printerHost" type="text" value="<%= printer.host %>" autocomplete="off" placeholder="Example: 192.168.1.60" class="preserve-case" data-no-uppercase autocapitalize="none" spellcheck="false"></label>
        <label>Direct TCP port<input name="printerPort" type="number" min="1" max="65535" value="<%= printer.port || 9100 %>" autocomplete="off" class="preserve-case" data-no-uppercase></label>
      </div>
      <button class="button" type="submit" style="margin-top: 12px;">Save printer connection</button>
    </form>
  </article>
</section>
<script>
  (() => {
    const form = document.getElementById('printer-setup-form');
    const windowsFields = form.querySelector('[data-windows-printer-fields]');
    const tcpFields = form.querySelector('[data-tcp-printer-fields]');
    const update = () => {
      const directTcp = form.querySelector('input[name="printerMode"]:checked').value === 'TCP';
      windowsFields.hidden = directTcp;
      tcpFields.hidden = !directTcp;
    };
    form.querySelectorAll('input[name="printerMode"]').forEach((input) => input.addEventListener('change', update));
    update();
  })();
</script>
