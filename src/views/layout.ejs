<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · <%= businessSettings?.shopName || 'Kusum ERP' %></title>
    <link rel="icon" type="image/png" href="/kusum-app-icon.png">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/workspace.css" media="screen">
    <link rel="stylesheet" href="/refinement.css" media="screen">
  </head>
  <body class="erp-ui">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
      <!-- Mobile Responsive Top Bar -->
      <div class="mobile-top-bar">
        <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
          <span>☰</span>
        </button>
        <a class="mobile-brand" href="/">
          <span class="brand-mark-sm brand-mark-image"><img src="/kusum-app-icon.png" alt="Kusum Jewelers" class="app-logo-image"></span>
          <strong><%= businessSettings?.shopName || 'Kusum ERP' %></strong>
        </a>
      </div>
      <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

      <aside class="sidebar" id="appSidebar">
        <a class="brand" href="/">
          <span class="brand-mark brand-mark-image"><img src="/kusum-app-icon.png" alt="Kusum Jewelers" class="app-logo-image"></span>
          <span><%= businessSettings?.shopName || 'Kusum ERP' %><small>Jewelry management</small></span>
        </a>
        <% const navigationGroups = [
          { name: 'Workspace', links: [
            ['/', 'Dashboard', 'dashboard'], ['/sales', 'Sales', 'receipt'],
            ['/inventory', 'Inventory', 'diamond'], ['/customer-orders', 'Customer Orders', 'receipt'], ['/purchases', 'Suppliers & Purchases', 'download'], ['/urd-purchases', 'URD Purchase', 'exchange'], ['/pledges', 'Pledge Loans', 'wallet'],
            ['/customers', 'Customers', 'people'], ['/schemes', 'Schemes', 'scheme'], ['/cashbook', 'Cashbook', 'wallet']
          ] },
          { name: 'Manage', links: [
            ['/rates', 'Daily rates', 'trend'], ['/item-names', 'Item Names', 'grid'],
            ['/reports', 'Reports', 'chart'], ['/data-management', 'Export & archive', 'download'],
            ['/business-settings', 'Business Settings', 'grid']
          ] }
        ]; const activeSection = navigationGroups.flatMap(group => group.links).find(([url]) => url === '/' ? currentPath === '/' : currentPath.startsWith(url)); %>
        <nav aria-label="Main navigation">
          <% navigationGroups.forEach(group => { %>
          <div class="nav-group">
            <p class="nav-group-label"><%= group.name %></p>
            <% group.links.forEach(([url, label, icon]) => { const active = url === '/' ? currentPath === '/' : currentPath.startsWith(url); %>
            <a class="<%= active ? 'active' : '' %>" href="<%= url %>" <%- active ? 'aria-current="page"' : '' %>>
              <svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#<%= icon %>"></use></svg>
              <span class="nav-label"><%= label %></span>
            </a>
            <% }); %>
          </div>
          <% }); %>
        </nav>
        <div class="sidebar-foot">
          <details class="account-menu">
            <summary><span class="account-avatar" aria-hidden="true" data-no-i18n><%= String(loggedInUser || 'K').slice(0, 1).toUpperCase() %></span><span class="account-copy"><small>Signed in as</small><strong data-no-i18n><%= loggedInUser %></strong></span><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#more"></use></svg></summary>
            <div class="account-options">
              <a href="/change-password">Change password</a>
              <form method="post" action="/logout"><button type="submit">Sign out</button></form>
            </div>
          </details>
        </div>
      </aside>
      <main class="main-content" id="main-content" tabindex="-1">
        <div class="workspace-toolbar" aria-label="Workspace tools">
          <div class="workspace-toolbar-start">
            <button class="sidebar-toggle" id="sidebarToggle" type="button" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="true" aria-label="Hide navigation" title="Hide navigation">
              <span class="sidebar-toggle-glyph" aria-hidden="true">‹</span>
              <span data-sidebar-toggle-label>Hide navigation</span>
            </button>
            <div class="workspace-breadcrumb"><span>Workspace</span><span aria-hidden="true">/</span><strong><%= activeSection ? activeSection[1] : title %></strong></div>
          </div>
          <div class="workspace-tools">
          <button class="global-search-trigger" type="button" data-global-search-open aria-haspopup="dialog">
            <svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#search"></use></svg>
            <span>Search anything…</span>
            <kbd>Ctrl K</kbd>
          </button>
          <button class="toolbar-language" type="button" data-ui-language-toggle aria-label="Switch ERP interface language">मराठी</button>
          </div>
        </div>
        <% if (message) { %><div class="flash success"><span>✓</span><%= message %></div><% } %>
        <% if (error) { %><div class="flash error"><span>!</span><%= error %></div><% } %>
        <%- body %>
      </main>
    </div>
    <div class="modal-overlay global-search-modal" id="globalSearchModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="globalSearchTitle">
      <section class="modal-card global-search-card" role="document">
        <header class="global-search-header">
          <label id="globalSearchTitle" class="sr-only" for="globalSearchInput">Search ERP records</label>
          <span aria-hidden="true">⌕</span>
          <input id="globalSearchInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search barcode, invoice, customer, URD or scheme">
          <button class="modal-close-btn" type="button" data-global-search-close aria-label="Close search">×</button>
        </header>
        <div class="global-search-help" data-global-search-help>Type at least 2 characters to search available stock and recent records.</div>
        <div class="global-search-results" data-global-search-results aria-live="polite"></div>
      </section>
    </div>
    <script src="/i18n.js"></script>
    <script src="/app.js?v=20260914-supplier-autocomplete-1"></script>
    <script src="/workspace.js"></script>
  </body>
</html>
