<header class="page-header">
  <div><p class="eyebrow">Current inventory</p><h1>Stock report</h1></div>
  <a class="button ghost" href="/reports">← All reports</a>
</header>

<section class="panel report-filter-panel">
  <form class="report-filter-form" method="get">
    <label>From<input type="date" name="from" value="<%= filters.from || '' %>"></label>
    <label>To<input type="date" name="to" value="<%= filters.to || '' %>"></label>
    <label>Item name<input name="itemName" data-item-autocomplete data-item-autocomplete-mode="search" value="<%= filters.itemName || '' %>" placeholder="Ring, chain, payal…" autocomplete="off"></label>
    <label>Weight (g)<input name="weight" type="number" min="0" step="0.001" value="<%= filters.weight || '' %>" placeholder="18.250"></label>
    <label>Barcode<input name="barcode" value="<%= filters.barcode || '' %>" placeholder="G 1 or S A"></label>
    <label>Metal<select name="metal"><option value="">All metals</option><% ['GOLD','SILVER','PLATINUM','DIAMOND','OTHER'].forEach((value) => { %><option value="<%= value %>" <%= filters.metal === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
    <label>Category<input name="category" value="<%= filters.category || '' %>" placeholder="Ring, Chain…"></label>
    <label>Location / tray<input name="location" value="<%= filters.location || '' %>" placeholder="Tray 1…"></label>
    <div class="report-filter-actions"><button class="button small" type="submit">Apply filters</button><a class="button ghost small" href="/reports/stock">Reset</a></div>
  </form>
</section>

<section class="stats-grid report-register-summary" aria-label="Filtered stock totals">
  <article class="stat-card accent-gold"><span class="stat-label">Total pieces</span><strong><%= summary.pieces.toLocaleString('en-IN') %></strong><p>Matching available stock</p></article>
  <article class="stat-card"><span class="stat-label">Gross weight</span><strong><%= grams(summary.grossWeight) %></strong><p>Across the filtered items</p></article>
  <article class="stat-card"><span class="stat-label">Net weight</span><strong><%= grams(summary.netWeight) %></strong><p>After stone weight</p></article>
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>Available stock</h2><p><%= pagination.totalItems %> barcode item<%= pagination.totalItems === 1 ? '' : 's' %> found.</p></div></div>
  <% if (products.length) { %>
  <div class="table-wrap"><table><thead><tr><th>Barcode / item</th><th>Category</th><th>Metal</th><th>Purity</th><th class="right">Pieces</th><th class="right">Gross wt.</th><th class="right">Net wt.</th><th>Location</th></tr></thead><tbody>
    <% products.forEach((product) => { %><tr>
      <td><strong class="barcode-label"><%= product.barcode %></strong><small><%= product.name %></small></td>
      <td><%= product.category %></td>
      <td><span class="metal-dot <%= product.metal.toLowerCase() %>"></span><%= product.metal %></td>
      <td><%= product.purity || '—' %></td>
      <td class="right"><strong><%= product.quantity %></strong></td>
      <td class="right"><%= grams(product.grossWeight) %></td><td class="right"><%= grams(product.netWeight) %></td>
      <td><%= product.location || '—' %></td>
    </tr><% }) %>
  </tbody></table></div>
  <%- include('../_pagination', { pagination }) %>
  <% } else { %><div class="empty-state compact"><span>◇</span><h3>No stock matches these filters</h3><p>Try a different item, metal, category or location.</p></div><% } %>
</section>
