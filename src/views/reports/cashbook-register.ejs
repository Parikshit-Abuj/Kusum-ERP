<header class="page-header"><div><p class="eyebrow">Money movement</p><h1>Cashbook register</h1></div><a class="button ghost" href="/reports">← All reports</a></header>
<section class="panel report-filter-panel"><form class="report-filter-form" method="get"><label>From<input type="date" name="from" value="<%= filters.from %>"></label><label>To<input type="date" name="to" value="<%= filters.to %>"></label><label>Search<input name="q" data-customer-autocomplete data-customer-autocomplete-mode="search" value="<%= filters.q %>" placeholder="Description, customer, supplier or reference" autocomplete="off"></label><label>Method<select name="paymentMethod"><option value="">All methods</option><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach(m=> { %><option value="<%= m %>" <%= filters.paymentMethod === m ? 'selected' : '' %>><%= m.replace('_',' ') %></option><% }) %></select></label><label>Type<select name="type"><option value="">All</option><option value="IN" <%= filters.type === 'IN' ? 'selected' : '' %>>Money in</option><option value="OUT" <%= filters.type === 'OUT' ? 'selected' : '' %>>Money out</option></select></label><div class="report-filter-actions"><button class="button small" type="submit">Apply filters</button><a class="button ghost small" href="/reports/cashbook-register">Reset</a></div></form></section>
<section class="stats-grid report-register-summary"><article class="stat-card accent-gold"><span class="stat-label">Money in</span><strong><%= money(summary.in) %></strong></article><article class="stat-card"><span class="stat-label">Money out</span><strong><%= money(summary.out) %></strong></article><article class="stat-card"><span class="stat-label">Net</span><strong><%= money(summary.in - summary.out) %></strong></article></section>
<section class="panel"><% if (entries.length) { %><div class="table-wrap"><table><thead><tr><th>Date</th><th>Description</th><th>Party</th><th>Method</th><th>Type</th><th class="right">Amount</th></tr></thead><tbody><% entries.forEach(entry => { %><tr><td><%= formatDateDisplay(entry.entryDate) %></td><td><strong><%= entry.description %></strong><small><%= entry.reference || '' %></small></td><td><%= entry.customer?.name || entry.supplierPurchase?.supplier?.name || '—' %></td><td><%= entry.paymentMethod.replace('_',' ') %></td><td><span class="pill <%= entry.type === 'IN' ? 'success' : 'danger' %>"><%= entry.type %></span></td><td class="right"><strong><%= money(entry.amount) %></strong></td></tr><% }) %></tbody></table></div><%- include('../_pagination', { pagination }) %><% } else { %><div class="empty-state compact"><span>▤</span><h3>No cashbook entries match this filter</h3></div><% } %></section>
