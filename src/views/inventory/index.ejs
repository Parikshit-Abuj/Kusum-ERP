<header class="page-header">
  <div><p class="eyebrow">Stock control</p><h1>Inventory</h1></div>
  <div class="header-actions">
    <details class="action-menu">
      <summary class="button ghost">More <span aria-hidden="true">⌄</span></summary>
      <div class="action-menu-panel">
        <button class="action-menu-item" type="button" data-export-modal-open="inventoryExportModal">Export Excel</button>
        <button class="action-menu-item" type="button" data-printer-setup-open>Printer setup</button>
        <button class="action-menu-item" type="submit" form="label-test-form">Test TSC printer</button>
      </div>
    </details>
    <a class="button secondary" href="/inventory/new">+ Add single item</a>
    <button type="button" class="button" data-open-batch-modal>+ Batch Add Pieces</button>
    <button type="button" class="button danger" data-open-batch-remove>− Batch Remove Pieces</button>
  </div>
</header>
<form id="label-test-form" method="post" action="/labels/test-print"></form>
<%
  const isWindowsPrinter = typeof printerPlatform !== 'undefined' ? printerPlatform === 'windows' : true;
  const nativePrinterMode = isWindowsPrinter ? 'WINDOWS' : 'CUPS';
  const inventoryFilters = typeof filters !== 'undefined' && filters ? filters : { itemName: '', weight: '', barcode: '' };
  const hasInventoryFilters = Boolean(inventoryFilters.itemName || inventoryFilters.weight || inventoryFilters.barcode);
  const printerCheckParams = new URLSearchParams();
  if (inventoryFilters.itemName) printerCheckParams.set('itemName', inventoryFilters.itemName);
  if (inventoryFilters.weight) printerCheckParams.set('weight', inventoryFilters.weight);
  if (inventoryFilters.barcode) printerCheckParams.set('barcode', inventoryFilters.barcode);
  printerCheckParams.set('checkPrinter', '1');
%>
<section class="panel register-panel">
  <form class="search-bar inventory-filter-form" method="get">
    <label>Item name<input name="itemName" data-item-autocomplete data-item-autocomplete-mode="search" value="<%= inventoryFilters.itemName %>" placeholder="Ring, chain, payal…" autocomplete="off"></label>
    <label>Weight (g)<input name="weight" type="number" min="0" step="0.001" value="<%= inventoryFilters.weight %>" placeholder="18.250"></label>
    <label>Barcode<input name="barcode" value="<%= inventoryFilters.barcode %>" placeholder="G 1 or G A"></label>
    <button class="button secondary" type="submit">Search</button>
    <% if (hasInventoryFilters) { %><a class="button ghost" href="/inventory">Clear</a><% } %>
  </form>
  <div data-inventory-live-content>
  <% if (products.length) { %><form id="label-print-form" class="label-batch-toolbar" method="post" action="/labels/print"><div><strong data-label-count>0 selected</strong><% if (typeof printerStatus !== 'undefined' && printerStatus) { %><div class="printer-status <%= printerStatus.available === true ? 'is-ready' : (printerStatus.available === false ? '!' : '•') %>"><span><%= printerStatus.available === true ? '●' : (printerStatus.available === false ? '!' : '•') %></span><%= printerStatus.message %><a href="/inventory?<%= printerCheckParams.toString() %>">Check printer</a></div><% } %></div><label class="printer-name"><%= (typeof printerTransport !== 'undefined' && printerTransport?.mode === 'TCP') ? 'Direct TCP printer' : (isWindowsPrinter ? 'Windows printer queue' : 'CUPS printer queue') %><input name="printerName" readonly value="<%= typeof printerName !== 'undefined' ? printerName : '' %>"></label><button class="button small" type="submit" data-label-print-button disabled>Send to TSC TTP-244 Pro</button></form>
  <div class="table-wrap inventory-list-view"><table class="inventory-table"><thead><tr><th class="label-select"><input type="checkbox" data-label-select-all title="Select all visible items"></th><th>Barcode / item</th><th>Metal / purity</th><th>Weight</th><th>Making type</th><th>Location</th><th></th></tr></thead><tbody>
  <% products.forEach((product) => { %><tr>
    <td class="label-select"><input form="label-print-form" type="checkbox" name="productId" value="<%= product.id %>" data-label-select <%= product.barcode ? '' : 'disabled' %>></td>
    <td><strong class="barcode-label"><%= product.barcode || 'No barcode' %></strong><small><%= product.name %> · <%= product.category %></small></td>
    <td><span class="metal-dot <%= product.metal.toLowerCase() %>"></span><%= product.metal %><small><%= product.purity || '—' %></small></td>
    <td><strong><%= grams(product.netWeight) %></strong><small>Gross: <%= grams(product.grossWeight) %></small></td>
    <td><span class="pill neutral"><%= product.makingChargeType.replace('_', ' ') %></span></td>
    <td><%= product.location || '—' %></td>
    <td class="actions">
      <a class="icon-button" title="Edit item" href="/inventory/<%= product.id %>/edit">✎</a>
      <form method="post" action="/inventory/<%= product.id %>/delete" style="display:inline;margin:0;" onsubmit="return confirm('Do you want to delete item?');">
        <button type="submit" class="icon-button delete-icon" title="Delete item">✕</button>
      </form>
    </td>
  </tr><% }) %>
  </tbody></table></div><% } else { %><div class="empty-state"><span>◇</span><h3>No jewellery items found</h3><p>Add stock to start billing and tracking inventory.</p><button type="button" class="button" data-open-batch-modal>⚡ Batch Add Pieces</button></div><% } %>
  <%- include('../_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
</section>

<%- include('_batch_modal') %>
<%- include('_batch_remove_modal') %>

<div class="modal-overlay printer-setup-modal" id="printerSetupModal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="printerSetupModalTitle" aria-hidden="true">
  <section class="modal-card" role="document">
    <header class="modal-header">
      <div>
        <p class="eyebrow">Native TSPL labels</p>
        <h2 id="printerSetupModalTitle">Printer setup</h2>
      </div>
      <button class="modal-close-btn" type="button" data-printer-setup-close aria-label="Close printer setup">&times;</button>
    </header>
    <form method="post" action="/printer-setup" id="inventory-printer-setup-form" class="stack-form">
      <input type="hidden" name="returnTo" value="/inventory">
      <div class="modal-body printer-setup-modal-body">
        <div class="segmented-control" role="radiogroup" aria-label="Barcode printer transport">
          <label><input type="radio" name="printerMode" value="<%= nativePrinterMode %>" <%= printerTransport.mode === 'TCP' ? '' : 'checked' %>> <%= isWindowsPrinter ? 'Windows printer / USB' : 'CUPS printer / USB' %></label>
          <label><input type="radio" name="printerMode" value="TCP" <%= printerTransport.mode === 'TCP' ? 'checked' : '' %>> Direct TCP / Ethernet</label>
        </div>
        <div data-windows-printer-fields>
          <label><%= isWindowsPrinter ? 'Installed Windows printer name' : 'Installed CUPS printer queue' %><input name="printerName" value="<%= printerTransport.name %>" autocomplete="off" placeholder="<%= isWindowsPrinter ? 'Example: TSC TTP-244 Pro' : 'Example: TSC_TTP_244_Pro' %>"></label>
        </div>
        <div class="form-grid two compact-fields" data-tcp-printer-fields hidden>
          <label>Printer / print-server IP<input name="printerHost" value="<%= printerTransport.host %>" autocomplete="off" placeholder="Example: 192.168.1.60"></label>
          <label>Direct TCP port<input name="printerPort" type="number" min="1" max="65535" value="<%= printerTransport.port || 9100 %>" autocomplete="off"></label>
        </div>
      </div>
      <footer class="modal-footer printer-setup-modal-footer">
        <button class="button ghost" type="button" data-printer-setup-close>Cancel</button>
        <button class="button" type="submit">Save printer connection</button>
      </footer>
    </form>
  </section>
</div>

<%- include('../_export_modal', { exportModalId: 'inventoryExportModal', exportResource: 'inventory', exportTitle: 'Inventory', exportFrom: dateInput(), exportTo: dateInput() }) %>
