<header class="page-header">
  <div><p class="eyebrow">Shop configuration</p><h1>Business settings</h1><p>Identity, invoices, tax defaults and signatures.</p></div>
</header>

<form method="post" action="/business-settings" class="settings-form" id="businessSettingsForm">
  <section class="panel settings-section">
    <div class="panel-heading"><div><h2>Business identity</h2></div></div>
    <div class="form-grid two">
      <label>Shop name<input name="shopName" required maxlength="255" value="<%= settings.shopName %>"></label>
      <label>Shop address<textarea name="shopAddress" rows="3"><%= settings.shopAddress || '' %></textarea></label>
      <label>GSTIN<input name="gstin" maxlength="20" value="<%= settings.gstin || '' %>" style="text-transform:uppercase"></label>
      <label>PAN<input name="panNumber" maxlength="20" value="<%= settings.panNumber || '' %>" style="text-transform:uppercase"></label>
      <label>Primary phone<input name="primaryPhone" maxlength="30" value="<%= settings.primaryPhone || '' %>"></label>
      <label>Secondary phone<input name="secondaryPhone" maxlength="30" value="<%= settings.secondaryPhone || '' %>"></label>
      <label>Facebook link<input name="facebookUrl" type="url" class="preserve-case" data-no-uppercase value="<%= settings.facebookUrl || '' %>"></label>
      <label>Instagram link<input name="instagramUrl" type="url" class="preserve-case" data-no-uppercase value="<%= settings.instagramUrl || '' %>"></label>
    </div>
  </section>

  <section class="panel settings-section">
    <div class="panel-heading"><div><h2>Invoice and tax</h2></div></div>
    <div class="form-grid three">
      <label>Invoice prefix<input name="invoicePrefix" required maxlength="8" value="<%= settings.invoicePrefix %>" style="text-transform:uppercase"><small>Example: SB gives SB-2627-1.</small></label>
      <label>Financial year starts<select name="financialYearStartMonth"><% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach((month, index) => { %><option value="<%= index + 1 %>" <%= settings.financialYearStartMonth === index + 1 ? 'selected' : '' %>><%= month %></option><% }) %></select></label>
      <label>Default GST (%)<input name="defaultGstRate" type="number" min="0" max="100" step="0.01" required value="<%= settings.defaultGstRate %>"></label>
      <label>Default HSN<input name="defaultHsnCode" maxlength="50" value="<%= settings.defaultHsnCode || '' %>"></label>
    </div>
  </section>

  <section class="panel settings-section">
    <div class="panel-heading"><div><h2>Authorised signature</h2></div></div>
    <div class="signature-setting">
      <div class="signature-preview" data-signature-preview><% if (settings.signatureImage) { %><img src="/business-settings/signature" alt="Current authorised signature"><% } else { %><span>The bundled Kusum signature is currently used.</span><% } %></div>
      <div>
        <label>Choose PNG or JPEG<input id="signatureFile" type="file" accept="image/png,image/jpeg" class="preserve-case" data-no-uppercase></label>
        <input name="signatureData" type="hidden" data-signature-data>
        <% if (settings.signatureImage) { %><label class="check-row"><input name="removeSignature" type="checkbox"> Remove saved signature and use bundled fallback</label><% } %>
      </div>
    </div>
  </section>

  <div class="settings-save"><button class="button" type="submit">Save business settings</button></div>
</form>

<style>
.settings-form{display:grid;gap:16px;max-width:1050px}.settings-section{padding:20px}.settings-section .panel-heading{margin:-4px 0 18px}.settings-section label small{display:block;margin-top:5px;color:var(--muted);font-weight:500}.signature-setting{display:grid;grid-template-columns:minmax(220px,360px) 1fr;gap:24px;align-items:center}.signature-preview{height:110px;border:1px dashed var(--border);border-radius:12px;background:#fff;display:grid;place-items:center;overflow:hidden;color:var(--muted);font-size:12px}.signature-preview img{max-width:95%;max-height:100px;object-fit:contain}.check-row{display:flex!important;align-items:center;gap:8px;margin-top:10px}.check-row input{width:auto}.settings-save{position:sticky;bottom:14px;display:flex;justify-content:flex-end;padding:12px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.94);backdrop-filter:blur(8px)}@media(max-width:700px){.signature-setting{grid-template-columns:1fr}}
</style>
<script>
(() => {
  const settingsForm = document.getElementById('businessSettingsForm');
  settingsForm?.addEventListener('submit', (event) => {
    const confirmed = window.confirm('Are you sure you want to change and save the business settings?');
    if (!confirmed) event.preventDefault();
  });
  const input = document.getElementById('signatureFile');
  const hidden = document.querySelector('[data-signature-data]');
  const preview = document.querySelector('[data-signature-preview]');
  input?.addEventListener('change', () => {
    const file = input.files?.[0];
    if (!file) return;
    if (!['image/png','image/jpeg'].includes(file.type) || file.size > 1024 * 1024) {
      input.value = '';
      alert('Choose a PNG or JPEG signature smaller than 1 MB.');
      return;
    }
    const reader = new FileReader();
    reader.onload = () => { hidden.value = String(reader.result || ''); preview.innerHTML = ''; const image = document.createElement('img'); image.src = hidden.value; image.alt = 'New authorised signature'; preview.append(image); };
    reader.readAsDataURL(file);
  });
})();
</script>
