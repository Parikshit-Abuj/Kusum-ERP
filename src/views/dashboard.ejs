<%
  const _stats = typeof stats !== 'undefined' && stats ? stats : {
    goldPieces: 0, goldWeight: 0, silverPieces: 0, silverWeight: 0, otherPieces: 0, otherWeight: 0,
    sales: 0, invoices: 0, amountCollected: 0, customerDue: 0, cashNet: 0, cashIn: 0, cashOut: 0
  };
  const _topItem = typeof topSellingItem !== 'undefined' ? topSellingItem : null;
  const _invByMetal = typeof inventoryByMetal !== 'undefined' && Array.isArray(inventoryByMetal) ? inventoryByMetal : [];
  const _itemBreakdown = typeof itemWeightBreakdown !== 'undefined' && Array.isArray(itemWeightBreakdown) ? itemWeightBreakdown : [];
  const _recentSales = typeof recentSales !== 'undefined' && Array.isArray(recentSales) ? recentSales : [];
%>
<header class="page-header overview-heading">
  <div><p class="eyebrow">Overview</p><h1>Dashboard</h1></div>
  <div class="header-actions">
    <a class="button ghost" href="/cashbook?addEntry=1">+ Cash Entry</a>
    <a class="button secondary" href="/inventory?openBatch=1">+ Batch Stock</a>
    <a class="button" href="/sales/new">+ New sale</a>
  </div>
</header>

<section class="overview-metrics" aria-label="Daily overview">
  <article class="overview-metric metric-gold">
    <div class="metric-heading"><span>Gold stock</span><span class="metric-symbol"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#diamond"></use></svg></span></div>
    <strong><%= grams(_stats.goldWeight) %></strong>
    <p><span data-no-i18n><%= _stats.goldPieces %></span> <span>available pieces</span></p>
  </article>
  <article class="overview-metric metric-silver">
    <div class="metric-heading"><span>Silver stock</span><span class="metric-symbol"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#diamond"></use></svg></span></div>
    <strong><%= grams(_stats.silverWeight) %></strong>
    <p><span data-no-i18n><%= _stats.silverPieces %></span> <span>available pieces</span></p>
  </article>
  <article class="overview-metric metric-sales">
    <div class="metric-heading"><span>Sales today</span><span class="metric-symbol"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#receipt"></use></svg></span></div>
    <strong><%= money(_stats.sales) %></strong>
    <p><span data-no-i18n><%= _stats.invoices %></span> <span>Invoices</span></p>
  </article>
  <article class="overview-metric metric-cash">
    <div class="metric-heading"><span>Cash flow today</span><span class="metric-symbol"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#wallet"></use></svg></span></div>
    <strong class="<%= _stats.cashNet >= 0 ? 'success-text' : 'danger-text' %>"><%= money(_stats.cashNet) %></strong>
    <p><span>In</span> <%= money(_stats.cashIn) %> · <span>Out</span> <%= money(_stats.cashOut) %></p>
  </article>
  <article class="overview-metric metric-receivables">
    <div class="metric-heading"><span>Customer receivables</span><span class="metric-symbol"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#people"></use></svg></span></div>
    <strong><%= money(_stats.customerDue) %></strong>
    <p><a class="metric-link" href="/reports/balance-register">Open balance register →</a></p>
  </article>
</section>

<div class="overview-grid">
  <section class="panel overview-invoices">
    <div class="panel-heading"><h2>Recent invoices</h2><a class="text-link" href="/sales">View all →</a></div>
    <% if (_recentSales.length) { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th class="right">Total amount</th><th><span class="sr-only">Action</span></th></tr></thead>
      <tbody>
        <% _recentSales.forEach(sale => { %>
        <tr>
          <td><a class="invoice-reference" href="/sales/<%= sale.id %>"><%= sale.invoiceNumber %></a></td>
          <td><strong><%= sale.customer?.name || 'Walk-in customer' %></strong><% if (sale.customer?.phone) { %><small><%= sale.customer.phone %></small><% } %></td>
          <td><%= sale.saleDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
          <td class="right"><strong><%= money(sale.total) %></strong></td>
          <td><a class="icon-button" href="/sales/<%= sale.id %>" aria-label="View invoice <%= sale.invoiceNumber %>"><svg class="ui-icon" aria-hidden="true"><use href="/ui-icons.svg#arrow"></use></svg></a></td>
        </tr>
        <% }); %>
      </tbody>
    </table></div>
    <% } else { %>
      <div class="empty-state"><h3>No invoices recorded yet</h3><p>Create your first bill from the billing desk.</p><a class="button" href="/sales/new">+ New sale</a></div>
    <% } %>
  </section>

  <aside class="overview-side">
    <section class="panel">
      <div class="panel-heading"><h2>Stock by metal</h2><a class="text-link" href="/reports/stock" aria-label="Stock report">↗</a></div>
      <% if (_invByMetal.length) { %>
      <ul class="stock-distribution">
        <% _invByMetal.forEach(row => { %>
        <li><span><span class="metal-dot <%= row.metal.toLowerCase() %>"></span><span data-no-i18n><%= row.metal %></span></span><div><strong><%= grams(row.weight) %></strong><small><%= row.pieces %> <span>pieces</span></small></div></li>
        <% }); %>
      </ul>
      <% } else { %><p class="quiet-empty">No stock available</p><% } %>
    </section>
    <section class="panel">
      <div class="panel-heading"><h2>Top selling item today</h2><a class="text-link" href="/reports/top-selling-items" aria-label="Top selling items">↗</a></div>
      <% if (_topItem) { %>
      <div class="top-item-name" data-no-i18n><%= _topItem.name %></div>
      <small data-no-i18n><%= _topItem.metal %><%= _topItem.purity ? ' · ' + _topItem.purity : '' %></small>
      <div class="top-item-meta"><span><%= _topItem.quantity %> <span>pieces billed</span></span><strong><%= money(_topItem.billed) %></strong></div>
      <% } else { %><p class="quiet-empty">No sales today</p><% } %>
    </section>
  </aside>
</div>

<% if (_itemBreakdown.length) { %>
<section class="panel stock-breakdown-panel">
  <div class="panel-heading"><h2>Item-wise stock</h2><a class="text-link" href="/inventory">Inventory →</a></div>
  <div class="table-wrap"><table>
    <thead><tr><th>Item name</th><th>Category</th><th>Metal</th><th class="right">Available pieces</th><th class="right">Net weight</th></tr></thead>
    <tbody>
      <% _itemBreakdown.forEach(item => { %>
      <tr><td><strong><%= item.name %></strong></td><td><%= item.category %></td><td><span class="metal-dot <%= item.metal.toLowerCase() %>"></span><%= item.metal %></td><td class="right"><%= item.pieces %></td><td class="right"><strong><%= grams(item.weight) %></strong></td></tr>
      <% }); %>
    </tbody>
  </table></div>
</section>
<% } %>
