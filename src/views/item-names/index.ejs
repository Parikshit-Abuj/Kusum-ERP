<header class="page-header">
  <div>
    <p class="eyebrow">Master data</p>
    <h1>Item Names</h1>
  </div>
  <div class="header-actions">
    <a class="button ghost" href="/inventory">Back to inventory</a>
  </div>
</header>

<section class="panel">
  <div class="panel-heading"><div><h2>Add new item name</h2></div></div>
  <div class="item-names-add">
    <form method="post" action="/item-names/add" id="addItemNameForm" style="display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap; width:100%;">
      <label>
        <span>Item name *</span>
        <input name="name" data-uppercase data-item-autocomplete required placeholder="e.g. Gold bridal necklace" autocomplete="off">
      </label>
      <label>
        <span>Category *</span>
        <input name="category" data-uppercase required placeholder="e.g. Necklace, Ring, Chain">
      </label>
      <button class="button small" type="submit">+ Add</button>
    </form>
  </div>
</section>

<% const allItems = typeof items !== 'undefined' && Array.isArray(items) ? items : []; const pager = typeof pagination !== 'undefined' && pagination ? pagination : { totalItems: allItems.length }; %>
<section class="panel">
  <div class="panel-heading"><div><h2>All item names</h2><p><%= pager.totalItems %> registered name<%= pager.totalItems !== 1 ? 's' : '' %>.</p></div></div>
  <form class="search-bar" method="get" action="/item-names">
    <input name="q" data-item-autocomplete data-item-autocomplete-mode="search" value="<%= q %>" placeholder="Search item name or category" autocomplete="off">
    <button class="button secondary small" type="submit">Search</button>
    <% if (q) { %><a class="button ghost small" href="/item-names">Clear</a><% } %>
  </form>
  <% if (allItems.length) { %>
    <% allItems.forEach((item) => { %>
    <form class="item-name-row" method="post" action="/item-names/<%= item.id %>">
      <input name="name" value="<%= item.name %>" data-uppercase data-item-autocomplete required placeholder="Item name" autocomplete="off">
      <input name="category" value="<%= item.category %>" data-uppercase required placeholder="Category">
      <button class="button small ghost" type="submit">Save</button>
      <button class="button small ghost" type="submit" formaction="/item-names/<%= item.id %>/delete" onclick="return confirm('Delete this item name?')">✕</button>
    </form>
    <% }) %>
    <%- include('../_pagination', { pagination }) %>
  <% } else { %>
    <div class="empty-state compact"><span>⊞</span><h3>No item names yet</h3><p>Add your first item name above, or they'll be auto-registered when you save inventory items.</p></div>
  <% } %>
</section>
