<% const payoutMethod = loan.cashbookEntries?.[0]?.paymentMethod || 'CASH'; const pledgePhoneDigits = String(loan.customer?.phone || '').replace(/\D/g, ''); const pledgeWaText = encodeURIComponent(`Namaste ${loan.customer?.name || 'Customer'},\n\nYour pledge loan ${loan.pledgeNumber} has been recorded. Please contact us for any repayment or release questions.`); %>
<header class="page-header">
  <div><p class="eyebrow">Customer collateral</p><h1><%= loan.pledgeNumber %></h1><p class="muted"><a href="/customers/<%= loan.customer.id %>"><%= loan.customer.name %></a> · pledged <%= formatDateDisplay(loan.pledgeDate) %></p></div>
  <div class="header-actions"><a class="button ghost" href="/pledges">All pledge loans</a><a class="button ghost" href="/pledges/<%= loan.id %>/invoice.pdf" target="_blank" rel="noopener">PDF receipt</a><% if (pledgePhoneDigits.length >= 10) { %><a class="button whatsapp-btn" href="whatsapp://send?phone=91<%= pledgePhoneDigits.slice(-10) %>&text=<%= pledgeWaText %>" title="Open WhatsApp Desktop chat">WhatsApp</a><% } %><% if (loan.status === 'ACTIVE') { %><button class="button ghost" type="button" data-pledge-edit-open>Edit details</button><button class="button" type="button" data-pledge-payment-open>+ Record repayment</button><% } %></div>
</header>

<section class="cashbook-summary" aria-label="Pledge balance">
  <article class="stat-card"><span class="stat-label">Money lent</span><strong><%- money(loan.principalAmount) %></strong></article>
  <article class="stat-card"><span class="stat-label">Principal repaid</span><strong class="stat-positive"><%- money(loan.principalRepaid) %></strong></article>
  <article class="stat-card accent-gold"><span class="stat-label">Principal due</span><strong class="<%= outstanding > 0 ? 'credit-amount' : 'paid-amount' %>"><%- money(outstanding) %></strong></article>
  <article class="stat-card"><span class="stat-label">Interest received</span><strong><%- money(loan.interestReceived) %></strong></article>
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>Jewellery held</h2><p><%= loan.status === 'ACTIVE' ? 'Keep this item securely held until the principal is fully repaid.' : loan.status === 'RELEASED' ? `Released ${formatDateDisplay(loan.releasedAt)}.` : `Cancelled ${formatDateDisplay(loan.cancelledAt)}.` %></p></div><span class="pill <%= loan.status === 'ACTIVE' ? 'warning' : loan.status === 'RELEASED' ? 'success' : 'danger' %>"><%= loan.status === 'ACTIVE' ? 'Held' : loan.status === 'RELEASED' ? 'Released' : 'Cancelled' %></span></div>
  <div class="detail-grid"><div><small>ITEM</small><strong><%= loan.itemDescription %></strong></div><div><small>METAL / PURITY</small><strong><%= loan.metal %><%= loan.purity ? ` · ${loan.purity}` : '' %></strong></div><div><small>WEIGHT</small><strong><%= Number(loan.netWeight).toFixed(3) %> g</strong><span>Gross <%= Number(loan.grossWeight).toFixed(3) %> g · Stone <%= Number(loan.stoneWeight).toFixed(3) %> g</span></div><div><small>PIECES</small><strong><%= loan.quantity %></strong></div><div><small>VALUATION</small><strong><%- money(loan.valuationAmount) %></strong></div><div><small>RETURN DUE</small><strong><%= loan.dueDate ? formatDateDisplay(loan.dueDate) : 'Not set' %></strong></div><div><small>MONTHLY INTEREST</small><strong><%= Number(loan.monthlyInterestRate).toFixed(2) %>%</strong></div></div>
  <% if (loan.notes) { %><p class="muted" style="margin:16px 0 0"><%= loan.notes %></p><% } %>
  <% if (loan.status === 'ACTIVE') { %><footer class="form-footer"><% if (outstanding <= 0) { %><form method="post" action="/pledges/<%= loan.id %>/release" onsubmit="return confirm('Confirm that the jewellery is being returned to <%= loan.customer.name.replace(/'/g, "\\'") %>?')"><button class="button" type="submit">Release jewellery</button></form><% } else { %><span class="muted">Record the remaining principal before releasing the jewellery.</span><% } %><form method="post" action="/pledges/<%= loan.id %>/cancel" onsubmit="return confirm('Cancel this pledge entry? This is only for a wrongly entered loan with no repayments. Its payout will be removed from Cashbook.')"><button class="button ghost danger-action" type="submit">Cancel wrong entry</button></form></footer><% } %>
</section>

<section class="panel register-panel" style="margin-top:20px"><div class="panel-heading"><div><h2>Repayment history</h2><p>Each repayment is a Cashbook money-in entry. Use Edit to correct a date, method or amount.</p></div></div>
  <% if (loan.payments.length) { %><div class="table-wrap"><table><thead><tr><th>Date</th><th>Method</th><th class="right">Principal</th><th class="right">Interest</th><th class="right">Received</th><th>Note</th><th></th></tr></thead><tbody><% loan.payments.forEach((payment) => { const received = Number(payment.principalAmount) + Number(payment.interestAmount); %><tr><td><%= formatDateDisplay(payment.paymentDate) %></td><td><span class="pill neutral"><%= payment.paymentMethod.replace('_', ' ') %></span></td><td class="right"><%- money(payment.principalAmount) %></td><td class="right"><%- money(payment.interestAmount) %></td><td class="right"><strong class="paid-amount"><%- money(received) %></strong></td><td><%= payment.notes || '—' %></td><td class="actions"><% if (loan.status === 'ACTIVE') { %><button class="button ghost small" type="button" data-pledge-payment-edit-open="pledgePaymentEdit<%= payment.id %>">Edit</button><form method="post" action="/pledges/<%= loan.id %>/payments/<%= payment.id %>/delete" style="display:inline" onsubmit="return confirm('Remove this repayment and recalculate the pledge balance?')"><button class="button ghost small danger-action" type="submit">Delete</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('../_pagination', { pagination }) %><% } else { %><div class="empty-state compact"><span>₹</span><h3>No repayment recorded</h3><p>Use Record repayment when the customer pays principal or interest.</p></div><% } %>
</section>

<% if (loan.status === 'ACTIVE') { %>
<div class="modal-overlay" id="pledgeEditModal" style="display:none" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="pledgeEditTitle"><section class="modal-card" role="document"><header class="modal-header"><div><p class="eyebrow">Correct pledge</p><h2 id="pledgeEditTitle"><%= loan.pledgeNumber %></h2></div><button class="modal-close-btn" type="button" data-pledge-edit-close aria-label="Close">×</button></header><form method="post" action="/pledges/<%= loan.id %>" data-enter-scope><div class="modal-body"><div class="form-grid four"><label>Pledge date *<input name="pledgeDate" type="date" value="<%= dateInput(loan.pledgeDate) %>" required></label><label>Return due date<input name="dueDate" type="date" value="<%= loan.dueDate ? dateInput(loan.dueDate) : '' %>"></label><label>Metal *<select name="metal"><option value="GOLD" <%= loan.metal === 'GOLD' ? 'selected' : '' %>>Gold</option><option value="SILVER" <%= loan.metal === 'SILVER' ? 'selected' : '' %>>Silver</option></select></label><label>Item description *<input name="itemDescription" value="<%= loan.itemDescription %>" data-title-case data-item-autocomplete required></label><label>Purity<input name="purity" value="<%= loan.purity || '' %>"></label><label>Pieces *<input name="quantity" type="number" min="1" step="1" value="<%= loan.quantity %>" required></label><label>Gross wt. (g)<input name="grossWeight" type="number" min="0" step="0.001" value="<%= Number(loan.grossWeight).toFixed(3) %>"></label><label>Stone wt. (g)<input name="stoneWeight" type="number" min="0" step="0.001" value="<%= Number(loan.stoneWeight).toFixed(3) %>"></label><label>Net wt. (g) *<input name="netWeight" type="number" min="0.001" step="0.001" value="<%= Number(loan.netWeight).toFixed(3) %>" required></label><label>Valuation (₹)<input name="valuationAmount" type="number" min="0" step="0.01" value="<%= Number(loan.valuationAmount).toFixed(2) %>"></label><label>Money lent *<input name="principalAmount" type="number" min="<%= Number(loan.principalRepaid).toFixed(2) %>" step="0.01" value="<%= Number(loan.principalAmount).toFixed(2) %>" required></label><label>Monthly interest (%)<input name="monthlyInterestRate" type="number" min="0" max="99.99" step="0.01" value="<%= Number(loan.monthlyInterestRate).toFixed(2) %>"></label><label>Money given by *<select name="payoutMethod"><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach((method) => { %><option value="<%= method %>" <%= payoutMethod === method ? 'selected' : '' %>><%= method.replace('_', ' ') %></option><% }) %></select></label><label class="field-span-all">Notes<textarea name="notes" rows="2"><%= loan.notes || '' %></textarea></label></div></div><footer class="modal-footer"><button class="button ghost" type="button" data-pledge-edit-close>Cancel</button><button class="button" type="submit">Save corrections</button></footer></form></section></div>
<div class="modal-overlay" id="pledgePaymentModal" style="display:none" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="pledgePaymentTitle"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Pledge repayment</p><h2 id="pledgePaymentTitle">Record repayment</h2><p class="muted">Principal due: <%- money(outstanding) %></p></div><button class="modal-close-btn" type="button" data-pledge-payment-close aria-label="Close">×</button></header><form method="post" action="/pledges/<%= loan.id %>/payments" data-enter-scope><div class="modal-body payment-editor-fields"><label>Principal amount<input name="principalAmount" type="number" min="0" max="<%= outstanding.toFixed(2) %>" step="0.01" value="<%= outstanding.toFixed(2) %>"></label><label>Interest amount<input name="interestAmount" type="number" min="0" step="0.01" value="0"></label><label>Payment method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Payment date<input name="paymentDate" type="date" value="<%= dateInput() %>" required></label><label class="field-span-all">Note<input name="notes" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-pledge-payment-close>Cancel</button><button class="button" type="submit">Record repayment</button></footer></form></section></div>

<% loan.payments.forEach((payment) => { %><div class="modal-overlay" id="pledgePaymentEdit<%= payment.id %>" style="display:none" aria-hidden="true" role="dialog" aria-modal="true"><section class="modal-card purchase-edit-payment-modal"><header class="modal-header"><div><p class="eyebrow">Correct repayment</p><h2><%= loan.pledgeNumber %></h2></div><button class="modal-close-btn" type="button" data-pledge-payment-edit-close aria-label="Close">×</button></header><form method="post" action="/pledges/<%= loan.id %>/payments/<%= payment.id %>" data-enter-scope><div class="modal-body payment-editor-fields"><label>Principal amount<input name="principalAmount" type="number" min="0" step="0.01" value="<%= Number(payment.principalAmount).toFixed(2) %>"></label><label>Interest amount<input name="interestAmount" type="number" min="0" step="0.01" value="<%= Number(payment.interestAmount).toFixed(2) %>"></label><label>Payment method<select name="paymentMethod"><% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach((method) => { %><option value="<%= method %>" <%= payment.paymentMethod === method ? 'selected' : '' %>><%= method.replace('_', ' ') %></option><% }) %></select></label><label>Payment date<input name="paymentDate" type="date" value="<%= payment.paymentDate %>" required></label><label class="field-span-all">Note<input name="notes" value="<%= payment.notes || '' %>" placeholder="Optional"></label></div><footer class="modal-footer"><button class="button ghost" type="button" data-pledge-payment-edit-close>Cancel</button><button class="button" type="submit">Save correction</button></footer></form></section></div><% }) %>
<% } %>

<script>
(() => {
  const editModal = document.getElementById('pledgeEditModal'); const openEdit = document.querySelector('[data-pledge-edit-open]');
  const closeEdit = () => { if (!editModal) return; editModal.style.display = 'none'; editModal.setAttribute('aria-hidden', 'true'); openEdit?.focus(); };
  openEdit?.addEventListener('click', () => { editModal.style.display = 'flex'; editModal.setAttribute('aria-hidden', 'false'); setTimeout(() => editModal.querySelector('input[name=itemDescription]')?.focus(), 0); });
  editModal?.querySelectorAll('[data-pledge-edit-close]').forEach((button) => button.addEventListener('click', closeEdit));
  editModal?.addEventListener('click', (event) => { if (event.target === editModal) closeEdit(); });
  const paymentModal = document.getElementById('pledgePaymentModal'); const openPayment = document.querySelector('[data-pledge-payment-open]');
  const closePayment = () => { if (!paymentModal) return; paymentModal.style.display = 'none'; paymentModal.setAttribute('aria-hidden', 'true'); openPayment?.focus(); };
  openPayment?.addEventListener('click', () => { paymentModal.style.display = 'flex'; paymentModal.setAttribute('aria-hidden', 'false'); setTimeout(() => paymentModal.querySelector('input[name=principalAmount]')?.focus(), 0); });
  paymentModal?.querySelectorAll('[data-pledge-payment-close]').forEach((button) => button.addEventListener('click', closePayment));
  paymentModal?.addEventListener('click', (event) => { if (event.target === paymentModal) closePayment(); });
  document.querySelectorAll('[data-pledge-payment-edit-open]').forEach((button) => { const modal = document.getElementById(button.dataset.pledgePaymentEditOpen); if (!modal) return; const close = () => { modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); button.focus(); }; button.addEventListener('click', () => { modal.style.display = 'flex'; modal.setAttribute('aria-hidden', 'false'); }); modal.querySelectorAll('[data-pledge-payment-edit-close]').forEach((closeButton) => closeButton.addEventListener('click', close)); modal.addEventListener('click', (event) => { if (event.target === modal) close(); }); });
  document.addEventListener('keydown', (event) => { if (event.key !== 'Escape') return; if (editModal?.style.display === 'flex') closeEdit(); if (paymentModal?.style.display === 'flex') closePayment(); document.querySelectorAll('[id^=pledgePaymentEdit]').forEach((modal) => { if (modal.style.display === 'flex') { modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); } }); });
})();
</script>
