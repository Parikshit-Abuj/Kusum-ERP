  .sale-detail-summary { width: fit-content; max-width: 100%; }
  .sale-detail-summary:not(.has-details) { padding: 0; border-color: transparent; background: transparent; }
  .sale-detail-summary.has-details { width: 100%; }
  .sale-customer-field { align-content: center; }
  .sale-customer-field .sale-detail-summary { justify-self: end; }
  .sale-detail-summary-copy { display: grid; min-width: 0; gap: 1px; }
  .sale-detail-summary-copy > span { color: #7a6d5e; font-size: 9px; font-weight: 800; letter-spacing: .045em; text-transform: uppercase; }
  .sale-detail-summary-copy strong,
  .sale-detail-summary-copy small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sale-detail-summary-copy strong { color: #2b2319; font-size: 12px; }
  .sale-detail-summary-copy small { color: #756f69; font-size: 10px; }
  .sale-detail-summary .button { flex-shrink: 0; }
  .sale-customer-modal,
  .sale-urd-modal,
  .sale-split-payment-modal { z-index: 10012; }
  .sale-customer-modal-card,
  .sale-urd-modal-card { width: min(760px, calc(100vw - 32px)); max-width: 760px !important; }
  .sale-split-payment-modal-card { width: min(520px, calc(100vw - 32px)); max-width: 520px !important; }
  .sale-customer-modal-body,
  .sale-urd-modal-body,
  .sale-split-payment-modal-body { max-height: min(72vh, 660px); overflow-y: auto; padding: 20px 24px !important; }
  .whatsapp-optin-row { margin: 0 0 8px; padding: 10px 12px; border: 1px solid #eadfca; border-radius: 10px; background: #fffaf0; color: #5f513f; font-size: 11px; font-weight: 750; }
  .whatsapp-optin-row span { display: block; }
  .sale-split-payment-modal-body > p { margin: 0 0 16px; }
  .split-payment-edit { align-self: flex-start; margin-top: 8px; }
  .split-payment-summary { display: block; margin-top: 6px; color: var(--muted); font-size: 11px; }
  .split-payment-modal-total { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 16px; padding: 12px 14px; border: 1px solid #eadfca; border-radius: 9px; background: #fffaf0; }
  .split-payment-modal-total span { color: var(--muted); font-size: 12px; font-weight: 700; }
  .split-payment-modal-total strong { color: var(--ink); font-size: 17px; }
  .sale-customer-modal-top { grid-template-columns: minmax(0, 1fr); margin-bottom: 12px; }
  .sale-customer-modal-body .customer-lookup { margin-top: 12px; }
  .sale-customer-modal-body .cust-status-badge { margin-bottom: 10px; }
  .sale-urd-modal-body .urd-settlement-fields { margin-top: 12px; }
  .sale-customer-modal .modal-header,
  .sale-urd-modal .modal-header,
  .sale-split-payment-modal .modal-header { padding: 17px 24px; }
  .sale-customer-modal .modal-header h2,
  .sale-urd-modal .modal-header h2,
  .sale-split-payment-modal .modal-header h2 { margin-bottom: 0; }
  .sale-customer-modal .sale-line-editor-footer,
  .sale-urd-modal .sale-line-editor-footer,
  .sale-split-payment-modal .sale-line-editor-footer { padding: 14px 24px; }
  .sale-urd-modal [data-sale-urd-remove] { margin-right: auto; color: #a13d32; }
  .urd-settlement { margin-top: 12px; padding: 7px 9px; }
  .urd-settlement:not(.has-details) { display: flex; justify-content: flex-end; padding: 0; border-color: transparent; background: transparent; }
  .urd-settlement:not(.has-details) .sale-detail-summary { background: transparent; border-color: transparent; }
  .urd-settlement.has-details .sale-detail-summary { width: 100%; }
  .transaction-main #invoice-customer .pos-grid-3 {
    grid-template-columns: minmax(220px, .95fr) 210px minmax(250px, 1.1fr);
    align-items: end;
  }
  .transaction-layout.barcode-sale[data-edit-sale="false"] #invoice-customer .pos-grid-3 {
    grid-template-columns: 190px minmax(0, 460px);
    justify-content: start;
  }
  .transaction-layout.barcode-sale[data-edit-sale="false"] #invoice-customer .sale-customer-field { max-width: 460px; }
  .sale-invoice-number-field input { max-width: 240px; }
  .sale-billing-date-field input { max-width: 190px; }
  .billing-wayfinder {
    justify-content: flex-start;
    gap: 2px !important;
    margin-bottom: 10px !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }
  .billing-wayfinder a { flex: 0 0 auto !important; padding: 2px 7px !important; gap: 6px !important; color: #746b61 !important; }
  .billing-wayfinder a:hover { background: #fff9ed !important; color: #8a5b15 !important; }
  .billing-wayfinder b { width: 20px !important; height: 20px !important; border-radius: 6px !important; }
  .billing-wayfinder a:not(:last-child)::after { content: '›'; margin-left: 6px; color: #b8ab9a; font-size: 15px; }
  .erp-ui:has(.billing-wrapper) .workspace-toolbar { min-height: 50px; margin-bottom: 12px; padding-top: 7px; padding-bottom: 7px; }
  .erp-ui:has(.billing-wrapper) .billing-wrapper { gap: 10px; }
  .erp-ui:has(.billing-wrapper) .billing-header-strip { padding-top: 8px; padding-bottom: 8px; }

  @media (max-width: 1100px) {
    .transaction-summary { max-height: none; position: static; }
  }

  @media (max-width: 800px) {
    .billing-header-strip { align-items: flex-start; }
    .barcode-cart { max-height: 360px; }
  }
  @media (max-width: 720px) {
    .transaction-main #invoice-customer .pos-grid-3 { grid-template-columns: 1fr; }
    .transaction-layout.barcode-sale[data-edit-sale="false"] #invoice-customer .pos-grid-3 { grid-template-columns: 1fr; }
    .sale-billing-date-field input { max-width: none; }
    .sale-invoice-number-field input { max-width: none; }
    .sale-customer-modal-body,
    .sale-urd-modal-body,
    .sale-split-payment-modal-body { padding: 16px !important; }
    .sale-detail-summary { align-items: flex-start; flex-direction: column; }
    .sale-detail-summary .button { width: 100%; }
    .sale-customer-modal .modal-header,
    .sale-urd-modal .modal-header,
    .sale-split-payment-modal .modal-header,
    .sale-customer-modal .sale-line-editor-footer,
    .sale-urd-modal .sale-line-editor-footer,
    .sale-split-payment-modal .sale-line-editor-footer { padding-left: 16px; padding-right: 16px; }
  }

  /* ── Static invoice cart and item editor ──────────────────── */
  .sale-cart-columns,
  .sale-cart-row {
    display: grid;
    grid-template-columns: 24px minmax(110px, 1.8fr) 48px 68px minmax(72px, 0.9fr) minmax(58px, 0.8fr) minmax(80px, 1fr) 58px;
    align-items: center;
    column-gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }
  .sale-cart-columns {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 4px 10px 7px;
    border-bottom: 1px solid #e8e1d5;
    background: #fff;
    color: #7d7265;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .035em;
    text-transform: uppercase;
  }
  .sale-cart-columns > span:last-child {
    position: sticky;
    right: 0;
    background: #fff;
    z-index: 3;
  }
  .barcode-sale .barcode-line { padding: 0 !important; margin-bottom: 7px !important; border: 0 !important; background: transparent !important; box-shadow: none !important; }
  .sale-cart-row {
    min-height: 50px;
    padding: 6px 10px;
    border: 1px solid #e6ddd0;
    border-radius: 8px;
    background: #fff;
    color: #392f25;
    font-size: 12px;
    position: relative;
  }
  .sale-cart-row:hover { border-color: #d7bc83; background: #fffdf9; }
  .sale-cart-row:hover .cart-row-actions { background: #fffdf9; }
  .sale-cart-row .line-number { width: 22px !important; height: 22px !important; font-size: 10px !important; }
  .cart-item-cell { display: flex; min-width: 0; flex-direction: column; gap: 1px; }
  .cart-item-cell strong,
  .cart-item-cell small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cart-item-cell strong { color: #2b2319; font-size: 12.5px; }
  .cart-item-cell small { color: #837665; font-size: 10.5px; }
  .cart-row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    position: sticky;
    right: 0;
    background: #fff;
    z-index: 1;
    padding-left: 4px;
  }
  .cart-row-actions .icon-button { width: 26px; height: 26px; padding: 0; flex-shrink: 0; }
  .sale-line-editor-modal { z-index: 10010; }
  .sale-line-editor-modal-card { max-width: 860px !important; }
  .sale-line-editor-body { padding: 20px 24px !important; }
  .sale-line-editor-body .line-editor { width: 100%; }
  .sale-line-editor-body .line-header-row { margin-bottom: 12px !important; }
  .sale-line-editor-body .barcode-field-wrap { flex-basis: 230px !important; }
  .sale-line-editor-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 24px; border-top: 1px solid #e7dfd4; background: #faf8f5; }
  @media (max-width: 720px) {
    .sale-line-editor-body,
    .sale-line-editor-footer { padding: 16px !important; }
    .sale-line-editor-footer { flex-direction: column-reverse; }
    .sale-line-editor-footer .button { width: 100%; }
    .sale-line-editor-body .line-specs-grid { grid-template-columns: 1fr; }
  }

  /* Keep the billing title compact so the shared textile remains visible. */
  .erp-ui .billing-header-strip {
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0;
  }
  .erp-ui .billing-title-text h1 {
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    padding: 5px 11px 6px;
    border: 1px solid rgba(224, 207, 181, .95);
    border-radius: 8px;
    background: #ffffff;
    color: #111215;
    box-shadow: 0 4px 14px rgba(53, 29, 18, .14);
  }
  .erp-ui .billing-title-text p {
    color: rgba(255, 255, 255, .9);
    text-shadow: 0 1px 4px rgba(53, 29, 18, .48);
  }
  .erp-ui .billing-wayfinder a,
  .erp-ui .billing-wayfinder a:visited {
    color: #ffffff !important;
    text-shadow: 0 1px 4px rgba(53, 29, 18, .48);
  }
  .erp-ui .billing-wayfinder a:hover {
    color: #ffffff !important;
    background: rgba(255, 255, 255, .14) !important;
  }
</style>

<div class="billing-wrapper">
  <!-- Top Bar & Live Rates -->
  <header class="billing-header-strip no-print">
    <div class="billing-title-area">
      <div class="billing-badge-icon">KJ</div>
      <div class="billing-title-text">
        <h1><%= editingSale ? `Edit ${editSale.invoiceNumber}` : 'Create Tax Invoice' %></h1>
        <p><%= editingSale ? 'Update invoice details → save revised bill' : 'Customer → scan items → payment' %></p>
      </div>
    </div>

    <div class="billing-rate-pills">
      <% if (!editingSale) { %>
      <button class="button ghost small" type="button" data-save-sale-draft style="border-radius:20px; font-size:11px; padding:3px 8px;">Save draft</button>
      <% } %>
      <% if (!rateInfo.rate) { %>
        <span class="rate-tag" style="border-color:#f5c2c7; background:#fff5f5; color:#842029;">
          Rates not set · <a href="/rates" style="color:#842029; font-weight:750;">Set Daily Rates →</a>
        </span>
      <% } else { %>
        <span class="rate-tag">
          22K Gold: <strong><%- money(rateInfo.rate.gold22k) %>/g</strong>
        </span>
        <span class="rate-tag">
          24K Gold: <strong><%- money(rateInfo.rate.gold24k) %>/g</strong>
        </span>
        <span class="rate-tag">
          Silver: <strong><%- money(rateInfo.rate.silver) %>/g</strong>
        </span>
        <a class="button ghost small" href="/rates" style="border-radius:20px; font-size:11px; padding:3px 8px;">Update →</a>
      <% } %>
      <a class="button ghost small" href="<%= editingSale ? `/sales/${editSale.id}` : '/sales' %>" data-discard-sale-draft style="border-radius:20px; font-size:11px; padding:3px 8px;">Cancel</a>
    </div>
  </header>

  <!-- POS Form -->
  <nav class="billing-wayfinder" aria-label="Invoice sections">
    <a href="#invoice-customer"><b>1</b> Customer</a>
    <a href="#invoice-items"><b>2</b> Items</a>
    <a href="#invoice-payment"><b>3</b> Payment</a>
  </nav>
  <form class="transaction-layout barcode-sale" method="post" action="<%= editingSale ? `/sales/${editSale.id}/edit` : '/sales' %>" data-barcode-sale data-edit-sale="<%= editingSale ? 'true' : 'false' %>" data-default-hsn="<%= businessSettings?.defaultHsnCode || '' %>" data-gst-rate="<%= editingSale ? Number(editSale.gstRate) : Number(businessSettings?.defaultGstRate ?? 3) %>" novalidate>

    <!-- Left Main Area -->
    <section class="transaction-main">
      <!-- 1. Customer & Invoice Details -->
      <div class="pos-card" id="invoice-customer">
        <div class="pos-card-header">
          <h2 class="pos-card-title">Customer</h2>
        </div>

        <div class="pos-grid-3">
          <div class="pos-field sale-invoice-number-field" <%= editingSale ? '' : 'hidden' %>>
            <label>Invoice Number</label>
            <input name="invoiceNumber" readonly value="<%= typeof invoiceNumber !== 'undefined' ? invoiceNumber : '' %>" placeholder="Assigned when saved" style="font-family:'Courier New',monospace; font-weight:750; background:#fbf9f5;">
          </div>
          <div class="pos-field sale-billing-date-field">
            <label>Billing Date</label>
            <input name="saleDate" type="date" value="<%= editingSale ? editSale.saleDate : dateInput() %>" data-sale-date required>
          </div>
          <div class="pos-field sale-customer-field">
            <div class="sale-detail-summary" data-sale-customer-summary>
              <div class="sale-detail-summary-copy" data-sale-customer-summary-content <%= (!editingSale || !editSale.customer) ? 'hidden' : '' %>>
                <span>Selected customer</span>
                <strong data-sale-customer-summary-name><%= editingSale ? (editSale.customer?.name || 'Customer') : '' %></strong>
                <small data-sale-customer-summary-details><%= editingSale ? [editSale.customer?.phone, editSale.customer?.email].filter(Boolean).join(' · ') : '' %></small>
              </div>
              <button class="button ghost small" type="button" data-sale-customer-open><%= editingSale ? 'Edit customer' : '+ Add customer' %></button>
            </div>
          </div>
        </div>

      </div>

      <!-- 2. Scanned Jewellery Items -->
      <div class="pos-card" id="invoice-items">
        <div class="pos-card-header">
          <div class="item-card-heading"><h2 class="pos-card-title">Items</h2><span class="item-count" data-item-count>0 items</span></div>
          <button class="button small" type="button" data-add-row style="background:#f0ebe0; color:#5a4933; border:1px solid #dcd1c2; font-weight:750; padding:4px 10px; font-size:12px;">
            + Add barcode
          </button>
        </div>

        <!-- Dynamic Barcode rows injected here by JS -->
        <div class="barcode-cart">
          <div class="sale-cart-columns" aria-hidden="true"><span>#</span><span>Barcode / item</span><span>Purity</span><span>Weight</span><span>Rate</span><span>Making</span><span>Amount</span><span></span></div>
          <div class="barcode-lines" data-rows></div>
        </div>

        <!-- 3. URD Buyback / Old Gold Exchange Settlement -->
        <section class="urd-settlement" data-sale-urd>
          <div class="sale-detail-summary <%= (editingSale && editSale.urd) ? 'has-details' : '' %>" data-sale-urd-summary>
            <div class="sale-detail-summary-copy" data-sale-urd-summary-content <%= (!editingSale || !editSale.urd) ? 'hidden' : '' %>>
              <span>URD adjustment</span>
              <strong data-sale-urd-summary-name><%= (editingSale && editSale.urd) ? `${editSale.urd.metal || 'Metal'} buyback` : '' %></strong>
              <small data-sale-urd-summary-details><%= (editingSale && editSale.urd) ? `${Number(editSale.urd.netWeight || 0).toFixed(3)} g · ${money(editSale.urd.totalAmount || 0)}` : '' %></small>
            </div>
            <button class="button ghost small" type="button" data-sale-urd-open><%= (editingSale && editSale.urd) ? 'Edit URD' : '+ Add URD' %></button>
          </div>
        </section>

        <!-- Hidden Line Item Template (Cloned by JS) -->
        <template data-line-template>
          <div class="barcode-line" data-line-item>
            <div class="sale-cart-row" data-line-summary>
              <span class="line-number">1</span>
              <span class="cart-item-cell"><strong data-line-summary-name>Pending barcode</strong><small data-line-summary-meta>Scan item to load details</small></span>
              <span data-line-summary-purity>—</span>
              <span data-line-summary-weight>—</span>
              <span data-line-summary-rate>—</span>
              <span data-line-summary-making>—</span>
              <strong data-line-summary-amount>₹0.00</strong>
              <span class="cart-row-actions"><button class="icon-button" type="button" title="Edit item" data-edit-row>✎</button><button class="icon-button delete-icon" type="button" title="Remove item" data-remove-summary>✕</button></span>
            </div>

            <div data-line-editor-slot hidden>
              <div class="line-editor" data-line-editor data-enter-scope data-enter-next="[data-line-editor-done]">
                <div class="line-header-row">
                  <div class="barcode-field-wrap">
                    <label>Scan / Type Barcode</label>
                  <input name="barcode" autocomplete="off" placeholder="e.g. G 1 or S A" data-barcode>
                  </div>
                  <input type="hidden" name="productId" data-product-id>
                  <input type="hidden" name="saleItemId" data-sale-item-id>
                  <div class="scanned-item" data-item-details>
                    <strong>Waiting for barcode…</strong>
                    <small>Item details will appear automatically</small>
                  </div>
                </div>

                <p class="line-section-label">Pricing</p>
                <div class="line-fields-grid">
                  <div class="input-unit"><label>Net Wt (g) *</label><input name="weight" type="number" min="0.001" step="0.001" data-weight placeholder="0.000"></div>
                  <div class="input-unit"><label>Rate / g (₹) *</label><input name="metalRate" type="number" min="0" step="0.01" data-metal-rate placeholder="0.00"></div>
                  <div class="input-unit"><label>Making Type</label><select name="makingChargeType" data-making-type><option value="PER_GRAM" selected>Per gram</option><option value="FIXED">Fixed</option><option value="PERCENTAGE">%</option></select></div>
                  <div class="input-unit"><label>Making (₹)</label><input name="makingChargeValue" type="number" min="0" step="0.01" data-making-value placeholder="0.00"></div>
                  <div class="input-unit"><label>Amount ex. GST (₹)</label><input name="taxableAmount" type="number" min="0" step="0.01" data-taxable-amount placeholder="0.00"></div>
                </div>

                <div class="line-extra-details">
                  <p class="line-section-label">Item details</p>
                  <div class="line-specs-grid">
                    <input name="quantity" type="hidden" value="1" data-quantity>
                    <div class="input-unit"><label>Purity</label><input name="purity" maxlength="30" data-purity placeholder="22K"></div>
                    <div class="input-unit"><label>HSN</label><input name="hsnCode" placeholder="7113" data-hsn-code autocomplete="off"></div>
                    <div class="input-unit"><label>HUID</label><input name="huidCode" placeholder="ABC123" data-huid-code autocomplete="off" style="text-transform: uppercase;"></div>
                  </div>
                </div>
                <small class="line-help" data-line-help></small>
              </div>
            </div>
          </div>
        </template>

        <details class="billing-optional" open>
          <summary>Invoice notes / reference</summary>
          <textarea name="notes" data-uppercase rows="2" placeholder="Bargaining note, hallmark reference, etc." style="width:100%; border:1.5px solid #ded5c5; border-radius:8px; padding:8px 10px; font-family:inherit; box-sizing:border-box;"><%= (editingSale && editSale.notes) || '' %></textarea>
        </details>
      </div>
    </section>

    <!-- Right Sidebar: Payment Summary -->
    <aside class="transaction-summary" id="invoice-payment">
      <h2 class="summary-heading">Payment Summary</h2>

      <div class="summary-row">
        <span>Items Subtotal</span>
        <strong data-subtotal>₹0.00</strong>
      </div>

      <div class="summary-input-wrap">
        <label>Discount / Concession (₹)</label>
        <input name="discount" type="number" min="0" step="0.01" placeholder="0.00" data-discount value="<%= editingSale ? editSale.discount : '' %>">
      </div>

      <div class="summary-row">
        <span>GST (<%= editingSale ? Number(editSale.gstRate) : Number(businessSettings?.defaultGstRate ?? 3) %>%)</span>
        <strong data-gst>₹0.00</strong>
      </div>

      <div class="summary-row">
        <span>Round Off</span>
        <strong data-round-off>₹0.00</strong>
      </div>

      <input name="gstRate" type="hidden" value="<%= editingSale ? Number(editSale.gstRate) : Number(businessSettings?.defaultGstRate ?? 3) %>">

      <div class="summary-total-box">
        <span>Invoice Total</span>
        <strong data-total>₹0.00</strong>
      </div>

      <div class="summary-row" data-urd-offset-row hidden style="color:#b47a21;">
        <span>URD Buyback</span>
        <strong>− <span data-urd-offset>₹0.00</span></strong>
      </div>

      <div class="net-payable-box">
        <span data-net-payable-label>Net Payable</span>
        <strong data-net-payable>₹0.00</strong>
      </div>

      <div class="summary-input-wrap" data-urd-refund-method hidden>
        <label>Refund Method</label>
        <select name="urdRefundMethod" data-urd-refund-method disabled>
          <option value="CASH" <%= (editingSale && editSale.urd?.paymentMethod === 'CASH') ? 'selected' : '' %>>Cash</option>
          <option value="UPI" <%= (editingSale && editSale.urd?.paymentMethod === 'UPI') ? 'selected' : '' %>>UPI / QR</option>
          <option value="CARD" <%= (editingSale && editSale.urd?.paymentMethod === 'CARD') ? 'selected' : '' %>>Card</option>
          <option value="BANK_TRANSFER" <%= (editingSale && editSale.urd?.paymentMethod === 'BANK_TRANSFER') ? 'selected' : '' %>>Bank Transfer</option>
        </select>
      </div>

      <div class="summary-input-wrap" data-paid-wrap>
        <label>Amount Received Now (₹)</label>
        <input name="paid" type="number" min="0" step="0.01" placeholder="0.00" data-paid value="<%= (editingSale && editSale.initialPayment?.paid !== undefined) ? editSale.initialPayment.paid : '' %>" style="font-size:14.5px; border-color:#c9a044;">
      </div>

      <div class="due-pill" data-balance-row>
        <span>Credit Due Balance</span>
        <strong data-balance>₹0.00</strong>
      </div>

      <div class="summary-input-wrap" data-payment-method-wrap>
        <label>Payment Method</label>
        <select name="paymentMethod" data-payment-method>
          <% ['CASH','UPI','CARD','BANK_TRANSFER','CREDIT','MIXED'].forEach((method) => { %>
          <option value="<%= method %>" <%= editingSale && editSale.initialPayment?.paymentMethod === method ? 'selected' : '' %>><%= method === 'CASH' ? 'Cash' : (method === 'UPI' ? 'UPI / QR' : (method === 'CARD' ? 'Card' : (method === 'BANK_TRANSFER' ? 'Bank Transfer' : (method === 'CREDIT' ? 'Credit (Pay Later)' : 'Mixed Split Payment')))) %></option>
          <% }) %>
        </select>
        <button type="button" class="button ghost small split-payment-edit" data-split-payment-open hidden aria-controls="saleSplitPaymentModal">Enter split amounts</button>
        <small class="split-payment-summary" data-split-payment-summary hidden></small>
      </div>

      <div class="sale-submit-actions">
        <button class="button ghost" type="button" data-sale-review-open>Review invoice</button>
        <button class="btn-submit-bill" type="submit">
        <%= editingSale ? 'Save Invoice Changes →' : 'Generate & Print Bill →' %>
        </button>
      </div>
    </aside>

    <div class="modal-overlay sale-customer-modal" id="saleCustomerModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="saleCustomerModalTitle" aria-hidden="true">
      <section class="modal-card sale-customer-modal-card" role="document">
        <header class="modal-header">
          <div><p class="eyebrow">Customer details</p><h2 id="saleCustomerModalTitle">Customer details</h2></div>
          <button class="modal-close-btn" type="button" data-sale-customer-close aria-label="Close customer details">&times;</button>
        </header>
        <div class="modal-body sale-customer-modal-body">
          <div class="pos-grid-3 sale-customer-modal-top">
            <div class="pos-field">
              <label>Customer mobile number</label>
              <input name="customerPhone" inputmode="numeric" autocomplete="tel" maxlength="15" placeholder="Optional mobile number" data-customer-phone value="<%= (editingSale && editSale.customer?.phone) ? editSale.customer.phone : '' %>">
            </div>
            <label class="check-row whatsapp-optin-row"><input name="whatsappOptIn" type="checkbox" <%= editingSale && editSale.customer?.whatsappOptIn ? 'checked' : '' %>><span>Customer opted in for sales PDF on WhatsApp</span></label>
          </div>

          <% if (editingSale) { %>
          <div class="cust-new-grid" data-edit-sale-customer>
            <div class="pos-field">
              <label>Customer Name *</label>
              <input name="customerName" required data-uppercase data-edit-customer-name data-customer-autocomplete value="<%= editSale.customer?.name || '' %>" placeholder="Customer full name">
            </div>
            <div class="pos-field">
              <label>PAN No. (optional)</label>
              <input name="customerPan" data-edit-customer-pan maxlength="10" autocomplete="off" value="<%= editSale.customer?.panNumber || '' %>" style="text-transform:uppercase;">
            </div>
            <div class="pos-field">
              <label>Email (optional)</label>
              <input name="customerEmail" type="email" data-edit-customer-email value="<%= editSale.customer?.email || '' %>" placeholder="customer@gmail.com">
            </div>
            <div class="pos-field">
              <label>City / Address</label>
              <input name="customerAddress" data-uppercase data-edit-customer-address value="<%= editSale.customer?.address || '' %>" placeholder="City / Area">
            </div>
          </div>
          <% } else { %>
          <section class="customer-lookup" data-customer-lookup>
            <input type="hidden" name="customerId" data-customer-id>
            <div class="customer-search-control">
              <label for="billingCustomerSearch">Find existing customer</label>
              <input id="billingCustomerSearch" type="search" autocomplete="off" spellcheck="false" placeholder="Search by name or mobile" data-customer-search>
              <div class="customer-search-results" data-customer-search-results role="listbox" hidden></div>
            </div>
            <button class="button ghost small customer-new-action" type="button" data-new-customer-open>+ New customer</button>
            <div class="cust-status-badge" data-customer-status>
              Enter a customer name. Mobile number is optional.
            </div>

            <div class="cust-existing-box" data-existing-customer hidden>
              <div class="cust-existing-info">
                <strong data-existing-name></strong>
                <span data-existing-details></span>
              </div>
              <div style="display:flex; align-items:center; gap:8px;">
                <label style="margin:0; font-size:10.5px; display:inline-flex; align-items:center; gap:4px; font-weight:700; color:#2e7d32;">
                  <span>PAN (opt):</span>
                  <input name="existingCustomerPan" data-existing-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="padding:4px 7px; font-size:11.5px; width:110px; text-transform:uppercase; border:1px solid #a3d9b8; border-radius:6px;">
                </label>
                <a class="button ghost small" data-existing-ledger href="#" hidden style="background:#fff; border-color:#a3d9b8; color:#145a32; padding:3px 8px; font-size:11px;">Open Ledger →</a>
              </div>
            </div>

            <div class="cust-new-grid" data-new-customer-fields hidden>
              <div class="pos-field">
                <label>Customer Name *</label>
                <input name="customerName" disabled data-customer-name data-customer-autocomplete data-uppercase placeholder="Customer full name">
              </div>
              <div class="pos-field">
                <label>PAN No. (optional)</label>
                <input name="customerPan" disabled data-customer-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="text-transform:uppercase;">
              </div>
              <div class="pos-field">
                <label>Email (optional)</label>
                <input name="customerEmail" type="email" disabled data-customer-email placeholder="customer@gmail.com">
              </div>
              <div class="pos-field">
                <label>City / Address</label>
                <input name="customerAddress" disabled data-customer-address data-uppercase placeholder="City / Area">
              </div>
            </div>
          </section>
          <% } %>
        </div>
        <footer class="sale-line-editor-footer">
          <button class="button ghost" type="button" data-sale-customer-close>Cancel</button>
          <button class="button" type="button" data-sale-customer-done>Done</button>
        </footer>
      </section>
    </div>

    <div class="modal-overlay sale-urd-modal" id="saleUrdModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="saleUrdModalTitle" aria-hidden="true">
      <section class="modal-card sale-urd-modal-card" role="document">
        <header class="modal-header">
          <div><p class="eyebrow">Old gold exchange</p><h2 id="saleUrdModalTitle">URD buyback adjustment</h2></div>
          <button class="modal-close-btn" type="button" data-sale-urd-close aria-label="Close URD details">&times;</button>
        </header>
        <div class="modal-body sale-urd-modal-body">
          <input type="checkbox" name="includeUrdPurchase" data-urd-enabled <%= (editingSale && editSale.urd) ? 'checked' : '' %> hidden aria-hidden="true" tabindex="-1">

          <div class="urd-settlement-fields" data-urd-fields hidden>
            <div class="urd-grid">
              <div class="pos-field">
                <label>Metal</label>
                <select name="urdMetal" data-urd-metal><option value="GOLD" <%= (editingSale && editSale.urd?.metal === 'GOLD') ? 'selected' : '' %>>Gold</option><option value="SILVER" <%= (editingSale && editSale.urd?.metal === 'SILVER') ? 'selected' : '' %>>Silver</option></select>
              </div>
              <div class="pos-field">
                <label>Purity</label>
                <input name="urdPurity" data-urd-purity-manual maxlength="50" placeholder="e.g. 22K, 24K, 925, 99.9" value="<%= (editingSale && editSale.urd?.purity) ? editSale.urd.purity : '' %>">
              </div>
              <div class="pos-field">
                <label>Gross Wt. (g)</label>
                <input name="urdGrossWeight" type="number" min="0" step="0.001" value="<%= (editingSale && editSale.urd) ? editSale.urd.grossWeight : 0 %>" data-urd-gross-weight>
              </div>
              <div class="pos-field">
                <label>Net Wt. (g)</label>
                <input name="urdNetWeight" type="number" min="0" step="0.001" value="<%= (editingSale && editSale.urd) ? editSale.urd.netWeight : 0 %>" data-urd-net-weight>
              </div>
              <div class="pos-field">
                <label>Rate / g (₹)</label>
                <input name="urdRatePerGram" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.urd) ? editSale.urd.ratePerGram : 0 %>" data-urd-rate data-rate-22="<%= rateInfo.rate ? Number(rateInfo.rate.gold22k) : 0 %>" data-rate-24="<%= rateInfo.rate ? Number(rateInfo.rate.gold24k) : 0 %>" data-rate-silver="<%= rateInfo.rate ? Number(rateInfo.rate.silver) : 0 %>">
              </div>
              <div class="pos-field">
                <label>URD Total (₹)</label>
                <input name="urdTotalAmount" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.urd) ? editSale.urd.totalAmount : 0 %>" data-urd-amount>
              </div>
              <div class="pos-field" style="grid-column: span 2;">
                <label>Description</label>
                <input name="urdDescription" data-uppercase placeholder="Old melted gold chain, broken ring, etc." value="<%= (editingSale && editSale.urd?.description) || '' %>">
              </div>
            </div>
          </div>
        </div>
        <footer class="sale-line-editor-footer">
          <button class="button ghost" type="button" data-sale-urd-remove>Remove adjustment</button>
          <button class="button ghost" type="button" data-sale-urd-close>Cancel</button>
          <button class="button" type="button" data-sale-urd-done>Done</button>
        </footer>
      </section>
    </div>

    <div class="modal-overlay sale-line-editor-modal" id="saleLineEditorModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="saleLineEditorTitle" aria-hidden="true">
      <section class="modal-card sale-line-editor-modal-card" role="document">
        <header class="modal-header">
          <div><p class="eyebrow">Invoice item</p><h2 id="saleLineEditorTitle">Add barcode</h2></div>
          <button class="modal-close-btn" type="button" data-line-editor-cancel aria-label="Cancel item entry">&times;</button>
        </header>
        <div class="modal-body sale-line-editor-body" data-line-editor-host></div>
        <footer class="sale-line-editor-footer">
          <button class="button ghost" type="button" data-line-editor-cancel>Cancel</button>
          <button class="button" type="button" data-line-editor-done>Done</button>
        </footer>
      </section>
    </div>

    <div class="modal-overlay sale-review-modal" id="saleReviewModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="saleReviewTitle" aria-hidden="true">
      <section class="modal-card sale-review-modal-card" role="document">
        <header class="modal-header">
          <div><p class="eyebrow">Final check</p><h2 id="saleReviewTitle">Review invoice</h2></div>
          <button class="modal-close-btn" type="button" data-sale-review-close aria-label="Close invoice review">&times;</button>
        </header>
        <div class="modal-body sale-review-body" data-sale-review-content></div>
        <footer class="sale-line-editor-footer">
          <button class="button ghost" type="button" data-sale-review-close>Back to edit</button>
          <button class="button" type="button" data-sale-review-confirm>Confirm &amp; Generate Invoice</button>
        </footer>
      </section>
    </div>

    <div class="modal-overlay sale-split-payment-modal" id="saleSplitPaymentModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="saleSplitPaymentTitle" aria-hidden="true">
      <section class="modal-card sale-split-payment-modal-card" role="document">
        <header class="modal-header">
          <div><p class="eyebrow">Payment allocation</p><h2 id="saleSplitPaymentTitle">Split payment</h2></div>
          <button class="modal-close-btn" type="button" data-split-payment-close aria-label="Close split payment">&times;</button>
        </header>
        <div class="modal-body sale-split-payment-modal-body">
          <p class="muted">Enter the amount received through each payment method.</p>
          <div class="form-grid two compact-fields" data-split-payment-fields>
            <div class="pos-field">
              <label>Cash (₹)</label>
              <input name="cashPaid" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.initialPayment?.cashPaid !== undefined) ? editSale.initialPayment.cashPaid : '' %>" placeholder="0.00" data-cash-paid disabled>
            </div>
            <div class="pos-field">
              <label>UPI (₹)</label>
              <input name="upiPaid" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.initialPayment?.upiPaid !== undefined) ? editSale.initialPayment.upiPaid : '' %>" placeholder="0.00" data-upi-paid disabled>
            </div>
            <div class="pos-field">
              <label>Card (₹)</label>
              <input name="cardPaid" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.initialPayment?.cardPaid !== undefined) ? editSale.initialPayment.cardPaid : '' %>" placeholder="0.00" data-card-paid disabled>
            </div>
            <div class="pos-field">
              <label>Bank transfer (₹)</label>
              <input name="bankPaid" type="number" min="0" step="0.01" value="<%= (editingSale && editSale.initialPayment?.bankPaid !== undefined) ? editSale.initialPayment.bankPaid : '' %>" placeholder="0.00" data-bank-paid disabled>
            </div>
          </div>
          <div class="split-payment-modal-total">
            <span>Total allocated</span>
            <strong data-split-payment-total>₹0.00</strong>
          </div>
        </div>
        <footer class="sale-line-editor-footer">
          <button class="button" type="button" data-split-payment-close>Done</button>
        </footer>
      </section>
    </div>

  </form>
</div>

<script type="application/json" id="kusumSaleEditData"><%- editSaleJson %></script>

<!-- Customer Outstanding Balance Alert Pop-up -->
<div class="modal-overlay" id="customerBalanceAlertModal" style="display:none; z-index:9999;" aria-hidden="true">
  <div class="modal-card" style="max-width: 440px; text-align: center; padding: 24px 20px;">
    <h2 style="font-size: 18px; margin: 0 0 8px; color: #a06010;">Outstanding Balance Notice</h2>
    <p style="font-size: 13px; color: #3d352e; line-height: 1.5; margin-bottom: 12px;">
      Customer <strong id="balanceAlertCustName">Customer</strong> (<span id="balanceAlertCustPhone">9876543210</span>) has an outstanding credit balance of:
    </p>
    <div style="background: #fff8e8; border: 1.5px solid #dfa437; border-radius: 8px; padding: 10px 14px; margin-bottom: 14px;">
      <span style="font-size: 11px; font-weight: 700; color: #84530c; text-transform: uppercase; letter-spacing: 0.05em; display: block;">Credit Due on Ledger</span>
      <strong id="balanceAlertCustAmount" style="font-size: 24px; color: #b47a21; display: block; margin-top: 2px;">₹0.00</strong>
    </div>
    <p style="font-size: 11.5px; color: #776f67; margin-bottom: 18px;">
      This is an informational notice and will not interfere with your billing.
    </p>
    <div style="display: flex; gap: 10px; justify-content: center;">
      <button type="button" class="button" id="balanceAlertOkBtn" style="min-width: 130px; background:#b47a21; color:#fff; font-weight:700;">
        OK, Continue ↵
      </button>
      <a href="#" target="_blank" rel="noopener" class="button secondary" id="balanceAlertLedgerBtn">
        View Ledger →
      </a>
    </div>
  </div>
</div>
