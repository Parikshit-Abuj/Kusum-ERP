<% const urdValuation = Number(sale.urdOffset || 0); const netDifference = Number(sale.total || 0) - urdValuation; const isRefundable = netDifference < 0; const netSettlement = Math.abs(netDifference); const refundRecorded = Number(sale.urdPurchase?.paid || 0) > 0; %>
<header class="page-header no-print">
  <div>
    <p class="eyebrow">Saved invoice</p>
    <h1><%= sale.invoiceNumber %></h1>
    <p class="muted">Created <%= sale.saleDate.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></p>
  </div>
  <div class="header-actions">
    <a class="button secondary" href="/sales">All sales</a>
    <a class="button secondary" href="/sales/new">New sale</a>
    <a class="button secondary" href="/sales/<%= sale.id %>/edit">Edit bill</a>
    <% const rawPhone = (sale.customer?.phone || '').replace(/\D/g, ''); %>
    <% const waPhone = rawPhone.length === 10 ? '91' + rawPhone : rawPhone; %>
    <% const grandTotalFmt = Number(sale.total).toLocaleString('en-IN', { minimumFractionDigits: 2 }); %>
    <% const socialLines = [businessSettings?.facebookUrl ? `Facebook: ${businessSettings.facebookUrl}` : '', businessSettings?.instagramUrl ? `Instagram: ${businessSettings.instagramUrl}` : ''].filter(Boolean).join('\n'); const shopName = businessSettings?.shopName || 'Kusum ERP'; const waText = encodeURIComponent(`*${shopName} - Tax Invoice*\n\nNamaste ${sale.customer?.name || 'Customer'},\nThank you for shopping with ${shopName}!\n\n📄 *Invoice No:* ${sale.invoiceNumber}\n📅 *Date:* ${sale.saleDate.toLocaleDateString('en-IN')}\n💰 *Total Amount:* ₹${grandTotalFmt}\n\nPlease find your official Tax Invoice attached.${socialLines ? `\n\nFollow us on Facebook and Instagram:\n${socialLines}` : ''}`); %>
    <% if (waPhone && whatsappStatus?.configured && sale.customer?.whatsappOptIn) { %>
      <form method="post" action="/sales/<%= sale.id %>/whatsapp" style="display:inline"><button class="button whatsapp-btn" type="submit">Send PDF via WhatsApp</button></form>
    <% } else if (waPhone) { %>
      <a class="button whatsapp-btn" href="whatsapp://send?phone=<%= waPhone %>&text=<%= waText %>" id="waInvoiceBtn" data-pdf="/sales/<%= sale.id %>/invoice.pdf" title="Open WhatsApp Desktop app with customer">Open WhatsApp manually</a>
    <% } %>
    <% if (sale.whatsappMessage) { %>
      <span class="pill <%= ['SENT','DELIVERED','READ'].includes(sale.whatsappMessage.status) ? 'success' : (['BLOCKED_BILLING','BLOCKED_CONFIG','FAILED'].includes(sale.whatsappMessage.status) ? 'danger' : 'neutral') %>" title="<%= sale.whatsappMessage.errorMessage || '' %>">WhatsApp: <%= sale.whatsappMessage.status.replace('_', ' ').toLowerCase() %></span>
      <% if (['FAILED','BLOCKED_BILLING','BLOCKED_CONFIG'].includes(sale.whatsappMessage.status) && whatsappStatus?.configured && sale.customer?.whatsappOptIn) { %>
        <form method="post" action="/sales/<%= sale.id %>/whatsapp" style="display:inline"><input type="hidden" name="resend" value="on"><button class="button ghost small" type="submit">Retry</button></form>
      <% } %>
    <% } %>
    <a class="button" href="/sales/<%= sale.id %>/invoice.pdf" target="_blank" rel="noopener" id="pdfInvoiceLink">Print / save PDF</a>
    <form method="post" action="/sales/<%= sale.id %>/cancel" onsubmit="return confirm('Cancel this sales bill? Customer ledger, linked payments and linked URD purchase will be reversed. The sold inventory barcode will not be restored.')"><button class="button ghost" type="submit" style="color:#b53d36">Cancel bill</button></form>
  </div>
</header>

<section class="invoice panel">
  <!-- Invoice header -->
  <div class="invoice-top">
    <div class="invoice-document-title">
      <h2>TAX INVOICE</h2>
      <p>Original copy</p>
    </div>
    <div class="invoice-meta">
      <strong>TAX INVOICE</strong>
      <span><%= sale.invoiceNumber %></span>
      <span><%= sale.saleDate.toLocaleDateString('en-IN', { dateStyle: 'long' }) %></span>
    </div>
  </div>

  <!-- Bill to / Payment -->
  <div class="invoice-parties">
    <div>
      <small>BILL TO</small>
      <strong><%= sale.customer?.name || 'Walk-in customer' %></strong>
      <% if (sale.customer?.phone) { %><span><%= sale.customer.phone %></span><% } %>
      <% if (sale.customer?.address) { %><span><%= sale.customer.address %></span><% } %>
      <% if (sale.customerPan || sale.customer?.panNumber) { %><span>PAN: <strong><%= sale.customerPan || sale.customer?.panNumber %></strong></span><% } %>
    </div>
    <div>
      <small>PAYMENT DETAILS</small>
      <strong><%= isRefundable ? 'URD Refund' : sale.paymentMethod.replace('_', ' ') %></strong>
      <% if (urdValuation > 0) { %><span>URD valuation: <%- money(urdValuation) %></span><% } %>
      <% if (isRefundable) { %>
        <span style="color:#1f7651;font-weight:700;">Net refundable: <%- money(netSettlement) %></span>
        <span><%= refundRecorded ? `Refunded by ${sale.urdPurchase.paymentMethod.replace('_', ' ')}` : 'Refund pending' %></span>
      <% } else { %>
      <span>Paid: <%- money(sale.paid) %></span>
      <% if (Number(sale.balance) > 0) { %>
        <span style="color:#b47a21;font-weight:700;">Balance due: <%- money(sale.balance) %></span>
      <% } else { %>
        <span style="color:#1f7651;">Fully paid ✓</span>
      <% } %>
      <% } %>
    </div>
  </div>

  <!-- Line items table -->
  <table class="invoice-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Barcode / Item</th>
        <th>Purity</th>
        <th>Weight</th>
        <th class="right">Qty</th>
        <th class="right">Rate / g</th>
        <th class="right">Making</th>
        <th class="right">Amount (ex. GST)</th>
      </tr>
    </thead>
    <tbody>
      <% sale.items.forEach((item, index) => { %>
      <% const product = item.product || { name: item.productName, barcode: item.productBarcode, purity: item.productPurity, metal: item.productMetal, netWeight: item.weight }; %>
      <tr>
        <td><%= index + 1 %></td>
        <td>
          <strong><%= product.name || 'Jewellery item' %></strong>
          <small><%= product.barcode || 'Sold item' %><%= product.category ? ` · ${product.category}` : '' %><% if (item.hsnCode || item.huidCode) { %> · <% if (item.hsnCode) { %>HSN: <%= item.hsnCode %><% } %><% if (item.hsnCode && item.huidCode) { %> | <% } %><% if (item.huidCode) { %>HUID: <%= item.huidCode %><% } %><% } %></small>
        </td>
        <td><%= product.purity || '—' %></td>
        <td><%= grams(item.weight || product.netWeight) %></td>
        <td class="right"><%= item.quantity %></td>
        <td class="right"><%- money(item.metalRate || item.unitPrice) %></td>
        <td class="right">
          <%- money(item.makingCharge) %>
          <small><%= item.makingChargeType.replace('_', ' ') %></small>
        </td>
        <td class="right"><strong><%- money(item.taxableAmount || item.lineTotal) %></strong></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Totals + Note -->
  <div class="invoice-bottom">
    <div class="invoice-note">
      <strong>Thank you.</strong>
      <span><%= sale.notes || 'Please retain this invoice for future reference.' %></span>
      <% if (Number(sale.balance) > 0) { %>
        <div class="balance-due">⚠ Credit balance: <%- money(sale.balance) %> — pending collection</div>
      <% } %>
      <div class="invoice-sig">
        <div>Authorised Signatory</div>
      </div>
    </div>
    <div class="invoice-totals">
      <div><span>Subtotal</span><strong><%- money(sale.subtotal) %></strong></div>
      <% if (Number(sale.discount) > 0) { %>
      <div><span>Discount</span><strong>− <%- money(sale.discount) %></strong></div>
      <% } %>
      <div><span>GST (<%= sale.gstRate %>%)</span><strong><%- money(sale.gstAmount) %></strong></div>
      <div class="grand"><span>Grand total</span><strong><%- money(sale.total) %></strong></div>
      <% if (Number(sale.urdOffset) > 0) { %>
      <div><span>URD valuation</span><strong>− <%- money(sale.urdOffset) %></strong></div>
      <div style="font-size:12px;font-weight:700;"><span><%= isRefundable ? 'Net refundable' : 'Net payable' %></span><span><%- money(netSettlement) %></span></div>
      <% } %>
      <div style="margin-top:8px;font-size:11px;color:#756f69;"><span>Amount paid</span><span><%- money(sale.paid) %></span></div>
      <% if (Number(sale.balance) > 0) { %>
      <div style="font-size:12px;font-weight:700;color:#b47a21;"><span>Balance due</span><span><%- money(sale.balance) %></span></div>
      <% } %>
    </div>
  </div>
</section>

<script>
  (function() {
    // Only a successful new sale clears the recoverable Create Tax Invoice
    // draft. Viewing or reprinting an old invoice deliberately leaves it alone.
    try {
      if (new URLSearchParams(window.location.search).get('newSale') === '1') {
        sessionStorage.removeItem('kusum-erp-sale-draft-v1');
      }
    } catch (_) { /* Browser storage is optional. */ }

    const waBtn = document.getElementById('waInvoiceBtn');
    if (waBtn) {
      waBtn.addEventListener('click', function() {
        const pdfUrl = waBtn.getAttribute('data-pdf');
        if (pdfUrl) {
          setTimeout(function() {
            window.open(pdfUrl, '_blank');
          }, 350);
        }
      });
    }
  })();
</script>
