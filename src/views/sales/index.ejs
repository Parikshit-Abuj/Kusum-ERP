<header class="page-header"><div><p class="eyebrow">Billing desk</p><h1>Sales</h1></div><div class="header-actions"><button class="button ghost" type="button" data-sales-export-open>Export Excel</button><a class="button" href="/sales/new">+ Create invoice</a></div></header>
<% const f = typeof filters !== 'undefined' && filters ? filters : {}; const pager = typeof pagination !== 'undefined' && pagination ? pagination : { totalItems: sales.length }; const salesExportFrom = f.from || dateInput(); const salesExportTo = f.to || dateInput(); %>
<section class="panel register-panel"><div class="panel-heading"><div><h2>Invoices</h2></div></div>
  <!-- Search / filter bar -->
  <div class="sales-filter">
    <form method="get" action="/sales" id="salesFilterForm">
      <label>
        <span>Customer / Mobile / Invoice #</span>
        <input type="text" name="q" data-customer-autocomplete data-customer-autocomplete-mode="search" value="<%= f.q || '' %>" placeholder="e.g. Ravi, 98200... or INV-0042" autocomplete="off">
      </label>
      <label>
        <span>From date</span>
        <input type="date" name="from" value="<%= f.from || '' %>">
      </label>
      <label>
        <span>To date</span>
        <input type="date" name="to" value="<%= f.to || '' %>">
      </label>
      <div class="sales-filter-actions">
        <button type="submit" class="button small">Search</button>
        <% if (f.q || f.from || f.to) { %>
          <a class="button ghost small" href="/sales">Clear</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (f.q || f.from || f.to) { %>
    <p class="filter-result-count"><strong><%= pager.totalItems %></strong> invoice<%= pager.totalItems === 1 ? '' : 's' %> found</p>
  <% } %>

  <% if (sales.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Items</th><th>Payment</th><th class="right">Invoice total</th><th class="right">Net settlement</th><th></th></tr></thead><tbody>
      <% sales.forEach((sale) => { 
          const netDifference = Number(sale.total) - Number(sale.urdOffset);
          const isRefundable = netDifference < 0;
          const netSettlement = Math.abs(netDifference);
          const rawPhone = (sale.customer?.phone || '').replace(/\D/g, '');
          const waPhone = rawPhone.length === 10 ? '91' + rawPhone : rawPhone;
          const grandTotalFmt = Number(sale.total).toLocaleString('en-IN', { minimumFractionDigits: 2 });
          const socialLines = [businessSettings?.facebookUrl ? `Facebook: ${businessSettings.facebookUrl}` : '', businessSettings?.instagramUrl ? `Instagram: ${businessSettings.instagramUrl}` : ''].filter(Boolean).join('\n');
          const shopName = businessSettings?.shopName || 'Kusum ERP';
          const waText = encodeURIComponent(`*${shopName} - Tax Invoice*\n\nNamaste ${sale.customer?.name || 'Customer'},\nThank you for shopping with ${shopName}!\n\n📄 *Invoice No:* ${sale.invoiceNumber}\n📅 *Date:* ${sale.saleDate.toLocaleDateString('en-IN')}\n💰 *Total Amount:* ₹${grandTotalFmt}\n\nPlease find your official Tax Invoice attached.${socialLines ? `\n\nFollow us on Facebook and Instagram:\n${socialLines}` : ''}`);
      %>
        <tr>
          <td><strong><%= sale.invoiceNumber %></strong></td>
          <td>
            <strong><%= sale.customer?.name || 'Walk-in customer' %></strong>
            <% if (sale.customer?.phone) { %><small><%= sale.customer.phone %></small><% } %>
          </td>
          <td><%= formatDateDisplay(sale.saleDate) %></td>
          <td><%= sale._count.items %></td>
          <td><span class="pill neutral"><%= sale.paymentMethod.replace('_', ' ') %></span><% if (Number(sale.urdOffset) > 0) { %><small>URD valued <%= money(sale.urdOffset) %></small><% } %><% if (isRefundable && Number(sale.urdPurchase?.paid) > 0) { %><small>Refunded by <%= sale.urdPurchase.paymentMethod.replace('_', ' ') %></small><% } %><% if (Number(sale.balance) > 0) { %><small class="danger-text">Due <%= money(sale.balance) %></small><% } %></td>
          <td class="right"><strong><%= money(sale.total) %></strong></td>
          <td class="right"><strong><%= money(netSettlement) %></strong><% if (Number(sale.urdOffset) > 0) { %><small><%= isRefundable ? 'Net refundable' : 'Net payable' %></small><% } %></td>
          <td class="actions">
            <a class="button ghost small" href="/sales/<%= sale.id %>/invoice.pdf" target="_blank" rel="noopener" title="Print / save PDF">PDF</a>
            <a class="button ghost small" href="/sales/<%= sale.id %>/edit" title="Edit bill">Edit</a>
            <% if (waPhone) { %>
              <a class="icon-button whatsapp-icon" href="whatsapp://send?phone=<%= waPhone %>&text=<%= waText %>" title="Open WhatsApp Desktop chat">WA</a>
            <% } %>
            <a class="icon-button" href="/sales/<%= sale.id %>" title="Open invoice">→</a>
          </td>
        </tr>
      <% }) %>
    </tbody></table></div>
    <%- include('../_pagination', { pagination: typeof pagination !== 'undefined' ? pagination : null }) %>
  <% } else { %>
    <% if (f.q || f.from || f.to) { %>
      <div class="empty-state"><span>⌕</span><h3>No invoices match your search</h3><p>Try a different name, invoice number, or date range.</p><a class="button" href="/sales">Clear filters</a></div>
    <% } else { %>
      <div class="empty-state"><span>₹</span><h3>No invoices yet</h3><p>Start your first sale - stock will update automatically.</p><a class="button" href="/sales/new">Create invoice</a></div>
    <% } %>
  <% } %>
</section>

<div class="modal-overlay" id="salesExportModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="salesExportTitle">
  <section class="modal-card" role="document" style="max-width:440px;">
    <header class="modal-header">
      <div><p class="eyebrow">Sales register</p><h2 id="salesExportTitle">Export Excel</h2></div>
      <button class="modal-close-btn" type="button" data-sales-export-close aria-label="Close export options">×</button>
    </header>
    <form method="post" action="/data/export">
      <input type="hidden" name="resource" value="sales">
      <div class="modal-body" style="display:grid; gap:14px;">
        <div class="form-grid two">
          <label><span>From date</span><input name="from" type="date" required value="<%= salesExportFrom %>"></label>
          <label><span>To date</span><input name="to" type="date" required value="<%= salesExportTo %>"></label>
        </div>
        <p class="muted" style="margin:0; font-size:13px;">Choose the register to download.</p>
      </div>
      <footer class="modal-footer" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:8px;">
        <button class="button secondary small" type="submit" name="salesMetal" value="ALL">Export All</button>
        <button class="button secondary small" type="submit" name="salesMetal" value="GOLD">Export Gold</button>
        <button class="button secondary small" type="submit" name="salesMetal" value="SILVER">Export Silver</button>
      </footer>
    </form>
  </section>
</div>

<script>
(() => {
  const modal = document.getElementById('salesExportModal');
  const open = document.querySelector('[data-sales-export-open]');
  if (!modal || !open) return;
  let trigger = null;
  const close = () => { modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); trigger?.focus(); };
  open.addEventListener('click', () => {
    trigger = open;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
    window.setTimeout(() => modal.querySelector('input[name="from"]')?.focus(), 0);
  });
  modal.querySelectorAll('[data-sales-export-close]').forEach((button) => button.addEventListener('click', close));
  modal.addEventListener('click', (event) => { if (event.target === modal) close(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && modal.style.display !== 'none') close(); });
})();
</script>
