<header class="page-header"><div><p class="eyebrow">Made-to-order jewellery</p><h1>Customer Orders</h1></div><div class="header-actions"><a class="button" href="/customer-orders/new">+ New customer order</a></div></header>
<% const rows = Array.isArray(orders) ? orders : []; const statusLabel = { OPEN: 'Open', IN_PROGRESS: 'In progress', READY: 'Ready', DELIVERED: 'Delivered', CANCELLED: 'Cancelled' }; %>
<section class="panel register-panel">
  <form class="search-bar" method="get" action="/customer-orders"><input name="q" data-customer-autocomplete data-customer-autocomplete-mode="search" value="<%= q || '' %>" placeholder="Search order, customer, seller or item" autocomplete="off"><select name="status"><option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>Active orders</option><% ['OPEN','IN_PROGRESS','READY','DELIVERED','CANCELLED'].forEach(value => { %><option value="<%=value%>" <%= status === value ? 'selected' : '' %>><%=statusLabel[value]%></option><% }) %></select><button class="button secondary" type="submit">Search</button><% if(q){ %><a class="button ghost" href="/customer-orders">Clear</a><% } %></form>
  <% if(rows.length){ %>
  <div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Item</th><th>Seller</th><th>Due date</th><th class="right">Quote / advance</th><th>Status</th><th>Actions</th></tr></thead><tbody>
  <% rows.forEach(order => { const netAdvance = Math.max(0,Number(order.customerAdvance)-Number(order.refundedAmount)); const remaining = Math.max(0, Number(order.quotedAmount)-Number(order.customerAdvance)); const orderPhoneDigits = String(order.customer?.phone || '').replace(/\D/g, ''); const orderWaText = encodeURIComponent(`Namaste ${order.customer?.name || 'Customer'},\n\nYour jewellery order ${order.orderNumber} has been recorded. We will keep you updated on its progress.`); %>
    <tr><td><strong><%=order.orderNumber%></strong><small><%=formatDateDisplay(order.orderDate)%></small></td><td><a href="/customers/<%=order.customer.id%>"><strong><%=order.customer.name%></strong></a><small><%=order.customer.phone || ''%></small></td><td><strong><%=order.itemName%></strong><small><%=order.quantity%> piece<%=order.quantity===1?'':'s'%> · <%=order.metal%><%=order.purity ? ` · ${order.purity}` : ''%><%=Number(order.targetNetWeight)>0 ? ` · ${Number(order.targetNetWeight).toFixed(3)} g` : ''%></small></td><td><%=order.supplier ? order.supplier.name : '—'%></td><td><%=order.dueDate ? formatDateDisplay(order.dueDate) : '—'%></td><td class="right"><strong><%=money(order.quotedAmount)%></strong><small>Advance: <%=money(netAdvance)%><%=remaining > 0 ? ` · Due: ${money(remaining)}` : ''%></small></td><td><span class="pill <%=order.status==='READY'||order.status==='DELIVERED'?'success':order.status==='CANCELLED'?'danger':'warning'%>"><%=statusLabel[order.status]%></span></td><td class="actions"><a class="button ghost small" href="/customer-orders/<%=order.id%>/invoice.pdf" target="_blank" rel="noopener" title="Print or save customer order PDF">PDF</a><% if (orderPhoneDigits.length >= 10) { %><a class="icon-button whatsapp-icon" href="whatsapp://send?phone=91<%= orderPhoneDigits.slice(-10) %>&text=<%= orderWaText %>" title="Open WhatsApp Desktop chat">WA</a><% } %><% if(!['DELIVERED','CANCELLED'].includes(order.status)){ %><a class="button ghost small" href="/customer-orders/<%=order.id%>/edit">Edit</a><% if (remaining > 0) { %><details class="inline-details"><summary class="button ghost small">Advance</summary><form method="post" action="/customer-orders/<%=order.id%>/payments"><label>Amount<input name="amount" type="number" min="0.01" max="<%=remaining.toFixed(2)%>" step="0.01" required></label><label>Method<select name="paymentMethod"><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank transfer</option></select></label><label>Date<input name="paymentDate" type="date" value="<%=dateInput()%>" required></label><button class="button small" type="submit">Record</button></form></details><% } %><form method="post" action="/customer-orders/<%=order.id%>/status" class="inline-details"><select name="status"><% ['OPEN','IN_PROGRESS','READY','DELIVERED'].forEach(value=>{ %><option value="<%=value%>" <%=order.status===value?'selected':''%>><%=statusLabel[value]%></option><% }) %><button class="button ghost small" type="submit">Save</button></form><form method="post" action="/customer-orders/<%=order.id%>/cancel" onsubmit="return confirm('Cancel this order? Any recorded customer advance will be refunded and logged in Cashbook.')"><input type="hidden" name="refundPaymentMethod" value="CASH"><button class="icon-button" type="submit" title="Cancel order">✕</button></form><% } %></td></tr>
  <% }) %></tbody></table></div><%-include('../_pagination',{pagination})%>
  <% } else { %><div class="empty-state"><span>◈</span><h3>No customer orders found</h3><p>Record a made-to-order item, assign it to a seller, and track the customer advance.</p><a class="button" href="/customer-orders/new">Create first order</a></div><% } %>
</section>
