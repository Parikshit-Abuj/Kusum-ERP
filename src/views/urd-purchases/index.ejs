<header class="page-header">
  <div>
    <p class="eyebrow">Old gold / silver buying</p>
    <h1>URD Purchases</h1>
  </div>
  <div class="header-actions"><button class="button ghost" type="button" data-export-modal-open="urdExportModal">Export Excel</button><a class="button" href="/urd-purchases/new">+ New purchase</a></div>
</header>

<% const qVal = typeof q !== 'undefined' ? q : ''; const currentState = typeof state !== 'undefined' ? state : 'ACTIVE'; const purchaseList = typeof purchases !== 'undefined' && Array.isArray(purchases) ? purchases : []; %>
<section class="panel register-panel">
  <form class="search-bar" method="get" action="/urd-purchases">
    <input name="q" data-customer-autocomplete data-customer-autocomplete-mode="search" value="<%= qVal %>" placeholder="Search by customer name, mobile number or URD no." autocomplete="off">
    <select name="state"><option value="ACTIVE" <%= currentState === 'ACTIVE' ? 'selected' : '' %>>Active purchases</option><option value="CANCELLED" <%= currentState === 'CANCELLED' ? 'selected' : '' %>>Cancelled purchases</option></select>
    <button class="button secondary" type="submit">Search</button>
    <% if (qVal) { %><a class="button ghost" href="/urd-purchases">Clear</a><% } %>
  </form>

  <% if (qVal) { %>
    <p class="filter-result-count"><strong><%= pagination.totalItems %></strong> purchase<%= pagination.totalItems === 1 ? '' : 's' %> found</p>
  <% } %>

  <% if (purchaseList.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>URD No.</th>
          <th>Date</th>
          <th>Customer</th>
          <th>Metal</th>
          <th>Purity</th>
          <th class="right">Weight (g)</th>
          <th class="right">Rate / g</th>
          <th class="right">Valuation</th>
          <th class="right">Payout</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% purchaseList.forEach(p => { const urdPhoneDigits = String(p.customer?.phone || '').replace(/\D/g, ''); const itemCount = Math.max(1, Array.isArray(p.items) ? p.items.length : 0); const itemMetal = itemCount > 1 ? 'MULTIPLE' : p.metal; const itemPurity = itemCount > 1 ? '—' : (p.purity || '—'); const urdWaText = encodeURIComponent(`Namaste ${p.customer?.name || 'Customer'},\n\nYour old jewellery purchase ${p.purchaseNumber} has been recorded. Please contact us if you need the receipt.`); %>
        <tr>
          <td><strong><%= p.purchaseNumber %></strong></td>
          <td><%= formatDateDisplay(p.purchaseDate) %></td>
          <td>
            <a href="/customers/<%= p.customer.id %>"><%= p.customer.name %></a>
            <% if (p.customer.phone) { %><small><%= p.customer.phone %></small><% } %>
          </td>
          <td><%= itemMetal %><small><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></small></td>
          <td><%= itemPurity %></td>
          <td class="right"><%= Number(p.netWeight).toFixed(3) %><small>total net wt.</small></td>
          <td class="right"><%- money(p.ratePerGram) %></td>
          <td class="right"><strong><%- money(p.totalAmount) %></strong><% if (Number(p.saleOffset) > 0) { %><small>Settled: <%- money(p.saleOffset) %></small><% } %></td>
          <td class="right"><strong><%- money(p.paid) %></strong><small><%= p.paymentMethod.replace('_', ' ') %></small></td>
          <td class="actions">
            <% if (currentState === 'ACTIVE') { %><a class="button ghost small" href="/urd-purchases/<%= p.id %>/invoice.pdf" target="_blank">PDF</a><% if (urdPhoneDigits.length >= 10) { %><a class="icon-button whatsapp-icon" href="whatsapp://send?phone=91<%= urdPhoneDigits.slice(-10) %>&text=<%= urdWaText %>" title="Open WhatsApp Desktop chat">WA</a><% } %><form method="post" action="/urd-purchases/<%= p.id %>/delete" onsubmit="return confirm('Cancel this URD purchase? Its linked payout entries will be reversed.')"><button class="icon-button" type="submit" title="Cancel" style="color:#b53d36">✕</button></form><% } else { %><span class="pill danger">Cancelled</span><% } %>
          </td>
        </tr>
        <% if (p.description) { %>
        <tr class="sub-row"><td colspan="10"><small><%= p.description %></small></td></tr>
        <% } %>
        <% const urdDue = Math.max(0, Number(p.totalAmount) - Number(p.saleOffset) - Number(p.paid)); if (currentState === 'ACTIVE' && urdDue > 0) { %>
        <tr class="sub-row">
          <td colspan="10">
            <form method="post" action="/urd-purchases/<%= p.id %>/payments" class="table-settle-form">
              <div class="table-settle-due">Due: <strong><%- money(urdDue) %></strong></div>
              <label class="table-settle-field"><span>Pay now</span><input name="amount" type="number" min="0.01" max="<%= urdDue.toFixed(2) %>" step="0.01" required value="<%= urdDue.toFixed(2) %>"></label>
              <label class="table-settle-field"><span>Method</span><select name="paymentMethod" data-payment-method><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank Transfer</option></select></label>
              <input name="entryDate" type="hidden" value="<%= dateInput() %>">
              <button class="button secondary small table-settle-btn" type="submit">Record payout</button>
            </form>
          </td>
        </tr>
        <% } %>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../_pagination', { pagination }) %>
  <% } else { %>
    <% if (qVal) { %>
    <div class="empty-state compact">
      <span>⌕</span>
      <h3>No URD purchases match your search</h3>
      <p>Try a different customer name, mobile number or URD number.</p>
      <a class="button" href="/urd-purchases">Clear search</a>
    </div>
    <% } else { %>
    <div class="empty-state">
      <span>⇣</span>
      <h3>No URD purchases yet</h3>
      <p>When you buy old gold or silver from a customer, log it here and print its tax invoice when needed.</p>
      <a class="button" href="/urd-purchases/new">Record first purchase</a>
    </div>
    <% } %>
  <% } %>
</section>

<%- include('../_export_modal', { exportModalId: 'urdExportModal', exportResource: 'urd', exportTitle: 'URD Purchase', exportFrom: dateInput(), exportTo: dateInput() }) %>
