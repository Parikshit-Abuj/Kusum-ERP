<header class="page-header">
  <div><p class="eyebrow">Old gold / silver buying</p><h1>New URD purchase</h1></div>
  <a class="button ghost" href="/urd-purchases">Cancel</a>
</header>
<% if (rateInfo.rate) { %>
<div class="rate-notice"><strong>Rates in use: <%= rateInfo.sourceDate %></strong><span>22K <%- money(rateInfo.rate.gold22k) %>/g · 24K <%- money(rateInfo.rate.gold24k) %>/g · Silver <%- money(rateInfo.rate.silver) %>/g</span></div>
<% } %>
<form class="panel form-panel" method="post" action="/urd-purchases" data-urd-form>
  <section class="form-section urd-customer-section">
    <div class="urd-section-heading"><div><h2>Purchase details</h2><p>Enter the mobile number first to load an existing customer, or create a new profile.</p></div></div>
    <div class="form-grid three urd-purchase-meta">
      <label>URD No.<input name="purchaseNumber" readonly value="<%= typeof purchaseNumber !== 'undefined' ? purchaseNumber : '' %>" placeholder="Assigned when saved"></label>
      <label>Date *<input name="purchaseDate" type="date" required value="<%= dateInput() %>"></label>
      <label>Mobile number<input name="customerPhone" inputmode="numeric" autocomplete="tel" maxlength="15" placeholder="Optional mobile number" data-customer-phone autofocus></label>
    </div>
    <section class="customer-lookup" data-customer-lookup>
      <input type="hidden" name="customerId" data-customer-id>
      <div class="customer-search-control">
        <label for="urdCustomerSearch">Find existing customer</label>
        <input id="urdCustomerSearch" type="search" autocomplete="off" spellcheck="false" placeholder="Search by name or mobile" data-customer-search>
        <div class="customer-search-results" data-customer-search-results role="listbox" hidden></div>
      </div>
      <button class="button ghost small customer-new-action" type="button" data-new-customer-open>+ New customer</button>
      <div class="cust-status-badge" data-customer-status>Enter a customer name. Mobile number is optional.</div>
      <div class="cust-existing-box" data-existing-customer hidden>
        <div class="cust-existing-info"><strong data-existing-name></strong><span data-existing-details></span></div>
        <div style="display:flex; align-items:center; gap:8px;">
          <label style="margin:0; font-size:10.5px; display:inline-flex; align-items:center; gap:4px; font-weight:700; color:#2e7d32;"><span>PAN (opt):</span><input name="existingCustomerPan" data-existing-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="padding:4px 7px; font-size:11.5px; width:110px; text-transform:uppercase; border:1px solid #a3d9b8; border-radius:6px;"></label>
          <a class="button ghost small" data-existing-ledger href="#" hidden style="background:#fff; border-color:#a3d9b8; color:#145a32; padding:3px 8px; font-size:11px;">Open Ledger →</a>
        </div>
      </div>
      <div class="cust-new-grid" data-new-customer-fields hidden>
        <div class="pos-field"><label>Customer Name *</label><input name="customerName" disabled data-customer-name data-customer-autocomplete data-uppercase placeholder="Customer full name"></div>
        <div class="pos-field"><label>PAN No. (optional)</label><input name="customerPan" disabled data-customer-pan placeholder="e.g. ABCDE1234F" maxlength="10" autocomplete="off" style="text-transform:uppercase;"></div>
        <div class="pos-field"><label>Email (optional)</label><input name="customerEmail" type="email" disabled data-customer-email placeholder="customer@gmail.com"></div>
        <div class="pos-field"><label>City / Address</label><input name="customerAddress" disabled data-customer-address data-uppercase placeholder="City / Area"></div>
      </div>
    </section>
  </section>
  <section class="form-section urd-items-section" data-urd-items>
    <div class="urd-section-heading"><div><h2>Items received</h2><p>Add every old-gold or silver item under this one URD receipt. Each row is retained in the PDF.</p></div><button class="button secondary small" type="button" data-urd-add-item>+ Add item</button></div>
    <div class="urd-item-rows" data-urd-item-rows></div>
    <template data-urd-item-template>
      <div class="urd-item-row" data-urd-item-row>
        <div class="urd-item-row-head"><strong>Item <span data-urd-item-number>1</span></strong><button class="icon-button" type="button" data-urd-remove-item title="Remove item">✕</button></div>
        <div class="urd-item-grid">
          <label class="urd-item-description">Item description *<input name="urdItemDescription" required data-urd-item-description data-item-autocomplete data-uppercase placeholder="e.g. Gold chain"></label>
          <label>Metal *<select name="urdItemMetal" required data-urd-item-metal><option value="GOLD">Gold</option><option value="SILVER">Silver</option><option value="PLATINUM">Platinum</option><option value="OTHER">Other</option></select></label>
          <label>Purity<input name="urdItemPurity" data-urd-item-purity data-urd-purity-manual maxlength="50" placeholder="e.g. 22K, 925, 99.9"></label>
          <label>Gross wt. (g)<input name="urdItemGrossWeight" type="number" step="0.001" min="0" data-urd-item-gross placeholder="0.000"></label>
          <label>Net wt. (g) *<input name="urdItemNetWeight" type="number" step="0.001" min="0.001" required data-urd-item-net placeholder="0.000"></label>
          <label>Rate / gram (₹) *<input name="urdItemRatePerGram" type="number" step="0.01" min="0.01" required data-urd-item-rate data-rate-22="<%= rateInfo.rate ? Number(rateInfo.rate.gold22k) : 0 %>" data-rate-24="<%= rateInfo.rate ? Number(rateInfo.rate.gold24k) : 0 %>" data-rate-silver="<%= rateInfo.rate ? Number(rateInfo.rate.silver) : 0 %>" placeholder="0.00"></label>
          <label>Valuation (₹) *<input name="urdItemTotalAmount" type="number" step="0.01" min="0.01" required readonly data-urd-item-amount placeholder="0.00"></label>
        </div>
      </div>
    </template>
    <div class="urd-items-summary"><span>Total net weight <strong data-urd-total-weight>0.000 g</strong></span><span>Total valuation <strong data-urd-total>₹0.00</strong></span></div>
    <input name="totalAmount" type="hidden" required data-urd-total-amount value="0.00">
  </section>
  <section class="form-section"><h2>Valuation &amp; payout</h2><div class="form-grid four">
    <label>Amount paid to customer (₹) *<input name="paid" type="number" step="0.01" min="0" required placeholder="0.00" data-urd-paid></label>
    <label>Payout method<select name="paymentMethod" data-payment-method><option value="CASH">Cash</option><option value="UPI">UPI</option><option value="CARD">Card</option><option value="BANK_TRANSFER">Bank Transfer</option></select></label>
  </div></section>
  <section class="form-section"><label>Notes<textarea name="notes" rows="2" placeholder="Customer ID proof, deductions, or other notes"></textarea></label></section>
  <footer class="form-footer"><a class="button ghost" href="/urd-purchases">Cancel</a><button class="button" type="submit">Save URD purchase</button></footer>
</form>
<style>
  /* Match the Sales customer picker so URD entry has one predictable flow. */
  .urd-customer-section .customer-lookup { margin: 14px 0 0; padding: 13px 15px; }
  .urd-customer-section .customer-search-control { position: relative; display: grid; gap: 4px; margin-bottom: 8px; }
  .urd-customer-section .customer-search-control label { color: #63584c; font-size: 10.5px; font-weight: 750; letter-spacing: .03em; text-transform: uppercase; }
  .urd-customer-section .customer-search-control input { width: 100%; box-sizing: border-box; padding: 8px 11px; border: 1.5px solid #ded5c5; border-radius: 8px; background: #fff; color: #1a1612; font-size: 13px; font-weight: 550; font-family: inherit; }
  .urd-customer-section .customer-search-control input:focus { outline: none; border-color: #c9a044; box-shadow: 0 0 0 2.5px rgba(201, 160, 68, .15); }
  .urd-customer-section .customer-search-results { position: absolute; z-index: 30; top: calc(100% + 23px); left: 0; right: 0; max-height: 220px; overflow-y: auto; border: 1px solid #dfd4c3; border-radius: 9px; background: #fff; box-shadow: 0 12px 28px rgba(46, 33, 15, .16); }
  .urd-customer-section .customer-search-option { display: flex; width: 100%; flex-direction: column; align-items: flex-start; gap: 2px; padding: 9px 11px; border: 0; border-bottom: 1px solid #f0ebe4; background: #fff; color: #2b2319; cursor: pointer; text-align: left; }
  .urd-customer-section .customer-search-option:last-child { border-bottom: 0; }
  .urd-customer-section .customer-search-option:hover, .urd-customer-section .customer-search-option:focus, .urd-customer-section .customer-search-option.is-highlighted { background: #fff8eb; outline: none; }
  .urd-customer-section .customer-search-option strong { font-size: 12.5px; }
  .urd-customer-section .customer-search-option small, .urd-customer-section .customer-search-empty { color: #837665; font-size: 11.5px; }
  .urd-customer-section .customer-search-empty { padding: 11px; }
  .urd-customer-section .customer-new-action { margin: 0 0 8px; justify-self: start; }
  .urd-customer-section .cust-status-badge { padding: 8px 12px; border-radius: 8px; font-size: 11.5px; background: #fdfbf7; border: 1px dashed #ded4c1; color: #706557; margin-bottom: 8px; }
  .urd-customer-section .cust-existing-box { background: #f3faf5; border: 1.5px solid #b7e4c7; border-radius: 9px; padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
  .urd-customer-section .cust-existing-info strong { color: #145a32; font-size: 13px; display: block; }
  .urd-customer-section .cust-existing-info span { color: #2e7d32; font-size: 11.5px; }
  .urd-items-section .urd-section-heading { align-items: center; }
  .urd-item-rows { display: grid; gap: 10px; }
  .urd-item-row { border: 1px solid #e5ddcc; border-radius: 10px; padding: 12px 14px; background: #fffdf9; }
  .urd-item-row-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 9px; color: #4e3d29; font-size: 12px; }
  .urd-item-row-head .icon-button { color: #a94438; }
  .urd-item-grid { display: grid; grid-template-columns: minmax(190px, 1.8fr) repeat(3, minmax(110px, 1fr)); gap: 9px; align-items: end; }
  .urd-item-grid label { display: flex; flex-direction: column; gap: 4px; color: #63584c; font-size: 10.5px; font-weight: 750; text-transform: uppercase; letter-spacing: .02em; }
  .urd-item-grid input, .urd-item-grid select { width: 100%; box-sizing: border-box; padding: 8px 9px; border: 1.5px solid #ded5c5; border-radius: 8px; background: #fff; color: #1a1612; font-family: inherit; font-size: 12.5px; font-weight: 550; text-transform: none; }
  .urd-item-grid input:focus, .urd-item-grid select:focus { outline: none; border-color: #c9a044; box-shadow: 0 0 0 2px rgba(201,160,68,.14); }
  .urd-item-grid .urd-item-description { grid-column: span 2; }
  .urd-item-grid input[readonly] { background: #f6f1e8; color: #4e3d29; font-weight: 700; }
  .urd-items-summary { display: flex; justify-content: flex-end; gap: 24px; margin-top: 11px; padding: 10px 12px; border: 1px solid #ebd9c4; border-radius: 8px; background: #fff8eb; color: #63584c; font-size: 11.5px; }
  .urd-items-summary strong { color: #8a5a10; font-size: 13px; margin-left: 4px; }
  @media (max-width: 900px) { .urd-item-grid { grid-template-columns: repeat(2, minmax(130px, 1fr)); } .urd-item-grid .urd-item-description { grid-column: span 2; } }
  @media (max-width: 560px) { .urd-item-grid { grid-template-columns: 1fr; } .urd-item-grid .urd-item-description { grid-column: auto; } .urd-items-summary { justify-content: space-between; gap: 8px; flex-wrap: wrap; } }
</style>
<script>
(function() {
  const form = document.querySelector('[data-urd-form]'); if (!form) return;
  const rowsHost = form.querySelector('[data-urd-item-rows]');
  const template = form.querySelector('[data-urd-item-template]');
  const addButton = form.querySelector('[data-urd-add-item]');
  const totalDisplay = form.querySelector('[data-urd-total]');
  const totalWeightDisplay = form.querySelector('[data-urd-total-weight]');
  const totalInput = form.querySelector('[data-urd-total-amount]');
  const paidInput = form.querySelector('[data-urd-paid]');
  let payoutEdited = false;
  function money(value) { return '₹' + Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function number(value) { const parsed = Number(value); return Number.isFinite(parsed) ? parsed : 0; }
  function updateRowNumbers() {
    [...rowsHost.querySelectorAll('[data-urd-item-row]')].forEach((row, index) => { row.querySelector('[data-urd-item-number]').textContent = String(index + 1); row.querySelector('[data-urd-remove-item]').disabled = rowsHost.children.length === 1; });
  }
  function recalc() {
    let totalWeight = 0; let total = 0;
    rowsHost.querySelectorAll('[data-urd-item-row]').forEach((row) => {
      const net = number(row.querySelector('[data-urd-item-net]').value);
      const rate = number(row.querySelector('[data-urd-item-rate]').value);
      const lineTotal = Math.max(0, net * rate);
      row.querySelector('[data-urd-item-amount]').value = lineTotal.toFixed(2);
      totalWeight += net; total += lineTotal;
    });
    totalInput.value = total.toFixed(2);
    totalWeightDisplay.textContent = `${totalWeight.toFixed(3)} g`;
    totalDisplay.textContent = money(total);
    if (!payoutEdited) paidInput.value = total.toFixed(2);
  }
  function updateRate(row) {
    const metal = row.querySelector('[data-urd-item-metal]').value;
    const purity = String(row.querySelector('[data-urd-item-purity]').value || '').trim().toUpperCase();
    const rateInput = row.querySelector('[data-urd-item-rate]');
    const rate = metal === 'SILVER' ? number(rateInput.dataset.rateSilver)
      : metal === 'GOLD' && purity === '24K' ? number(rateInput.dataset.rate24)
        : metal === 'GOLD' ? number(rateInput.dataset.rate22) : 0;
    if (rate > 0 && (!rateInput.value || rateInput.dataset.auto === 'true')) { rateInput.value = rate.toFixed(2); rateInput.dataset.auto = 'true'; }
    recalc();
  }
  function bindRow(row) {
    const rateInput = row.querySelector('[data-urd-item-rate]');
    row.querySelector('[data-urd-item-gross]').addEventListener('input', () => {
      const netInput = row.querySelector('[data-urd-item-net]');
      if (!netInput.dataset.edited) netInput.value = row.querySelector('[data-urd-item-gross]').value;
      recalc();
    });
    row.querySelector('[data-urd-item-net]').addEventListener('input', (event) => { event.target.dataset.edited = 'true'; recalc(); });
    rateInput.addEventListener('input', (event) => { event.target.dataset.auto = 'false'; recalc(); });
    row.querySelector('[data-urd-item-metal]').addEventListener('change', () => { rateInput.dataset.auto = 'true'; updateRate(row); });
    row.querySelector('[data-urd-item-purity]').addEventListener('input', () => { if (rateInput.dataset.auto !== 'false') { rateInput.dataset.auto = 'true'; updateRate(row); } });
    row.querySelector('[data-urd-remove-item]').addEventListener('click', () => { if (rowsHost.children.length > 1) { row.remove(); updateRowNumbers(); recalc(); } });
    updateRate(row);
  }
  function addRow() { const row = template.content.firstElementChild.cloneNode(true); rowsHost.appendChild(row); bindRow(row); updateRowNumbers(); recalc(); row.querySelector('[data-urd-item-description]').focus(); }
  addButton.addEventListener('click', addRow);
  paidInput.addEventListener('input', () => { payoutEdited = true; });
  addRow();

})();
</script>
