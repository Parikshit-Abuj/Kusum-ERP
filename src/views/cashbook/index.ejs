<header class="page-header">
  <div>
    <p class="eyebrow">Daily money log</p>
    <h1>Cashbook</h1>
  </div>
  <div class="header-actions">
    <button class="button ghost" type="button" data-export-modal-open="cashbookExportModal">Export Excel</button>
    <button class="button" type="button" data-cashbook-entry-open>+ Add entry</button>
  </div>
</header>

<%
  const fDate = typeof fromDate !== 'undefined' ? fromDate : dateInput();
  const tDate = typeof toDate !== 'undefined' ? toDate : dateInput();
  const mFilter = typeof methodFilter !== 'undefined' ? methodFilter : '';
  const s = typeof summary !== 'undefined' && summary ? summary : { totalIn: 0, cashIn: 0, upiIn: 0, cardIn: 0, bankIn: 0, totalOut: 0, cashOut: 0, upiOut: 0, cardOut: 0, bankOut: 0, netBalance: 0 };
%>

<!-- Summary cards -->
<div class="cashbook-summary">
  <article class="stat-card accent-gold">
    <span class="stat-label">Total in</span>
    <strong class="stat-positive"><%- money(s.totalIn) %></strong>
    <p>Cash <%- money(s.cashIn) %> &nbsp;·&nbsp; UPI <%- money(s.upiIn) %> &nbsp;·&nbsp; Card <%- money(s.cardIn) %> &nbsp;·&nbsp; Bank <%- money(s.bankIn) %></p>
  </article>
  <article class="stat-card">
    <span class="stat-label">Total out</span>
    <strong class="stat-negative"><%- money(s.totalOut) %></strong>
    <p>Cash <%- money(s.cashOut) %> &nbsp;·&nbsp; UPI <%- money(s.upiOut) %> &nbsp;·&nbsp; Card <%- money(s.cardOut) %> &nbsp;·&nbsp; Bank <%- money(s.bankOut) %></p>
  </article>
  <article class="stat-card <%= s.netBalance >= 0 ? 'accent-gold' : '' %>">
    <span class="stat-label">Net balance</span>
    <strong class="<%= s.netBalance >= 0 ? 'stat-positive' : 'stat-negative' %>"><%- money(s.netBalance) %></strong>
    <p>Cash <%- money(s.cashNet !== undefined ? s.cashNet : (s.cashIn - s.cashOut)) %> &nbsp;·&nbsp; UPI <%- money(s.upiNet !== undefined ? s.upiNet : (s.upiIn - s.upiOut)) %> &nbsp;·&nbsp; Card <%- money(s.cardNet !== undefined ? s.cardNet : (s.cardIn - s.cardOut)) %> &nbsp;·&nbsp; Bank <%- money(s.bankNet !== undefined ? s.bankNet : (s.bankIn - s.bankOut)) %></p>
  </article>
</div>

<div class="content-grid cashbook-layout">

  <!-- Left: entries table -->
  <section class="panel register-panel">
    <!-- Date filter -->
    <form class="cashbook-filter" method="get">
      <label>From
        <input type="date" name="from" value="<%= fDate %>">
      </label>
      <label>To
        <input type="date" name="to" value="<%= tDate %>">
      </label>
      <label>Method
        <select name="method">
          <option value="">All methods</option>
          <% ['CASH','UPI','CARD','BANK_TRANSFER'].forEach(m => { %>
          <option value="<%= m %>" <%= mFilter === m ? 'selected' : '' %>><%= m.replace('_', ' ') %></option>
          <% }); %>
        </select>
      </label>
      <button class="button secondary small" type="submit">Filter</button>
      <a class="button ghost small" href="/cashbook">Reset</a>
    </form>

    <% if (entries.length) { %>
    <div class="table-wrap" style="margin-top: 0; overflow-x: auto;">
      <table style="width: 100%; min-width: 650px;">
        <thead>
          <tr>
            <th style="width: 100px; white-space: nowrap;">Date</th>
            <th>Description</th>
            <th style="width: 130px;">Customer</th>
            <th style="width: 90px;">Method</th>
            <th style="width: 70px;">Type</th>
            <th class="right" style="width: 135px; white-space: nowrap;">Amount</th>
            <th style="width: 40px;"></th>
          </tr>
        </thead>
        <tbody>
          <% entries.forEach(entry => { 
            let cleanDesc = entry.description || '';
            if (entry.reference) {
              cleanDesc = cleanDesc.replace(new RegExp(`\\s*—\\s*${entry.reference.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, '\\$&')}$`), '');
            }
          %>
          <tr>
            <td style="white-space: nowrap;"><strong><%= formatDateDisplay(entry.entryDate) %></strong></td>
            <td>
              <strong style="color: #1a1612; display: block;"><%= cleanDesc %></strong>
              <% if (entry.reference) { %><small style="color: #756f69; display: block; font-size: 11.5px; margin-top: 2px;">Ref: <%= entry.reference %></small><% } %>
              <% if (entry.notes) { %><small style="color: #857560; display: block; font-size: 11.5px;"><%= entry.notes %></small><% } %>
            </td>
            <td>
              <% if (entry.customer) { %>
              <a href="/customers/<%= entry.customer.id %>" style="font-weight: 600;"><%= entry.customer.name %></a>
              <% } else if (entry.supplierPurchase?.supplier) { %>
              <span style="font-weight:600"><%= entry.supplierPurchase.supplier.name %></span><small>Supplier</small>
              <% } else { %>
              <span class="muted">—</span>
              <% } %>
            </td>
            <td><span class="pill neutral" style="font-size: 11px; padding: 2px 7px;"><%= entry.paymentMethod.replace('_', ' ') %></span></td>
            <td><span class="pill <%= entry.type === 'IN' ? 'success' : 'danger' %>" style="font-size: 11px; padding: 2px 7px;"><%= entry.type === 'IN' ? '↑ IN' : '↓ OUT' %></span></td>
            <td class="right" style="white-space: nowrap;">
              <strong class="<%= entry.type === 'IN' ? 'paid-amount' : 'credit-amount' %>" style="font-size: 13.5px; font-weight: 750;">
                <%= entry.type === 'OUT' ? '− ' : '+ ' %><%- money(entry.amount) %>
              </strong>
            </td>
            <td class="actions" style="text-align: center;">
              <form method="post" action="/cashbook/<%= entry.id %>/delete" onsubmit="return confirm('Delete this entry?')">
                <button class="icon-button" type="submit" title="Delete entry" style="color: #b53d36; font-size: 13px;">✕</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../_pagination', { pagination }) %>
    <% } else { %>
    <div class="empty-state compact">
      <span>⊟</span>
      <h3>No entries for this period</h3>
      <p>Add the first cash-in or cash-out entry when ready.</p>
    </div>
    <% } %>
  </section>

</div>

<%- include('../_export_modal', { exportModalId: 'cashbookExportModal', exportResource: 'cashbook', exportTitle: 'Cashbook', exportFrom: fDate, exportTo: tDate }) %>

<div class="modal-overlay" id="cashbookEntryModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="cashbookEntryTitle">
  <section class="modal-card cashbook-entry-modal" role="document">
    <header class="modal-header">
      <div><p class="eyebrow">Cashbook</p><h2 id="cashbookEntryTitle">Add entry</h2></div>
      <button class="modal-close-btn" type="button" data-cashbook-entry-close aria-label="Close add entry">×</button>
    </header>
    <form method="post" action="/cashbook" data-enter-scope>
      <div class="modal-body cashbook-entry-fields">
        <div class="form-grid two compact-fields">
          <label>Date *
            <input name="entryDate" type="date" required value="<%= dateInput() %>">
          </label>
          <label>Type *
            <select name="type" id="cbType">
              <option value="IN">Money in</option>
              <option value="OUT">Money out</option>
            </select>
          </label>
          <label>Payment method *
            <select name="paymentMethod" data-payment-method>
              <option value="CASH">Cash</option>
              <option value="UPI">UPI</option>
              <option value="CARD">Card</option>
              <option value="BANK_TRANSFER">Bank Transfer</option>
            </select>
          </label>
          <label>Amount (₹) *
            <input name="amount" type="number" min="0.01" step="0.01" required placeholder="0.00">
          </label>
        </div>
        <label>Description *
          <input name="description" required placeholder="e.g. Gold sale cash payment, shop rent">
        </label>
        <label>Customer (optional)
          <input id="cbCustomerSearch" type="search" data-customer-autocomplete data-customer-autocomplete-mode="search" autocomplete="off" placeholder="Search name or mobile number…">
          <select name="customerId" id="cbCustomer" data-customer-select>
            <option value="">No customer — general entry</option>
            <% customers.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %><%= c.phone ? ` · ${c.phone}` : '' %></option>
            <% }); %>
          </select>
        </label>
        <label>Notes
          <textarea name="notes" rows="2" placeholder="Any additional details…"></textarea>
        </label>
      </div>
      <footer class="modal-footer">
        <button class="button ghost" type="button" data-cashbook-entry-close>Cancel</button>
        <button class="button" type="submit">Save entry</button>
      </footer>
    </form>
  </section>
</div>

<script>
(() => {
  const entryModal = document.getElementById('cashbookEntryModal');
  const entryOpen = document.querySelector('[data-cashbook-entry-open]');
  if (entryModal && entryOpen) {
    let entryTrigger = null;
    const closeEntryModal = () => {
      entryModal.style.display = 'none';
      entryModal.setAttribute('aria-hidden', 'true');
      entryTrigger?.focus();
    };
    const openEntryModal = (trigger = entryOpen) => {
      entryTrigger = trigger;
      entryModal.style.display = 'flex';
      entryModal.setAttribute('aria-hidden', 'false');
      setTimeout(() => entryModal.querySelector('[name="description"]')?.focus(), 0);
    };
    entryOpen.addEventListener('click', () => openEntryModal(entryOpen));
    if (new URLSearchParams(window.location.search).get('addEntry') === '1') {
      openEntryModal();
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('addEntry');
      window.history.replaceState({}, '', cleanUrl);
    }
    entryModal.querySelectorAll('[data-cashbook-entry-close]').forEach((button) => button.addEventListener('click', closeEntryModal));
    entryModal.addEventListener('click', (event) => { if (event.target === entryModal) closeEntryModal(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && entryModal.style.display === 'flex') closeEntryModal(); });
  }

})();
</script>
