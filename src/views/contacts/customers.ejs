<header class="page-header">
  <div>
    <p class="eyebrow">Contacts</p>
    <h1>Customers</h1>
  </div>
  <div class="header-actions">
    <button class="button ghost" type="button" data-export-modal-open="customersExportModal">Export Excel</button>
    <button type="button" class="button" data-customer-add-open>+ Add Customer</button>
  </div>
</header>

<%
  const qVal = typeof q !== 'undefined' ? q : '';
  const custs = typeof customers !== 'undefined' && Array.isArray(customers) ? customers : [];
  const pag = typeof pagination !== 'undefined' && pagination ? pagination : { totalItems: custs.length, page: 1, totalPages: 1 };
%>

<section class="content-grid contact-layout">
  <article class="panel register-panel">
    <div class="panel-heading">
      <div>
        <h2>Customer book</h2>
        <p><%= pag.totalItems %> customer<%= pag.totalItems === 1 ? '' : 's' %><%= qVal ? ' found' : ' saved' %></p>
      </div>
      <button type="button" class="button secondary small" data-customer-add-open>+ Add Customer</button>
    </div>

    <form class="search-bar customer-search" method="get">
      <input name="q" data-customer-autocomplete data-customer-autocomplete-mode="search" value="<%= qVal %>" placeholder="Search by name, mobile number or email" autocomplete="off" autofocus>
      <button class="button secondary" type="submit">Search</button>
      <% if (qVal) { %><a class="button ghost" href="/customers">Clear</a><% } %>
    </form>

    <% if (custs.length) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Customer mobile / ID</th>
            <th>Sales</th>
            <th class="right">Credit due</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% custs.forEach((customer) => { %>
          <tr>
            <td><strong><%= customer.name %></strong><br><small><%= customer.email || '' %></small></td>
            <td><strong><%= customer.phone || '—' %></strong></td>
            <td><span class="pill neutral"><%= customer._count?.sales || 0 %> sale<%= customer._count?.sales === 1 ? '' : 's' %></span></td>
            <td class="right"><strong class="<%= (customer.outstanding || 0) > 0 ? 'credit-amount' : '' %>"><%= money(customer.outstanding || 0) %></strong></td>
            <td><a class="button secondary small" href="/customers/<%= customer.id %>"><%= (customer.outstanding || 0) > 0 ? 'Receive payment' : 'View sheet' %></a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state compact">
      <span>◎</span>
      <h3><%= qVal ? 'No matching customer' : 'No customers saved' %></h3>
      <p><%= qVal ? 'Try a different name, mobile number or email.' : 'A customer is created automatically when a new mobile number is used in billing, or add one directly.' %></p>
      <% if (!qVal) { %>
      <button type="button" class="button" data-customer-add-open style="margin-top:12px;">+ Add Customer</button>
      <% } %>
    </div>
    <% } %>

    <%- include('../_pagination', { pagination: pag }) %>
  </article>
</section>

<!-- Add Customer Modal Popup -->
<div class="modal-overlay customer-add-modal" id="customerAddModal" style="display:none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="customerAddModalTitle">
  <div class="modal-card">
    <header class="modal-header">
      <div>
        <p class="eyebrow" style="margin:0 0 2px;">Contacts</p>
        <h2 id="customerAddModalTitle" style="margin:0;">Add Customer</h2>
      </div>
      <button class="modal-close-btn" type="button" data-customer-add-close aria-label="Close modal">✕</button>
    </header>
    <form method="post" action="/customers" id="addCustomerForm">
      <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
        <div class="pos-field">
          <label>Full name *</label>
          <input name="name" data-uppercase data-customer-autocomplete required placeholder="e.g. RAMESH SHARMA" autocomplete="off">
        </div>
        <div class="form-grid two compact-fields">
          <div class="pos-field">
            <label>Mobile number / Customer ID</label>
            <input name="phone" inputmode="numeric" maxlength="15" placeholder="Optional mobile number">
          </div>
          <div class="pos-field">
            <label>PAN (optional)</label>
            <input name="panNumber" maxlength="20" data-uppercase placeholder="e.g. ABCDE1234F">
          </div>
        </div>
        <label class="check-row"><input name="whatsappOptIn" type="checkbox"> Customer has opted in to receive sales invoice PDFs on WhatsApp</label>
        <div class="pos-field">
          <label>Email (optional)</label>
          <input name="email" type="email" placeholder="customer@example.com">
        </div>
        <div class="pos-field">
          <label>Address</label>
          <textarea name="address" data-uppercase rows="3" placeholder="City / Area / Street"></textarea>
        </div>
      </div>
      <footer class="modal-footer" style="padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button ghost" data-customer-add-close>Cancel</button>
        <button class="button" type="submit">Save Customer</button>
      </footer>
    </form>
  </div>
</div>

<%- include('../_export_modal', { exportModalId: 'customersExportModal', exportResource: 'customers', exportTitle: 'Customer directory', exportFrom: dateInput(), exportTo: dateInput() }) %>

<script>
// Add Customer modal popup
(function initCustomerAddModal() {
  const modal = document.getElementById('customerAddModal');
  if (!modal) return;

  const openButtons = document.querySelectorAll('[data-customer-add-open]');
  const closeButtons = modal.querySelectorAll('[data-customer-add-close]');
  const firstField = modal.querySelector('input[name="name"]');
  let previousFocus = null;

  function openModal() {
    previousFocus = document.activeElement;
    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
    setTimeout(() => firstField?.focus(), 60);
  }

  function closeModal() {
    modal.style.display = 'none';
    modal.setAttribute('aria-hidden', 'true');
    previousFocus?.focus();
  }

  openButtons.forEach(btn => btn.addEventListener('click', openModal));
  closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
  });
})();
</script>
