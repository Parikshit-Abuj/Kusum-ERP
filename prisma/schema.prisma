generator client {
  provider      = "prisma-client-js"
  // Keep the native engine for the build host and include the Ubuntu/Debian
  // engine used by the first Linux release target.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
  DIAMOND
  OTHER
}

enum ProductStatus {
  AVAILABLE
}

enum MovementType {
  OPENING
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
  MIXED
}

enum MakingChargeType {
  FIXED
  PER_GRAM
  PERCENTAGE
}

enum LedgerEntryType {
  SALE_CREDIT
  PAYMENT_RECEIVED
  ADJUSTMENT
}

enum CashbookType {
  IN
  OUT
}

enum CustomerOrderStatus {
  OPEN
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

// Jewellery kept by a customer as security for money lent by the shop. This
// is deliberately separate from URD: a pledge is not purchased stock and it
// must never create inventory or a sale barcode.
enum PledgeLoanStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

model Customer {
  id                Int                @id @default(autoincrement())
  name              String
  phone             String?            @unique
  whatsappOptIn     Boolean            @default(false)
  whatsappOptInAt   DateTime?
  email             String?
  address           String?            @db.Text
  panNumber         String?            @db.VarChar(20)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sales             Sale[]
  ledger            CustomerLedger[]
  urdPurchases      UrdPurchase[]
  cashbookEntries   CashbookEntry[]
  schemeEnrollments SchemeEnrollment[]
  orders            CustomerOrder[]
  pledgeLoans       PledgeLoan[]
  whatsappMessages  WhatsAppMessage[]

  @@index([createdAt])
}

model Supplier {
  id             Int                @id @default(autoincrement())
  name           String
  phone          String?            @unique
  email          String?
  address        String?            @db.Text
  gstin          String?            @db.VarChar(20)
  panNumber      String?            @db.VarChar(20)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  purchases      SupplierPurchase[]
  customerOrders CustomerOrder[]

  @@index([name])
  @@index([createdAt])
}

model Product {
  id                  Int               @id @default(autoincrement())
  barcode             String?           @unique
  sku                 String            @unique
  name                String
  category            String
  metal               MetalType         @default(GOLD)
  purity              String?
  grossWeight         Decimal           @default(0) @db.Decimal(12, 3)
  stoneWeight         Decimal           @default(0) @db.Decimal(12, 3)
  netWeight           Decimal           @default(0) @db.Decimal(12, 3)
  quantity            Int               @default(0)
  reorderLevel        Int               @default(1)
  purchasePrice       Decimal           @default(0) @db.Decimal(12, 2)
  sellingPrice        Decimal           @default(0) @db.Decimal(12, 2)
  makingChargePerGram Decimal           @default(0) @db.Decimal(12, 2)
  makingChargeType    MakingChargeType  @default(PER_GRAM)
  makingChargeValue   Decimal           @default(0) @db.Decimal(12, 2)
  location            String?
  batchDocNo          String?
  notes               String?           @db.Text
  status              ProductStatus     @default(AVAILABLE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  saleItems           SaleItem[]
  movements           StockMovement[]
  supplierPurchase    SupplierPurchase?

  @@index([batchDocNo])
  @@index([status, quantity])
  @@index([metal, status, quantity])
  @@index([createdAt])
}

model StockMovement {
  id             Int          @id @default(autoincrement())
  saleId         Int?
  productId      Int?
  productBarcode String?
  productSku     String       @default("")
  productName    String       @default("")
  productMetal   MetalType?
  productPurity  String?
  netWeight      Decimal      @default(0) @db.Decimal(12, 3)
  type           MovementType
  quantity       Int
  note           String?
  createdAt      DateTime     @default(now())
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId, createdAt])
  @@index([createdAt])
}

model Sale {
  id              Int              @id @default(autoincrement())
  invoiceNumber   String           @unique
  customerId      Int?
  customerPan     String?          @db.VarChar(20)
  saleDate        DateTime         @default(now())
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  gstRate         Decimal          @default(3) @db.Decimal(5, 2)
  gstAmount       Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  urdOffset       Decimal          @default(0) @db.Decimal(12, 2)
  paid            Decimal          @default(0) @db.Decimal(12, 2)
  cashPaid        Decimal          @default(0) @db.Decimal(12, 2)
  upiPaid         Decimal          @default(0) @db.Decimal(12, 2)
  cardPaid        Decimal          @default(0) @db.Decimal(12, 2)
  bankPaid        Decimal          @default(0) @db.Decimal(12, 2)
  balance         Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod    @default(CASH)
  notes           String?          @db.Text
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  stockMovements  StockMovement[]
  ledgerEntries   CustomerLedger[]
  urdPurchase     UrdPurchase?
  cashbookEntries CashbookEntry[]
  whatsappMessage WhatsAppMessage?

  @@index([saleDate])
  @@index([cancelledAt, saleDate])
  @@index([customerId, balance, saleDate])
}

model SaleItem {
  id                Int              @id @default(autoincrement())
  saleId            Int
  productId         Int?
  productBarcode    String?
  productSku        String           @default("")
  productName       String           @default("")
  productMetal      MetalType?
  productPurity     String?
  grossWeight       Decimal          @default(0) @db.Decimal(12, 3)
  quantity          Int
  weight            Decimal          @default(0) @db.Decimal(12, 3)
  unitPrice         Decimal          @db.Decimal(12, 2)
  metalRate         Decimal          @default(0) @db.Decimal(12, 2)
  metalAmount       Decimal          @default(0) @db.Decimal(12, 2)
  makingCharge      Decimal          @default(0) @db.Decimal(12, 2)
  makingChargeType  MakingChargeType @default(PER_GRAM)
  makingChargeValue Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal          @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal          @db.Decimal(12, 2)
  hsnCode           String?          @db.VarChar(50)
  huidCode          String?          @db.VarChar(50)
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model DailyRate {
  id        Int      @id @default(autoincrement())
  rateDate  String   @unique @db.VarChar(10)
  gold22k   Decimal  @default(0) @db.Decimal(12, 2)
  gold24k   Decimal  @default(0) @db.Decimal(12, 2)
  silver    Decimal  @default(0) @db.Decimal(12, 2)
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BarcodeSequence {
  prefix     String   @id @db.VarChar(12)
  lastNumber BigInt   @default(0) @db.UnsignedBigInt
  updatedAt  DateTime @updatedAt
}

model CustomerLedger {
  id              Int             @id @default(autoincrement())
  customerId      Int
  saleId          Int?
  cashbookEntryId Int?
  type            LedgerEntryType
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  reference       String?
  note            String?         @db.Text
  entryDate       String          @db.VarChar(10)
  createdAt       DateTime        @default(now())
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale            Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  cashbookEntry   CashbookEntry?  @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, entryDate])
  @@index([saleId])
  @@index([cashbookEntryId])
}

model CashbookEntry {
  id                       Int                       @id @default(autoincrement())
  entryDate                String                    @db.VarChar(10)
  type                     CashbookType
  paymentMethod            PaymentMethod
  description              String                    @db.VarChar(255)
  amount                   Decimal                   @db.Decimal(12, 2)
  reference                String?                   @db.VarChar(100)
  notes                    String?                   @db.Text
  customerId               Int?
  saleId                   Int?
  urdPurchaseId            Int?
  supplierPurchaseId       Int?
  customerOrderId          Int?
  pledgeLoanId             Int?
  syncLedger               Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  customer                 Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale                     Sale?                     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  urdPurchase              UrdPurchase?              @relation(fields: [urdPurchaseId], references: [id], onDelete: Cascade)
  supplierPurchase         SupplierPurchase?         @relation(fields: [supplierPurchaseId], references: [id], onDelete: Cascade)
  customerOrder            CustomerOrder?            @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  pledgeLoan               PledgeLoan?               @relation(fields: [pledgeLoanId], references: [id], onDelete: Cascade)
  ledgerEntries            CustomerLedger[]
  schemeInstallment        SchemeInstallment?
  schemeInstallmentPayment SchemeInstallmentPayment?
  pledgeLoanPayment        PledgeLoanPayment?

  @@index([entryDate])
  @@index([customerId])
  @@index([saleId])
  @@index([urdPurchaseId])
  @@index([supplierPurchaseId])
  @@index([customerOrderId])
  @@index([pledgeLoanId])
}

model CustomerOrder {
  id                   Int                 @id @default(autoincrement())
  orderNumber          String              @unique @db.VarChar(50)
  customerId           Int
  supplierId           Int?
  orderDate            DateTime            @default(now())
  dueDate              DateTime?
  itemName             String              @db.VarChar(255)
  category             String?             @db.VarChar(100)
  metal                MetalType           @default(GOLD)
  purity               String?             @db.VarChar(50)
  quantity             Int                 @default(1)
  targetGrossWeight    Decimal             @default(0) @db.Decimal(12, 3)
  targetNetWeight      Decimal             @default(0) @db.Decimal(12, 3)
  quotedAmount         Decimal             @default(0) @db.Decimal(12, 2)
  customerAdvance      Decimal             @default(0) @db.Decimal(12, 2)
  refundedAmount       Decimal             @default(0) @db.Decimal(12, 2)
  advancePaymentMethod PaymentMethod?
  status               CustomerOrderStatus @default(OPEN)
  notes                String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier             Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cashbookEntries      CashbookEntry[]

  @@index([orderDate])
  @@index([status, orderDate])
  @@index([customerId, status])
  @@index([supplierId, status])
}

// Pledge loans record customer jewellery held temporarily as collateral. They
// are financial/security records only; no Product or StockMovement relation is
// present so collateral cannot accidentally be sold as shop inventory.
model PledgeLoan {
  id                  Int                 @id @default(autoincrement())
  pledgeNumber        String              @unique @db.VarChar(50)
  customerId          Int
  pledgeDate          DateTime            @default(now())
  dueDate             DateTime?
  metal               MetalType           @default(GOLD)
  itemDescription     String              @db.VarChar(255)
  purity              String?             @db.VarChar(50)
  quantity            Int                 @default(1)
  grossWeight         Decimal             @default(0) @db.Decimal(12, 3)
  stoneWeight         Decimal             @default(0) @db.Decimal(12, 3)
  netWeight           Decimal             @default(0) @db.Decimal(12, 3)
  valuationAmount     Decimal             @default(0) @db.Decimal(12, 2)
  principalAmount     Decimal             @db.Decimal(12, 2)
  principalRepaid     Decimal             @default(0) @db.Decimal(12, 2)
  interestReceived    Decimal             @default(0) @db.Decimal(12, 2)
  monthlyInterestRate Decimal             @default(0) @db.Decimal(5, 2)
  status              PledgeLoanStatus    @default(ACTIVE)
  notes               String?             @db.Text
  releasedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashbookEntries     CashbookEntry[]
  payments            PledgeLoanPayment[]

  @@index([pledgeDate])
  @@index([status, pledgeDate])
  @@index([customerId, status])
}

model PledgeLoanPayment {
  id              Int           @id @default(autoincrement())
  pledgeLoanId    Int
  cashbookEntryId Int           @unique
  paymentDate     String        @db.VarChar(10)
  principalAmount Decimal       @default(0) @db.Decimal(12, 2)
  interestAmount  Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  pledgeLoan      PledgeLoan    @relation(fields: [pledgeLoanId], references: [id], onDelete: Cascade)
  cashbookEntry   CashbookEntry @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)

  @@index([pledgeLoanId, paymentDate])
  @@index([paymentDate])
}

model SupplierPurchase {
  id              Int             @id @default(autoincrement())
  purchaseNumber  String          @unique @db.VarChar(50)
  barcode         String?         @db.VarChar(64)
  supplierId      Int
  quantity        Int             @default(1)
  productId       Int?            @unique
  purchaseDate    DateTime        @default(now())
  metal           MetalType       @default(GOLD)
  purity          String?         @db.VarChar(50)
  itemName        String          @db.VarChar(255)
  category        String          @db.VarChar(100)
  grossWeight     Decimal         @default(0) @db.Decimal(12, 3)
  stoneWeight     Decimal         @default(0) @db.Decimal(12, 3)
  netWeight       Decimal         @default(0) @db.Decimal(12, 3)
  ratePerGram     Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  paid            Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod   @default(CASH)
  reference       String?         @db.VarChar(100)
  notes           String?         @db.Text
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  cashbookEntries CashbookEntry[]

  @@index([purchaseDate])
  @@index([cancelledAt, purchaseDate])
  @@index([supplierId, purchaseDate])
  @@index([barcode])
}

model UrdPurchase {
  id              Int               @id @default(autoincrement())
  purchaseNumber  String            @unique
  customerId      Int
  purchaseDate    DateTime          @default(now())
  metal           MetalType         @default(GOLD)
  purity          String?
  grossWeight     Decimal           @default(0) @db.Decimal(12, 3)
  netWeight       Decimal           @default(0) @db.Decimal(12, 3)
  ratePerGram     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal           @default(0) @db.Decimal(12, 2)
  saleOffset      Decimal           @default(0) @db.Decimal(12, 2)
  paid            Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod     @default(CASH)
  description     String?           @db.Text
  notes           String?           @db.Text
  saleId          Int?              @unique
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale            Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  cashbookEntries CashbookEntry[]
  items           UrdPurchaseItem[]

  @@index([purchaseDate])
  @@index([cancelledAt, purchaseDate])
  @@index([customerId])
}

// One URD purchase can contain any number of old-jewellery items. The parent
// keeps aggregate totals for accounting and legacy records; these rows retain
// each item's description, metal, purity, weight, rate, and valuation for the
// register and printed receipt.
model UrdPurchaseItem {
  id            Int         @id @default(autoincrement())
  urdPurchaseId Int
  description   String?     @db.VarChar(255)
  metal         MetalType   @default(GOLD)
  purity        String?     @db.VarChar(50)
  grossWeight   Decimal     @default(0) @db.Decimal(12, 3)
  netWeight     Decimal     @default(0) @db.Decimal(12, 3)
  ratePerGram   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  urdPurchase   UrdPurchase @relation(fields: [urdPurchaseId], references: [id], onDelete: Cascade)

  @@index([urdPurchaseId])
}

model DocumentSequence {
  key        String   @id @db.VarChar(32)
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ItemName {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  category  String   @db.VarChar(100)
  createdAt DateTime @default(now())
}

model SyncRevision {
  id        Int      @id
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model AppSession {
  id        String   @id @db.VarChar(128)
  data      String   @db.LongText
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// One shop-wide configuration record. Keeping business identity, invoice
// defaults and label geometry in MySQL means a normal full database backup
// carries these settings (including the authorised signature) to a new PC.
model BusinessSettings {
  id                       Int      @id @default(1)
  shopName                 String   @default("Kusum Jewellers") @db.VarChar(255)
  shopAddress              String?  @db.Text
  gstin                    String?  @db.VarChar(20)
  panNumber                String?  @db.VarChar(20)
  primaryPhone             String?  @db.VarChar(30)
  secondaryPhone           String?  @db.VarChar(30)
  facebookUrl              String?  @db.VarChar(1000)
  instagramUrl             String?  @db.VarChar(1000)
  invoicePrefix            String   @default("SB") @db.VarChar(12)
  financialYearStartMonth  Int      @default(4)
  defaultGstRate           Decimal  @default(3) @db.Decimal(5, 2)
  defaultHsnCode           String?  @db.VarChar(50)
  labelShopName            String   @default("KUSUM JEWELLERS") @db.VarChar(80)
  labelWidthMm             Decimal  @default(81) @db.Decimal(6, 2)
  labelHeightMm            Decimal  @default(12) @db.Decimal(6, 2)
  labelGapMm               Decimal  @default(3) @db.Decimal(6, 2)
  labelSpeed               Int      @default(2)
  labelDensity             Int      @default(10)
  signatureImage           Bytes?   @db.LongBlob
  signatureMimeType        String?  @db.VarChar(50)
  whatsappAutoSendInvoices Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

enum WhatsAppMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  BLOCKED_BILLING
  BLOCKED_CONFIG
}

model WhatsAppMessage {
  id                Int                   @id @default(autoincrement())
  saleId            Int                   @unique
  customerId        Int?
  recipientPhone    String                @db.VarChar(20)
  templateName      String                @db.VarChar(100)
  status            WhatsAppMessageStatus @default(QUEUED)
  providerMessageId String?               @db.VarChar(255)
  errorCode         String?               @db.VarChar(80)
  errorMessage      String?               @db.Text
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sale              Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@index([customerId, createdAt])
}

enum SchemeStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model SchemePlan {
  id                  Int                @id @default(autoincrement())
  name                String             @db.VarChar(255)
  durationMonths      Int
  monthlyAmount       Decimal            @db.Decimal(12, 2)
  maturityAmount      Decimal            @db.Decimal(12, 2)
  description         String?            @db.Text
  isActive            Boolean            @default(true)
  deletionRequestedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  enrollments         SchemeEnrollment[]
}

model SchemeEnrollment {
  id               Int                 @id @default(autoincrement())
  // Receipt numbers are scoped to a scheme plan. Each plan can therefore
  // start at SCH-1 while the composite key keeps every receipt unique inside
  // that plan.
  enrollmentNumber String              @db.VarChar(50)
  schemePlanId     Int
  customerId       Int
  startDate        DateTime
  endDate          DateTime
  status           SchemeStatus        @default(ACTIVE)
  totalPaid        Decimal             @default(0) @db.Decimal(12, 2)
  installmentsPaid Int                 @default(0)
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  schemePlan       SchemePlan          @relation(fields: [schemePlanId], references: [id], onDelete: Restrict)
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  installments     SchemeInstallment[]

  @@unique([schemePlanId, enrollmentNumber])
  @@index([schemePlanId])
  @@index([customerId])
  @@index([status])
}

model SchemeInstallment {
  id                Int                        @id @default(autoincrement())
  enrollmentId      Int
  installmentNumber Int
  dueDate           String                     @db.VarChar(10)
  paidAmount        Decimal                    @default(0) @db.Decimal(12, 2)
  paymentDate       String?                    @db.VarChar(10)
  paymentMethod     PaymentMethod?
  cashbookEntryId   Int?                       @unique
  status            String                     @default("PENDING") @db.VarChar(20)
  notes             String?                    @db.Text
  createdAt         DateTime                   @default(now())
  enrollment        SchemeEnrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  cashbookEntry     CashbookEntry?             @relation(fields: [cashbookEntryId], references: [id], onDelete: SetNull)
  payments          SchemeInstallmentPayment[]

  @@unique([enrollmentId, installmentNumber])
  @@index([enrollmentId])
  @@index([status])
}

model SchemeInstallmentPayment {
  id              Int               @id @default(autoincrement())
  installmentId   Int
  cashbookEntryId Int               @unique
  amount          Decimal           @db.Decimal(12, 2)
  paymentDate     String            @db.VarChar(10)
  paymentMethod   PaymentMethod
  createdAt       DateTime          @default(now())
  installment     SchemeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  cashbookEntry   CashbookEntry     @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@index([paymentDate])
}
